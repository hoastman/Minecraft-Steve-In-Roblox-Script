local UI = {persp = 0, placed = 0, broken = 0, bobT = 0, bobA = 0,
	opt = {outline = true, hc = false, cross = true, chatBg = 0.5, chatSize = 16, chatShow = true, acc = true, hideBody = false, bob = true, takeOne = true, sneakHold = true, steve = true, skin = true, layer2 = false},
	heldDir = Vector3.new(-1, 0.8, -1.25)}   -- heldDir = the angle you see the held block from (tweak it!)
function UI.look()                                  -- the way you really look (even in F5 front view)
	local cf = (UI.mirrored and UI.origCF) or Workspace.CurrentCamera.CFrame
	return cf.LookVector
end
function UI.axis()                                  -- that direction snapped to north / south / east / west
	local look = UI.look()
	if math.abs(look.X) > math.abs(look.Z) then return Vector3.new(look.X > 0 and 1 or -1, 0, 0) end
	return Vector3.new(0, 0, look.Z > 0 and 1 or -1)
end

