		local v = Workspace.CurrentCamera.ViewportSize
		sc.Scale = math.min(1, v.Y / 290, v.X / 340)
		who.Text = player.DisplayName .. " was killed"
		score.Text = 'Score: <font color="rgb(255,255,85)">' .. UI.broken .. '</font>'
		respawnBtn.Text = "Respawn"
		dead.Visible = true
		UI.sync()
	end

	function UI.hideDeath()
		if not UI.dead then return end
		UI.dead = false
		dead.Visible = false
		UI.sync()
	end

	local function watch(ch)
		local hum = ch:WaitForChild("Humanoid", 10)
		if hum then on(hum.Died, function() UI.showDeath() end) end
	end
	if player.Character then task.spawn(watch, player.Character) end
	on(player.CharacterAdded, function(ch)
		UI.hideDeath()                                -- new body = back in the game
		task.spawn(watch, ch)
	end)
end

--====================================================================
-- WATER / LAVA / FIRE: swim in water + lava (slow, jump = up), lava and fire burn you in survival
--====================================================================
do
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = {folder}
	local RANK = {Water = 1, Fire = 2, Lava = 3}
	local t, hurtT, burnT, burnUntil, flame = 0, 0, 0, 0, nil
	UI.inLiquid = nil
	on(RS.Heartbeat, function(dt)
		local root, hum = getRoot(), MV.hum
		if not root or not hum or hum.Health <= 0 then return end
		t += dt
		if t >= 0.08 then                                      -- look around you 12 times a second
			t = 0
			local found
			for _, p in ipairs(Workspace:GetPartBoundsInBox(root.CFrame, Vector3.new(1.6, 4, 1.6), params)) do
				local def = BY_NAME[p:GetAttribute("BlockType") or ""]
				if def and def.Liquid and (not found or RANK[def.Liquid] > RANK[found]) then found = def.Liquid end
			end
			UI.inLiquid = found
		end
		local liquid = UI.inLiquid
		if liquid and liquid ~= "Fire" and not UI.flying then   -- swimming: slow, sink gently, jump = swim up
			local v = root.AssemblyLinearVelocity
			local k = math.max(0, 1 - 6 * dt)
			local up = hum.Jump or UIS:IsKeyDown(Enum.KeyCode.Space)
			root.AssemblyLinearVelocity = Vector3.new(v.X * k, up and 9 or math.max(v.Y, -3), v.Z * k)
		end
		local now = os.clock()
		if liquid == "Lava" or liquid == "Fire" then
			if mode == "survival" then
				burnUntil = now + (liquid == "Lava" and 6 or 3)
				hurtT += dt
				if hurtT >= 0.55 then hurtT = 0 UI.hurt(liquid == "Lava" and 4 or 1, liquid == "Lava" and "lava" or "fire") end   -- lava = 2 hearts, fire = half a heart
			end
		end
		if liquid == "Water" then burnUntil = 0 end             -- water puts the fire out
		if now < burnUntil and mode == "survival" then
			burnT += dt
			if burnT >= 1 then burnT = 0 UI.hurt(1, "fire") end   -- burning: half a heart every second
		else
			burnT = 0
		end
		if now < burnUntil and mode == "survival" then          -- burning: flames on you for a few seconds
			if not flame or not flame.Parent then flame = new("Fire", {Size = 5, Heat = 6}, root) end
		elseif flame then
			flame:Destroy()
			flame = nil
		end
	end)
end

--====================================================================
-- FLY (creative): press jump, then press jump again within 0.5 s = fly on / off.
-- Hold jump = up, hold sneak = down. (No chat messages.)
--====================================================================
do
	local last, jumpDown = 0, false
	local flyAt, flyVF                                -- a small upward force that cancels gravity while you fly
	UI.flying = false

	-- while flying: the same walk / run animation as on the ground when you move, idle when you hover (not the falling pose)
	local flyTracks, flyCur, flyAnimator = {}, nil, nil
	local function flyId(name)                        -- R15: your custom animations.  R6: the walk / run animation R6 already has
		local hum = MV.hum
		if hum and hum.RigType == Enum.HumanoidRigType.R6 then
			local an = player.Character and player.Character:FindFirstChild("Animate")
			local f = an and an:FindFirstChild(name == "run" and "run" or "walk")
			local a = f and f:FindFirstChildOfClass("Animation")
			return a and a.AnimationId or "http://www.roblox.com/asset/?id=180426354"
		end
		return ANIMATIONS[name]
	end
	local function flyPlay(name)
		local hum = MV.hum
		if name == "idle" and hum and hum.RigType == Enum.HumanoidRigType.R6 then name = "walk" end   -- R6: hovering = the same animation as moving
		if name == flyCur then return end
		local animator = hum and hum:FindFirstChildOfClass("Animator")
		if animator ~= flyAnimator then
			for _, t in pairs(flyTracks) do pcall(function() t:Stop(0) end) end
			flyTracks, flyAnimator, flyCur = {}, animator, nil
		end
		if flyCur and flyTracks[flyCur] then flyTracks[flyCur]:Stop(0.2) end
		flyCur = name
		if not name or not animator then return end
		local tr = flyTracks[name]
		if not tr then
			local a = Instance.new("Animation")
			a.AnimationId = flyId(name)
			local ok, t = pcall(function() return animator:LoadAnimation(a) end)
			if not ok or not t then flyCur = nil return end
			t.Priority, t.Looped = Enum.AnimationPriority.Action, true
			tr = t
			flyTracks[name] = t
		end
		tr:Play(0.2)
	end

	function UI.setFly(on_)
		UI.flying = on_
		if not on_ then flyPlay(nil) end
		UI.flyT = os.clock()
		local hum, root = MV.hum, getRoot()
		if on_ and hum and root then
			hum:ChangeState(Enum.HumanoidStateType.Freefall)
			root.AssemblyLinearVelocity = Vector3.new(0, 20, 0)
		end
	end
	local function pressed()                              -- ONE finger / key press (holding does not count twice)
		if UI.onJump then UI.onJump() end                  -- (Elytra: jump in the air = glide)
		if mode ~= "creative" or panelOpen or chatOpen then return end
		local now = os.clock()
		if now - last < 0.3 then                          -- two quick presses = fly (slow jumping taps no longer start flying)
			last = 0
			UI.setFly(not UI.flying)                      -- same double press turns it on AND off
		else
			last = now
		end
	end
	function UI.jumpInput(isDown)                           -- the on-screen up arrow (phone)
		jumpDown = isDown
		if isDown then pressed() end
	end
	on(UIS.InputBegan, function(i)
		if i.KeyCode == Enum.KeyCode.Space and not UIS:GetFocusedTextBox() then jumpDown = true pressed() end
	end)
	on(UIS.InputEnded, function(i)
		if i.KeyCode == Enum.KeyCode.Space then jumpDown = false end
	end)
	-- the phone jump button: one InputBegan per tap
	task.spawn(function()
		local pg, btn, t0 = player:WaitForChild("PlayerGui"), nil, os.clock()
		repeat
			local tg = pg:FindFirstChild("TouchGui")
			local fr = tg and tg:FindFirstChild("TouchControlFrame")
			btn = fr and fr:FindFirstChild("JumpButton")
			if not btn then task.wait(0.5) end
		until btn or os.clock() - t0 > 20
		if btn then
			on(btn.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.Touch then jumpDown = true pressed() end end)
			on(btn.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.Touch then jumpDown = false end end)
		elseif UIS.TouchEnabled then                       -- no default jump button found: use the jump request (taps only)
			local lastReq = 0
			on(UIS.JumpRequest, function()
				local now = os.clock()
				if now - lastReq > 0.3 then pressed() end
				lastReq = now
			end)
		end
	end)
	on(RS.Heartbeat, function()
		if not UI.flying then
			if flyCur then flyPlay(nil) end
			if flyVF then flyVF:Destroy() flyVF = nil end
			if flyAt then flyAt:Destroy() flyAt = nil end
			return
		end
		local hum, root = MV.hum, getRoot()
		if not hum or not root or hum.Health <= 0 or mode ~= "creative" then UI.flying = false flyPlay(nil) return end
		if not flyVF or flyVF.Parent ~= root then          -- gravity is cancelled, so you HOVER where you stop (no more slow falling)
			if flyVF then flyVF:Destroy() end
			if flyAt then flyAt:Destroy() end
			flyAt = new("Attachment", {Name = "MCFlyAt"}, root)
			flyVF = new("VectorForce", {Name = "MCFlyForce", Attachment0 = flyAt, RelativeTo = Enum.ActuatorRelativeTo.World,
				ApplyAtCenterOfMass = true, Force = Vector3.zero}, root)
		end
		flyVF.Force = Vector3.new(0, root.AssemblyMass * Workspace.Gravity, 0)
		local up = jumpDown
		local down = MV.sneakHeld or MV.sneakTog
		local speed = (MV.sprintHeld or MV.sprintTog) and 44 or 24
		local md = hum.MoveDirection
		local vy = (up and 1 or 0) - (down and 1 or 0)
		root.AssemblyLinearVelocity = Vector3.new(md.X * speed, vy * speed * 0.8, md.Z * speed)
		flyPlay(Vector3.new(md.X, 0, md.Z).Magnitude > 0.1 and (speed > 30 and "run" or "walk") or "idle")
		if not up and hum.FloorMaterial ~= Enum.Material.Air and os.clock() - (UI.flyT or 0) > 0.6 then UI.setFly(false) end   -- you landed: flying stops and jumping works again
	end)
end

--====================================================================
-- Your real arm swings too (third person), and the item you hold shows in your 3D hand
--====================================================================
do
	local busy = false
	function UI.swing3D()                              -- works on R6 (Right Shoulder) and R15 (RightShoulder + RightElbow)
		if busy then return end
		if UI.poseParts and #UI.poseParts > 0 then      -- the Steve arm swings (the pose below reads UI.swingA)
			busy = true
			task.spawn(function()
				local t0 = os.clock()
				while true do
					local k = (os.clock() - t0) / 0.28
					if k >= 1 then break end
					UI.swingA = math.sin(k * math.pi) * 1.9
					RS.RenderStepped:Wait()
				end
				UI.swingA = 0
				busy = false
			end)
			return
		end
		local ch = player.Character
		if not ch then return end
		local sh = ch:FindFirstChild("RightShoulder", true) or ch:FindFirstChild("Right Shoulder", true)
		if not sh or not sh:IsA("Motor6D") then return end
		local el = ch:FindFirstChild("RightElbow", true)                 -- only R15 has an elbow
		if el and not el:IsA("Motor6D") then el = nil end
		busy = true
		task.spawn(function()
			local c0, e0 = sh.C0, el and el.C0
			local p = c0.Position
			local t0 = os.clock()
			while sh.Parent do
				local k = (os.clock() - t0) / 0.28
				if k >= 1 then break end
				local sw = math.sin(k * math.pi)
				sh.C0 = CFrame.new(p) * CFrame.Angles(sw * 1.9, 0, 0) * CFrame.new(-p) * c0       -- arm forward, around the shoulder
				if el and el.Parent then
					local ep = e0.Position
					el.C0 = CFrame.new(ep) * CFrame.Angles(sw * 0.8, 0, 0) * CFrame.new(-ep) * e0   -- R15: the forearm folds a little
				end
				RS.RenderStepped:Wait()
			end
			if sh.Parent then sh.C0 = c0 end
			if el and el.Parent then el.C0 = e0 end
			busy = false
		end)
	end

	local SIDES = {Enum.NormalId.Front, Enum.NormalId.Back}
	function UI.hold3D()
		local ch = player.Character
		local st = inv[35 + selected]
		local d = st and BY_NAME[st.name]
		local hand = ch and (ch:FindFirstChild("RightHand") or ch:FindFirstChild("Right Arm"))
		local sa = UI.steveF and UI.steveF:FindFirstChild("SteveRightArm")
		if sa then hand = sa end                                      -- the Steve arm moves when you swing / sneak
		local key = (d and d.Name or "") .. "|" .. UI.persp
		if UI.heldF and UI.heldF.Parent and UI.heldKey == key and UI.heldHand == hand then return end
		if UI.heldF then pcall(function() UI.heldF:Destroy() end) UI.heldF = nil end
		UI.heldBB = nil
		UI.heldKey, UI.heldHand = key, hand
		if UI.persp == 0 or not d or not hand then return end       -- first person has the big hand on screen instead
		local f = new("Folder", {Name = "HeldItem"}, ch)
		UI.heldF = f
		local part, off, extras
		local GAP = 0.035
		local ic = (not d.IsBlock) and iconOf(d)
		local fy = hand.Name == "RightHand" and -0.3 or (hand.Name == "SteveRightArm" and -0.75 or -0.8)
		local flags = {CanCollide = false, CanQuery = false, CanTouch = false, Massless = true, Anchored = false}
		if d.IsBlock and d.Shape then                                -- door / slab / stairs / fence / gate: the real shape
			local m = buildShape(d, d.Shape == "Door" and 1 or 1.3, hand.CFrame * CFrame.new(0, fy - (d.Shape == "Door" and 0.5 or 0), -0.9), f, false)
			for _, o in ipairs(m:IsA("BasePart") and {m} or m:GetDescendants()) do
				if o:IsA("BasePart") then
					o.Anchored, o.CanCollide, o.CanQuery, o.CanTouch, o.Massless = false, false, false, false, true
					o:SetAttribute("Held", true)
					new("WeldConstraint", {Part0 = hand, Part1 = o}, o)
				end
			end
			return
		end
		if ic then                                                   -- tools: the picture stacked in thin layers, so it has thickness (not a flat image)
			local function pic(p, shade)
				for _, face in ipairs(SIDES) do
					local sg = new("SurfaceGui", {Face = face, SizingMode = Enum.SurfaceGuiSizingMode.FixedSize, CanvasSize = Vector2.new(160, 160), LightInfluence = 0}, p)
					local back = face == Enum.NormalId.Back                 -- the BACK side is turned 270 degrees, the FRONT keeps the same (change 270 to turn it more / less)
					new("ImageLabel", {Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0), Rotation = back and 270 or 0,
						BackgroundTransparency = 1, Image = ic, ImageColor3 = Color3.new(shade, shade, shade), ResampleMode = Enum.ResamplerMode.Pixelated}, sg)
				end
			end
			part = new("Part", flags, nil)
			part.Size, part.Transparency = Vector3.new(2.0, 2.0, GAP), 1
			pic(part, 1)
			extras = {}
			for k = 1, 5 do
				local lp = new("Part", flags, nil)
				lp.Name, lp.Size, lp.Transparency = "HeldLayer", part.Size, 1
				lp:SetAttribute("Held", true)
				pic(lp, math.max(0.45, 1 - 0.11 * k))               -- the deeper layers are a little darker
				extras[#extras + 1] = {lp, k}
			end
			-- the blade points FORWARD and up (45 degrees, flat side to the outside) whatever the arm is doing: while you hold something the
			-- Steve arm is raised forward by 'hold', so the item is turned back by the same amount (before it pointed up along your chest)
			local hold = (hand.Name == "SteveRightArm") and 0.55 or 0
			local rot = CFrame.Angles(-hold, 0, 0) * CFrame.Angles(0, math.rad(-90), 0)
			off = CFrame.new(Vector3.new(0.05, fy, 0) - rot:VectorToWorldSpace(Vector3.new(0.45, -0.45, 0))) * rot   -- the handle sits in the hand
		else                                                         -- blocks: a small cube
			part = new("Part", flags, nil)
			part.Size = Vector3.one * (d.IsBlock and 1.3 or 0.8)
			part.Color, part.Material = d.Color, d.Material or Enum.Material.SmoothPlastic
			part.Transparency = d.Clear and 0.5 or d.Transparency or 0
			if d.IsBlock then
				for face, id in pairs(d.Texture or {}) do new("Decal", {Texture = id, Face = FACE[face], Color3 = d.Tint or WHITE}, part) end
			end
			off = CFrame.new(0, fy, -0.9)
		end
		part.Name = "HeldItem"
		part:SetAttribute("Held", true)
		part.CFrame = hand.CFrame * off
		part.Parent = f
		new("WeldConstraint", {Part0 = hand, Part1 = part}, part)
		for _, e in ipairs(extras or {}) do                          -- the thin layers sit one behind the other (thickness)
			e[1].CFrame = part.CFrame * CFrame.new(0, 0, GAP * e[2])
			e[1].Parent = f
			new("WeldConstraint", {Part0 = part, Part1 = e[1]}, e[1])
		end
	end
	on(player.CharacterAdded, function() task.wait(1.5) UI.heldKey = nil UI.hold3D() end)
	UI.hold3D()
end

--====================================================================
-- ELYTRA + FIREWORK ROCKET
--   Wear the Elytra in the C (chest) slot. In the air, while falling, press JUMP again = you glide: look where you want to go,
--   diving makes you faster. A Firework Rocket in your hand (use it) boosts you while you glide; on the ground it is a firework.
--====================================================================
do
	UI.gliding, UI.glideSpeed, UI.glideBoost = false, 0, 0
	local function wearing() local st = inv[6] return st ~= nil and st.name == "Elytra" end
	local glideT0 = 0

	local function stopGlide()
		if not UI.gliding then return end
		UI.gliding = false
		local hum, root = MV.hum, getRoot()
		if hum then hum.PlatformStand = false hum.AutoRotate = true end
		if root then
			local look = UI.look()
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)   -- stand up again
		end
	end

	local function startGlide()
		local hum, root = MV.hum, getRoot()
		if not hum or not root or UI.gliding or UI.flying then return end
		UI.gliding, glideT0 = true, os.clock()
		UI.glideSpeed = math.max(18, root.AssemblyLinearVelocity.Magnitude)
		hum.PlatformStand, hum.AutoRotate = true, false
	end

	UI.onJump = function()
		if panelOpen or chatOpen or UI.gliding or UI.flying or not wearing() or UI.inLiquid then return end
		local hum, root = MV.hum, getRoot()
		if hum and root and hum.FloorMaterial == Enum.Material.Air and root.AssemblyLinearVelocity.Y < -2 then startGlide() end   -- jump again while falling
	end

	on(player.CharacterAdded, function() UI.gliding, UI.glideBoost = false, 0 end)

	on(RS.Heartbeat, function(dt)
		if not UI.gliding then return end
		local hum, root = MV.hum, getRoot()
		if not hum or not root or hum.Health <= 0 or not wearing() or UI.flying or UI.inLiquid
			or (hum.FloorMaterial ~= Enum.Material.Air and os.clock() - glideT0 > 0.4) then          -- landed, died, took the Elytra off...
			stopGlide()
			return
		end
		local dir = UI.look()
		local boost = os.clock() < UI.glideBoost
		local sp = UI.glideSpeed + (-dir.Y * 28 - 4) * dt                      -- diving = faster, level or up = slowly slower
		if boost then sp = math.max(sp, 62) end
		sp = math.clamp(sp, 14, boost and 90 or 70)
		UI.glideSpeed = sp
		root.AssemblyLinearVelocity = dir * sp + Vector3.new(0, -3, 0)
		-- lie flat, head first (chest down), like Minecraft
		local z = Vector3.yAxis - dir * dir.Y
		if z.Magnitude < 0.05 then z = -root.CFrame.LookVector end
		z = z.Unit
		root.CFrame = CFrame.fromMatrix(root.Position, dir:Cross(z).Unit, dir, z)
	end)

	-- the two wings on your back (folded when you walk, open while you glide)
	local wings, spread = nil, 0
	local function killWings() if wings then pcall(function() wings.f:Destroy() end) wings = nil end end
	on(RS.RenderStepped, function(dt)
		local torso = UI.steveTorso
		if not (wearing() and torso and torso.Parent and UI.opt.steve and player.Character) then killWings() return end
		if not wings or wings.torso ~= torso or not wings.f.Parent then
			killWings()
			local f = new("Folder", {Name = "ElytraWings"}, player.Character)
			wings = {f = f, torso = torso, w = {}}
			for _, side in ipairs({-1, 1}) do
				local p = new("Part", {Size = Vector3.new(2.2, 1.4, 0.1), Color = C(110, 105, 130), Material = Enum.Material.SmoothPlastic, CanCollide = false,
					CanQuery = false, CanTouch = false, Massless = true, Anchored = false}, f)
				p:SetAttribute("Held", true)                                   -- (the skin code leaves it alone)
				wings.w[#wings.w + 1] = {side = side, weld = new("Weld", {Part0 = torso, Part1 = p}, p)}
			end
		end
		spread += ((UI.gliding and 1 or 0) - spread) * math.min(1, dt * 8)
		for _, w in ipairs(wings.w) do
			local angle = -w.side * (0.25 + 1.3 * (1 - spread))               -- folded = hanging down, open = out to the side
			w.weld.C0 = CFrame.new(w.side * 0.25, 0.5, 0.66) * CFrame.Angles(0, 0, angle) * CFrame.new(w.side * 1.1, 0, 0)
		end
	end)

	function UI.elytraCleanup()
		stopGlide()
		killWings()
	end

	-- FIREWORK ROCKET
	local COLORS = {C(255, 60, 60), C(60, 200, 255), C(255, 220, 60), C(120, 255, 120), C(220, 100, 255)}
	function UI.launchFirework(pos)
		local p = new("Part", {Size = Vector3.new(0.35, 1.2, 0.35), Color = C(220, 40, 40), Material = Enum.Material.Neon, Anchored = true, CanCollide = false,
			CanQuery = false, CanTouch = false, CFrame = CFrame.new(pos)}, dropFolder)
		local trail = new("ParticleEmitter", {Rate = 70, Lifetime = NumberRange.new(0.4, 0.8), Speed = NumberRange.new(1, 3), Size = NumberSequence.new(0.6, 0),
			Color = ColorSequence.new(C(255, 210, 80), C(255, 80, 20)), LightEmission = 1, SpreadAngle = Vector2.new(20, 20)}, p)
		TweenService:Create(p, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = pos + Vector3.new(0, 38, 0)}):Play()
		task.delay(1.2, function()
			trail.Enabled = false
			p.Transparency = 1
			local col = COLORS[math.random(1, #COLORS)]
			local burst = new("ParticleEmitter", {Rate = 0, Lifetime = NumberRange.new(1, 1.7), Speed = NumberRange.new(14, 26), SpreadAngle = Vector2.new(180, 180),
				Size = NumberSequence.new(0.8, 0), Color = ColorSequence.new(col, C(255, 255, 255)), LightEmission = 1, Drag = 2}, p)
			burst:Emit(80)
			task.delay(2.2, function() p:Destroy() end)
		end)
	end

	function UI.useFirework(idx)
		local st = inv[idx]
		if not st or st.name ~= "Firework Rocket" then return end
		swing()
		if mode == "survival" then
			st.count -= 1
			if st.count <= 0 then inv[idx] = nil end
			render(idx)
		end
		local root = getRoot()
		if UI.gliding then                                          -- boost!
			UI.glideBoost = os.clock() + 1.4
			if root then
				local fx = new("ParticleEmitter", {Rate = 80, Lifetime = NumberRange.new(0.3, 0.6), Speed = NumberRange.new(2, 5), Size = NumberSequence.new(0.7, 0),
					Color = ColorSequence.new(C(255, 220, 90), C(255, 90, 20)), LightEmission = 1, SpreadAngle = Vector2.new(25, 25)}, root)
				task.delay(1.4, function() fx.Enabled = false task.delay(1, function() fx:Destroy() end) end)
			end
		elseif root then                                            -- a firework in the sky
			local look = UI.look()
			local flat = Vector3.new(look.X, 0, look.Z)
			flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.zero
			UI.launchFirework(root.Position + Vector3.new(0, 3, 0) + flat * 3)
		end
	end

	-- XP: only ores (Minecraft numbers; an ore that is not in the list gives 1 to 3)
	UI.ORE_XP = {["Coal Ore"] = {0, 2}, ["Diamond Ore"] = {3, 7}, ["Emerald Ore"] = {3, 7}, ["Lapis Ore"] = {2, 5}, ["Redstone Ore"] = {1, 5},
		["Nether Quartz Ore"] = {2, 5}, ["Nether Gold Ore"] = {0, 1}}
	function UI.oreXP(kind)
		if not kind or not tostring(kind):find("Ore$") then return 0 end           -- anything that is not an ore gives nothing
		local r = UI.ORE_XP[kind]
		if r then return math.random(r[1], r[2]) end
		return math.random(1, 3)
	end
end

--====================================================================
-- PC input
--====================================================================
local NUM = {[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6, [Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8, [Enum.KeyCode.Nine] = 9}

on(UIS.InputBegan, function(input, processed)
	if UIS:GetFocusedTextBox() then return end
	if input.KeyCode == Enum.KeyCode.E then UI.toggle() return end
	if input.KeyCode == Enum.KeyCode.M then UI.setMenu() return end
	if input.KeyCode == Enum.KeyCode.F5 then if not chatOpen and not panelOpen then UI.cyclePersp() end return end
	if input.KeyCode == Enum.KeyCode.T then stopBreak() openChat() return end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then MV.sprintHeld = true end
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then MV.sneakHeld = true end
	if processed or panelOpen then return end
	if NUM[input.KeyCode] then selected = NUM[input.KeyCode] moveSelector() return end
	if input.KeyCode == Enum.KeyCode.Q then UI.dropSelected(UIS:IsKeyDown(Enum.KeyCode.LeftControl)) return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		startBreak(function() return UIS:GetMouseLocation() end, input)
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		doAction("Place", UIS:GetMouseLocation())
	end
end)

on(UIS.InputChanged, function(input, processed)
	if processed or panelOpen then return end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		selected = ((selected - 1 - input.Position.Z) % 9) + 1
		moveSelector()
	end
end)

local function track(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.Touch then
		usingTouch = true
		pointer = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
	elseif t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.MouseButton1 then
		usingTouch = false
		pointer = UIS:GetMouseLocation()
	end
end
on(UIS.InputBegan, track)
on(UIS.InputChanged, track)

-- letting go of the mouse / finger that started the break stops it
on(UIS.InputEnded, function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then MV.sprintHeld = false end
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.C then MV.sneakHeld = false end
	if hold.input and input == hold.input then stopBreak() end
end)

on(RS.RenderStepped, function()
	if UI.f5 then UI.f5.Visible = not chatOpen and not panelOpen end
	if UI.dropBtn then UI.dropBtn.Visible = not chatOpen and not panelOpen end
	if not usingTouch then pointer = UIS:GetMouseLocation() end
	if cursor then cur.Position = UDim2.fromOffset(pointer.X, pointer.Y) end
end)

