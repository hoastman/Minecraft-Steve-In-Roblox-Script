end

local function doAction(action, pt)   -- right click / PLACE
	if action ~= "Place" or panelOpen or chatOpen then return end
	local hit = getTarget(pt)
	if not hit then return end
	local r = getRoot()
	if not r or (r.Position - hit.Position).Magnitude > REACH then return end
	local model = hit.Instance:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then return end

	local clicked = blockRoot(hit.Instance)
	if clicked and clicked:GetAttribute("BlockType") == "Crafting Table" and not (MV.sneakHeld or MV.sneakTog) then
		swing()
		UI.setCraft(true)                            -- right-click a Crafting Table = open the 3x3 crafting screen
		return
	end

	local cdef = clicked and BY_NAME[clicked:GetAttribute("BlockType") or ""]
	if cdef and (cdef.Shape == "Door" or cdef.Shape == "FenceGate") and not (MV.sneakHeld or MV.sneakTog) then
		swing()
		if cdef.Shape == "Door" then UI.toggleDoor(clicked) else UI.toggleGate(clicked) end   -- right-click = open / close (instant)
		return
	end
	if clicked and not (MV.sneakHeld or MV.sneakTog) then
		local bt = clicked:GetAttribute("BlockType")
		if bt == "Chest" or bt == "Furnace" then
			swing()
			UI.openContainer(clicked, bt)                -- right-click a Chest / Furnace = open it
			return
		end
	end

	local idx = 35 + selected
	local s = inv[idx]
	if not s then return end
	local d = BY_NAME[s.name]
	if d.IsBlock then
		local pos, n = placePos(hit)
		local flip, face, boxCF, boxSize = false, nil, CFrame.new(pos), Vector3.one * (BLOCK - 0.2)
		if d.Shape then
			-- top half when you click an underside or the upper half of a side
			flip = n.Y < -0.5 or (math.abs(n.Y) < 0.5 and hit.Position.Y > pos.Y)
			if d.Shape == "Slab" then
				-- slab on the flat side of a slab = the other half of the same cell (double slab)
				local root = blockRoot(hit.Instance)
				if root and root.Name == "Slab" and root:GetAttribute("Cell") then
					local topSlab = root:GetAttribute("Flip")
					if (n.Y > 0.5 and not topSlab) or (n.Y < -0.5 and topSlab) then
						pos, flip = root:GetAttribute("Cell"), not topSlab
					end
				end
				boxCF = CFrame.new(pos + Vector3.new(0, flip and BLOCK / 4 or -BLOCK / 4, 0))
				boxSize = Vector3.new(BLOCK - 0.2, BLOCK / 2 - 0.2, BLOCK - 0.2)
			else
				-- stairs rise away from you (the high side is the way you are looking); a door faces you too
				face = UI.axis()
				if d.Shape == "Door" then                -- a door fills 2 blocks, so check both cells
					boxCF, boxSize = CFrame.new(pos + Vector3.new(0, BLOCK / 2, 0)), Vector3.new(BLOCK - 0.2, BLOCK * 2 - 0.2, BLOCK - 0.2)
				end
			end
		end
		for _, part in ipairs(Workspace:GetPartBoundsInBox(boxCF, boxSize)) do
			if blockRoot(part) then return end
			local m = part:FindFirstAncestorOfClass("Model")
			if m and m:FindFirstChildOfClass("Humanoid") then return end
		end
		makeBlock(pos, d, n, r, flip, face)
		UI.placed += 1
		swing()
		if mode == "survival" then useItem(idx) end
	elseif d.Food then
		swing()
		if mode == "survival" then useItem(idx) end
		sys("Ate " .. d.Name .. " (+" .. d.Food .. ")")
	elseif d.Drink then
		sys("Drank " .. d.Name)
	end
end

-- HOLD to break:  survival = about 1 second on the same block (any longer hold keeps breaking the next ones),
--                 creative = instant, keeps breaking while held
local BREAK_TIME = 1          -- seconds; a block can override it with BreakTime = n
local hold = {active = false, prog = 0, lastSwing = 0, lastBreak = 0}
local bbar = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 32), Size = UDim2.fromOffset(64, 8),
	BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3, BorderSizePixel = 0, Visible = false, ZIndex = 15}, gui)
local bfill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = C(120, 230, 90), BorderSizePixel = 0, ZIndex = 16}, bbar)

function UI.spill(part, bpos)                          -- items inside a broken chest / furnace come back to you
	local st = UI.CT[part]
	if not st then return end
	if UI.xst == st then UI.closeContainer() end
	for _, s in pairs(st.s) do
		if s and BY_NAME[s.name] then
			local left = give(s.name, s.count)
			for _ = 1, math.min(left, 30) do spawnDrop(bpos, BY_NAME[s.name]) end
		end
	end
	st.s = {}
	UI.CT[part] = nil
end

-- BREAK PARTICLES: little cubes of the block burst out when you break it, fall and fade
do
	local parts = {}
	local FACES = {Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Top, Enum.NormalId.Bottom}
	function UI.breakFX(pos, def, color)
		local tex = def and def.Texture and (def.Texture.All or def.Texture.Side or def.Texture.Front or def.Texture.Top or select(2, next(def.Texture)))
		for _ = 1, 14 do
			local size = 0.45 + math.random() * 0.3
			local p = new("Part", {Size = Vector3.one * size, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
				Color = def and def.Color or color or C(150, 150, 150), Material = def and def.Material or Enum.Material.SmoothPlastic,
				TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, dropFolder)
			if tex then
				for _, f in ipairs(FACES) do new("Decal", {Texture = tex, Face = f, Color3 = def.Tint or WHITE}, p) end
			end
			local off = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (BLOCK * 0.8)
			parts[#parts + 1] = {part = p, pos = pos + off, vel = off.Unit * (6 + math.random() * 8) + Vector3.new(0, 7 + math.random() * 5, 0),
				life = 0.55 + math.random() * 0.4, age = 0, size = size, rot = Vector3.new(math.random() * 6, math.random() * 6, math.random() * 6)}
		end
	end
	on(RS.Heartbeat, function(dt)
		for i = #parts, 1, -1 do
			local q = parts[i]
			q.age += dt
			if q.age >= q.life or not q.part.Parent then
				pcall(function() q.part:Destroy() end)
				table.remove(parts, i)
			else
				q.vel += Vector3.new(0, -60 * dt, 0)
				q.pos += q.vel * dt
				local k = q.age / q.life
				q.part.Size = Vector3.one * (q.size * (1 - k * 0.6))
				q.part.Transparency = math.max(0, (k - 0.6) / 0.4)
				q.part.CFrame = CFrame.new(q.pos) * CFrame.Angles(q.rot.X * q.age * 3, q.rot.Y * q.age * 3, q.rot.Z * q.age * 3)
			end
		end
	end)
end

local function breakPart(part)
	local kind, bpos = part:GetAttribute("BlockType"), part:GetAttribute("Cell") or part:GetPivot().Position
	UI.spill(part, bpos)
	UI.breakFX(bpos, kind and BY_NAME[kind], part:IsA("BasePart") and part.Color or nil)   -- particles
	part:Destroy()
	UI.broken += 1
	if mode == "survival" and kind and BY_NAME[kind] then spawnDrop(bpos, BY_NAME[kind]) end   -- drops an item
end

local function startBreak(getPt, input)
	if panelOpen or chatOpen then return end
	hold.active, hold.getPt, hold.input = true, getPt, input
	hold.part, hold.prog, hold.lastSwing, hold.lastBreak = nil, 0, os.clock(), 0
	swing()                                            -- the arm swings the moment you press BREAK (even on air)
end

function stopBreak()
	hold.active, hold.input, hold.part, hold.prog = false, nil, nil, 0
	bbar.Visible = false
end

on(RS.Heartbeat, function(dt)
	if not hold.active then return end
	if panelOpen or chatOpen then stopBreak() return end
	local now = os.clock()
	if now - hold.lastSwing > 0.35 then hold.lastSwing = now swing() end
	local hit = getTarget(hold.getPt())
	local r = getRoot()
	local part = hit and r and (r.Position - hit.Position).Magnitude <= REACH and blockRoot(hit.Instance) or nil
	if part ~= hold.part then hold.part, hold.prog = part, 0 end
	if not part then bbar.Visible = false return end
	if mode == "creative" then
		bbar.Visible = false
		if now - hold.lastBreak > 0.25 then
			hold.lastBreak = now
			hold.part = nil
			breakPart(part)
		end
		return
	end
	local def = BY_NAME[part:GetAttribute("BlockType") or ""]
	local need = (def and def.BreakTime) or BREAK_TIME
	hold.prog += dt
	bbar.Visible = true
	bfill.Size = UDim2.fromScale(math.min(hold.prog / need, 1), 1)
	if hold.prog >= need then
		hold.part, hold.prog = nil, 0
		bbar.Visible = false
		breakPart(part)
	end
end)

-- SNEAK EDGE GUARD: while sneaking on the ground you stop at the edge of a block instead of falling off (like Minecraft)
local edgeParams = RaycastParams.new()
edgeParams.FilterType = Enum.RaycastFilterType.Exclude
edgeParams.IgnoreWater = true
pcall(function() edgeParams.RespectCanCollide = true end)
function UI.edgeGuard(hum)
	local root = getRoot()
	if not root then return end
	if hum.FloorMaterial == Enum.Material.Air then return end
	edgeParams.FilterDescendantsInstances = {player.Character, dropFolder, UI.ghost}
	local pos = root.Position
	local drop = root.Size.Y / 2 + hum.HipHeight + 2.4          -- how far down we look for ground (a small step is fine, a block-high drop is not)
	local function solid(dir, d)
		return Workspace:Raycast(pos + dir * d, Vector3.new(0, -drop, 0), edgeParams) ~= nil
	end
	-- remember the last spot that is safely inside a block (ground on all 4 sides)
	if solid(Vector3.xAxis, 0.9) and solid(-Vector3.xAxis, 0.9) and solid(Vector3.zAxis, 0.9) and solid(-Vector3.zAxis, 0.9) then
		MV.safe = pos
	end
	local md = hum.MoveDirection
	local flat = Vector3.new(md.X, 0, md.Z)
	if flat.Magnitude < 0.1 then return end
	local dir = flat.Unit
	if solid(dir, 1.6) then return end                           -- ground ahead: walk normally
	local slide                                                  -- no ground ahead: slide along the edge if one axis is still safe
	local ax, az = Vector3.new(dir.X, 0, 0), Vector3.new(0, 0, dir.Z)
	if math.abs(ax.X) > 0.2 and solid(ax.Unit, 1.6) then slide = ax
	elseif math.abs(az.Z) > 0.2 and solid(az.Unit, 1.6) then slide = az end
	local v, sp = root.AssemblyLinearVelocity, hum.WalkSpeed
	root.AssemblyLinearVelocity = Vector3.new(slide and slide.X * sp or 0, v.Y, slide and slide.Z * sp or 0)
	-- hard stop: if we crept too close to the edge anyway, put us back on the last safe spot
	if MV.safe and not solid(dir, 0.9) then
		root.CFrame = root.CFrame + Vector3.new(MV.safe.X - pos.X, 0, MV.safe.Z - pos.Z)
	end
end

-- SPRINT: hold Shift (phone: SPRINT button).   SNEAK: hold Ctrl or C (phone: SNEAK button) = slow + lower camera.
on(RS.Heartbeat, function(dt)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if hum ~= MV.hum then MV.hum, MV.base, MV.camY = hum, nil, 0 end
	local sneak = MV.sneakHeld or MV.sneakTog
	local sprint = (MV.sprintHeld or MV.sprintTog) and not sneak
	if MV.sprintTog and hum.MoveDirection.Magnitude < 0.1 then      -- the SPRINT button switches off when you stop
		MV.idle += dt
		if MV.idle > 0.3 then MV.sprintTog = false if MV.refresh then MV.refresh() end end
	else
		MV.idle = 0
	end
	if sneak or sprint then
		if not MV.base then MV.base = hum.WalkSpeed end
		hum.WalkSpeed = sneak and 6 or MV.base * 1.6
	elseif MV.base then
		hum.WalkSpeed, MV.base = MV.base, nil
	end
	if sneak then UI.edgeGuard(hum) end
	local k = math.min(1, dt * 12)
	if sneak or math.abs(MV.camY) > 0.01 then
		local nxt = MV.camY + ((sneak and -1 or 0) - MV.camY) * k
		hum.CameraOffset += Vector3.new(0, nxt - MV.camY, 0)
		MV.camY = nxt
	end
	if sprint or math.abs(MV.fov) > 0.05 then
		local nxt = MV.fov + ((sprint and 8 or 0) - MV.fov) * k
		Workspace.CurrentCamera.FieldOfView += nxt - MV.fov
		MV.fov = nxt
	end
end)

-- the arm bobs while you walk (faster when sprinting, slower when sneaking) and breathes when you stand still
on(RS.RenderStepped, function(dt)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local moving = hum and hum.MoveDirection.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air
	local sneak = MV.sneakHeld or MV.sneakTog
	local sprint = (MV.sprintHeld or MV.sprintTog) and not sneak
	UI.bobA += ((moving and 1 or 0) - UI.bobA) * math.min(1, dt * 8)
	UI.bobT += dt * (moving and (sprint and 13 or (sneak and 6 or 9)) or 0)
	local idle = math.sin(os.clock() * 1.5) * 2.5 * (1 - UI.bobA)
	handBob.Position = UI.opt.bob and UDim2.fromOffset(math.cos(UI.bobT) * 8 * UI.bobA, math.abs(math.sin(UI.bobT)) * 10 * UI.bobA + idle) or UDim2.fromOffset(0, 0)
	if UI.armModel and handRoot.Visible then            -- swing the 3D arm forward around the shoulder, then back
		local k = UI.swingAt and math.clamp((os.clock() - UI.swingAt) / 0.3, 0, 1) or 1
		local sw = math.sin(k * math.pi)
		local p = UI.armShoulder
		UI.armModel:PivotTo(CFrame.new(p) * CFrame.Angles(-0.9 * sw, 0.35 * sw, 0.25 * sw) * CFrame.new(-p) * UI.armBase)
	end
end)

local function center() return Workspace.CurrentCamera.ViewportSize / 2 end

if UIS.TouchEnabled then
	local brkBtn = roundButton("BREAK", 50, C(200, 60, 60))
	on(brkBtn.InputBegan, function(input) if isPress(input) then startBreak(center, input) end end)   -- hold it
	on(roundButton("PLACE", -50, C(60, 160, 80)).Activated, function() doAction("Place", center()) end)

	local sprintBtn = roundButton("SPRINT", -50, C(70, 110, 200), -116, 64)
	local sneakBtn = roundButton("SNEAK", 50, C(110, 110, 120), -116, 64)
	local function refreshBtns()
		sprintBtn.BackgroundColor3 = MV.sprintTog and C(240, 170, 40) or C(70, 110, 200)
		sneakBtn.BackgroundColor3 = MV.sneakTog and C(240, 170, 40) or C(110, 110, 120)
	end
	MV.refresh = refreshBtns
	on(sprintBtn.Activated, function() MV.sprintTog = not MV.sprintTog MV.sneakTog = false refreshBtns() end)
	on(sneakBtn.Activated, function()
		if UI.opt.sneakHold then return end                                   -- hold mode: handled below
		MV.sneakTog = not MV.sneakTog MV.sprintTog = false refreshBtns()
	end)
	local function tapType(i) return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 end
	on(sneakBtn.InputBegan, function(i)
		if UI.opt.sneakHold and tapType(i) then MV.sneakTog, MV.sprintTog = true, false refreshBtns() end   -- sneak while you hold it
	end)
	on(sneakBtn.InputEnded, function(i)
		if UI.opt.sneakHold and tapType(i) then MV.sneakTog = false refreshBtns() end
	end)
end

--====================================================================
-- STEVE: your character looks like Steve (only on your screen).
-- The body = the Steve MeshParts (base layer + second layer = jacket / sleeves / hat) painted with the skin image.
-- If the meshes can't load, it falls back to simple colored boxes.
--====================================================================
do
	local AssetService = game:GetService("AssetService")
	UI.skinDefault = "rbxassetid://8028692999"       -- the Steve skin image (Options > Skin Customization > Custom Skin Texture changes it)
	UI.skinId = UI.skinDefault
	local SKIN, SHIRT, PANTS = C(198, 140, 100), C(0, 170, 170), C(60, 60, 150)   -- colors for the box fallback
	local MESH = {   -- key = {mesh id, size, fallback color, R6 part, R15 part, 2nd-layer mesh id, 2nd-layer size}
		Head     = {6814397315, Vector3.new(1.371, 1.371, 1.371), SKIN,  "Head", "Head", 6814398336, Vector3.new(1.509, 1.509, 1.509)},
		Torso    = {6814398087, Vector3.new(1.371, 2.057, 0.686), SHIRT, "Torso", "UpperTorso", 6814398865, Vector3.new(1.439, 2.125, 0.753)},
		RightArm = {6814397494, Vector3.new(0.686, 2.057, 0.686), SKIN,  "Right Arm", "RightUpperArm", 6814398479, Vector3.new(0.753, 2.125, 0.753)},
		LeftArm  = {6814397786, Vector3.new(0.686, 2.057, 0.686), SKIN,  "Left Arm", "LeftUpperArm", 6814398213, Vector3.new(0.753, 2.125, 0.753)},
		RightLeg = {6814397649, Vector3.new(0.686, 2.1, 0.686),   PANTS, "Right Leg", "RightUpperLeg", 6814398610, Vector3.new(0.753, 2.125, 0.753)},
		LeftLeg  = {6814397937, Vector3.new(0.686, 2.1, 0.686),   PANTS, "Left Leg", "LeftUpperLeg", 6814398746, Vector3.new(0.753, 2.125, 0.753)},
	}
	local ORDER = {"Torso", "Head", "RightArm", "LeftArm", "RightLeg", "LeftLeg"}

	function UI.unsteve()
		if UI.steveF then pcall(function() UI.steveF:Destroy() end) UI.steveF = nil end
	end

	-- a Steve MeshPart painted with the skin (nil if the mesh can't be loaded)
	local function newMesh(id, size)
		local ok, mp = pcall(function() return AssetService:CreateMeshPartAsync("rbxassetid://" .. id) end)
		if not ok or not mp then return nil end
		mp.Size = size
		mp.TextureID = UI.skinId
		mp.Color = WHITE
		mp.Material = Enum.Material.SmoothPlastic
		mp.CanCollide, mp.CanQuery, mp.CanTouch, mp.Massless, mp.Anchored = false, false, false, true, false
		return mp
	end

	-- puts a Steve part in place and welds it to the body part it follows
	local function attach(host, part, cf, folder)
		part:SetAttribute("Steve", true)
		part.CFrame = cf
		part.Parent = folder
		new("WeldConstraint", {Part0 = host, Part1 = part}, part)
	end

	function UI.buildSteve()
		UI.steveTok = (UI.steveTok or 0) + 1
		local tok = UI.steveTok
		UI.unsteve()
		local ch = player.Character
		if not UI.opt.steve or not ch then return end
		local f = new("Folder", {Name = "SteveModel"}, ch)
		UI.steveF = f
		local function live() return tok == UI.steveTok and f.Parent ~= nil end

		task.spawn(function()
			-- step 1 (takes a moment): load EVERY mesh first, so nothing is placed on a body that is still moving
			local meshes = {}
			if UI.opt.skin then
				for _, key in ipairs(ORDER) do
					local m = MESH[key]
					meshes[key] = {base = newMesh(m[1], m[2]), layer = UI.opt.layer2 and newMesh(m[6], m[7]) or nil}
					if not live() then
						for _, mm in pairs(meshes) do
							for _, x in pairs(mm) do x:Destroy() end
						end
						return
					end
				end
			end
			local torso = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
			if not live() or not torso then return end

			-- step 2 (instant, no waiting): place every part where the body is RIGHT NOW and weld it
			for _, key in ipairs(ORDER) do
				local m = MESH[key]
				local host = ch:FindFirstChild(m[4]) or ch:FindFirstChild(m[5])
				if host then
					local size, base = m[2], nil
					if key == "Head" then          -- the head sits on top of the torso
						base = torso.CFrame * CFrame.new(0, torso.Size.Y / 2 + size.Y / 2, 0)
					elseif key == "Torso" then
						base = host.CFrame * CFrame.new(0, host.Size.Y / 2 - size.Y / 2, 0)
					else                           -- arms / legs hang from the top of their part, a bit closer to the body
						local inward = (key:find("Arm") and 0.4715 or 0.157) * (key:find("Right") and -1 or 1)
						base = host.CFrame * CFrame.new(inward, host.Size.Y / 2 - size.Y / 2, 0)
					end

					local mm = meshes[key]
					if mm and mm.base then
						mm.base.Name = "Steve" .. key
						attach(host, mm.base, base, f)
						if mm.layer then               -- second layer (jacket / sleeves / pants / hat)
							mm.layer.Name = "Layer2" .. key
							attach(host, mm.layer, base, f)
						end
					else
						-- fallback: simple colored boxes
						local function mk(name, sz, col, cf)
							local part = new("Part", {Name = name, Size = sz, Color = col, Material = Enum.Material.SmoothPlastic, CanCollide = false,
								CanQuery = false, CanTouch = false, Massless = true, Anchored = false, TopSurface = Enum.SurfaceType.Smooth,
								BottomSurface = Enum.SurfaceType.Smooth}, nil)
							attach(host, part, cf, f)
						end
						local function at(x, y, z) return base * CFrame.new(x, y, z) end
						mk("Steve" .. key, size, m[3], base)
						if key == "Head" then                              -- hair, eyes, mouth (the front is -Z)
							local HAIR = C(70, 45, 25)
							mk("Hair", Vector3.new(size.X + 0.06, 0.4, size.Z + 0.06), HAIR, at(0, size.Y / 2 - 0.17, 0))
							mk("HairBack", Vector3.new(size.X + 0.06, size.Y * 0.6, 0.22), HAIR, at(0, size.Y * 0.1, size.Z / 2 - 0.1))
							for _, sx in ipairs({-1, 1}) do
								mk("Eye", Vector3.new(0.3, 0.16, 0.05), C(255, 255, 255), at(sx * 0.3, 0.05, -size.Z / 2 - 0.01))
								mk("Pupil", Vector3.new(0.15, 0.16, 0.06), C(70, 50, 130), at(sx * 0.22, 0.05, -size.Z / 2 - 0.02))
							end
							mk("Mouth", Vector3.new(0.45, 0.09, 0.05), C(130, 80, 60), at(0, -0.3, -size.Z / 2 - 0.01))
						elseif key:find("Arm") then                         -- short sleeve on top of the arm
							mk("Sleeve", Vector3.new(size.X + 0.04, 0.8, size.Z + 0.04), SHIRT, at(0, size.Y / 2 - 0.4, 0))
						elseif key:find("Leg") then                         -- shoes
							mk("Shoe", Vector3.new(size.X + 0.04, 0.3, size.Z + 0.04), C(110, 110, 115), at(0, -size.Y / 2 + 0.15, 0))
						end
					end
				end
			end
			UI.applySkin()
		end)
	end

	function UI.buildArmMesh()                       -- the 3D arm on your screen wears the skin too
		if not UI.opt.skin then UI.buildArm() return end
		task.spawn(function()
			local p = newMesh(6814397494, Vector3.new(0.7, 2, 0.55))
			if p then UI.buildArm(p) else UI.buildArm() end
		end)
	end

	function UI.setSkin(text)                        -- a skin image id / link typed in the settings
		local num = tostring(text or ""):match("%d+")
		if not num then return false end
		local url = "rbxassetid://" .. num
		task.spawn(function()
			pcall(function()                         -- a Decal id is not an Image id: ask Roblox for the real image
				local o = game:GetObjects(url)[1]
				if o then
					if (o:IsA("Decal") or o:IsA("Texture")) and o.Texture ~= "" then url = o.Texture end
					o:Destroy()
				end
			end)
			UI.skinId = url
			UI.buildSteve()
			UI.buildArmMesh()
		end)
		return true
	end

	on(player.CharacterAdded, function() task.wait(1.2) UI.buildSteve() end)
	UI.buildSteve()
	UI.buildArmMesh()
end

--====================================================================
-- HEAD LOOK: your head turns and tilts to where the camera looks (only on your screen)
--====================================================================
do
	local motor, torsoPart, c0
	local pitch, yaw = 0, 0
	local function find()
		local ch = player.Character
		if not ch then motor = nil return end
		if motor and motor.Parent and motor:IsDescendantOf(ch) then return end
		motor, torsoPart, c0 = nil, nil, nil
		local m = ch:FindFirstChild("Neck", true)
		if m and m:IsA("Motor6D") and m.Part0 then motor, torsoPart, c0 = m, m.Part0, m.C0 end
	end
	function UI.resetHead()
		if motor and motor.Parent and c0 then motor.C0 = c0 end
	end
	on(RS.RenderStepped, function(dt)
		find()
		if not motor then return end
		local look = UI.look()
		local root = getRoot()
		local hum = MV.hum
		if root and hum and hum.MoveDirection.Magnitude < 0.1 and not hum.Sit then   -- standing still: the body turns after the camera, like Minecraft
			local rl = root.CFrame:VectorToObjectSpace(look)
			local rel = math.atan2(-rl.X, -rl.Z)
			local LIMIT = math.rad(45)
			if math.abs(rel) > LIMIT then
				local dy = (math.abs(rel) - LIMIT) * (rel > 0 and 1 or -1) * math.min(1, dt * 10)
				root.CFrame = root.CFrame * CFrame.Angles(0, dy, 0)
			end
		end
		local lv = torsoPart.CFrame:VectorToObjectSpace(look)              -- the camera direction as seen from your body
		local ty = math.clamp(math.atan2(-lv.X, -lv.Z), -math.rad(80), math.rad(80))
		local tp = math.clamp(math.asin(math.clamp(lv.Y, -1, 1)), -math.rad(70), math.rad(70))
		local a = math.min(1, dt * 18)
		yaw += (ty - yaw) * a
		pitch += (tp - pitch) * a
		motor.C0 = CFrame.new(c0.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * (c0 - c0.Position)
	end)
end

