-- commands run locally and are never sent to other players
local function command(text)
	local slash = text:sub(1, 1) == "/"
	local m = text:lower():gsub("^%s*/", ""):match("^%s*(.-)%s*$")
	local cmd, arg = m:match("^(%a+)%s*(%S*)$")
	if cmd == "gamemode" or cmd == "gm" then
		local g = MODES[arg]
		if g then
			setMode(g)
			return true
		elseif slash or cmd == "gamemode" then
			sys("Use: gamemode creative | survival")
			return true
		end
		return false
	end
	if not slash then return false end

	local gname, gnum = m:match("^give%s+(.-)%s+(%d+)$")
	gname = gname or m:match("^give%s+(.+)$")
	if gname then
		gname = gname:gsub("^@%S+%s*", "")                 -- /give @s Oak_Planks : the @s part is ignored
		local d = findItem(gname)
		if d then
			give(d.Name, tonumber(gnum) or 1)
			sys("Gave " .. (gnum or 1) .. " " .. d.Name)
		else
			sys("Unknown item: " .. gname)
		end
	elseif cmd == "clear" then
		clearInv()
		sys("Inventory cleared")
	else
		sys("Unknown command (try /give <item> [amount], /clear, gamemode)")
	end
	return true
end

