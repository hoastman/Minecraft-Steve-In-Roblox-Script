---------- Chest + Furnace screens (right-click one; sneak + right-click to place a block on it) ----------
do
	local CT = setmetatable({}, {__mode = "k"})       -- block part -> its storage (stays when you close the screen)
	UI.CT = CT
	local FURN = {}                                   -- every furnace that exists (they keep cooking while closed)
	local SMELT = {Cobblestone = "Stone", Sand = "Glass", ["Oak Log"] = "Coal", Clay = "Bricks"}   -- input -> result
	local FUEL = {Coal = 40, ["Oak Log"] = 7.5, ["Oak Planks"] = 7.5, Stick = 2.5, Bookshelf = 7.5}   -- seconds of fire per item
	local COOK = 5                                    -- seconds to cook 1 item
	for k, v in pairs(SMELT) do if not (BY_NAME[k] and BY_NAME[v]) then SMELT[k] = nil end end
	for k in pairs(FUEL) do if not BY_NAME[k] then FUEL[k] = nil end end

	local function mkWin(name, lx)
		local w = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(340, 320),
			BackgroundColor3 = C(198, 198, 198), BorderSizePixel = 0, ZIndex = 2, Visible = false}, gui)
		bevel(w, WHITE, C(85, 85, 85), 4)
		UI.xscales = UI.xscales or {}
		UI.xscales[#UI.xscales + 1] = new("UIScale", {}, w)
		local function label(text, x, y)
			local l = new("TextLabel", {Text = text, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(140, 14), BackgroundTransparency = 1,
				TextColor3 = C(64, 64, 64), TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4}, w)
			pixelFont(l)
		end
		label(name, lx, 8)
		label("Inventory", 8, 144)
		for i = 9, 35 do makeSlot(i, 8 + 36 * ((i - 9) % 9), 160 + 36 * ((i - 9) // 9), nil, w) end   -- inventory
		for i = 36, 44 do makeSlot(i, 8 + 36 * (i - 36), 276, nil, w) end                              -- hotbar
		local x = new("TextButton", {Position = UDim2.fromOffset(310, 6), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = C(198, 198, 198),
			BorderSizePixel = 0, Text = "X", TextColor3 = C(64, 64, 64), TextSize = 11, AutoButtonColor = false, ZIndex = 6}, w)
		pixelFont(x)
		bevel(x, WHITE, C(85, 85, 85), 2)
		on(x.Activated, function() UI.closeContainer() end)
		return w
	end

	---------- Chest: 27 slots (3 x 9) ----------
	local chestWin = mkWin("Chest", 8)
	for k = 1, 27 do makeSlot(55 + k, 8 + 36 * ((k - 1) % 9), 26 + 36 * ((k - 1) // 9), nil, chestWin) end

	---------- Furnace: input (top), fuel (bottom), output (right) + flame + arrow ----------
	local furnWin = mkWin("Furnace", 104)
	makeSlot(83, 104, 26, nil, furnWin)                                   -- input
	makeSlot(84, 104, 98, nil, furnWin)                                   -- fuel
	makeSlot(85, 216, 54, nil, furnWin, function()                        -- output: you can only TAKE from it
		local o = inv[85]
		if not o then return end
		if cursor then
			if cursor.name ~= o.name or cursor.count + o.count > cap(o.name) then return end
			cursor.count += o.count
		else
			cursor = {name = o.name, count = o.count}
		end
		inv[85] = nil
		render(85)
		renderCursor()
	end, 52)

	local ARROW = {{0, 10, 24, 6}, {22, 4, 2, 18}, {24, 6, 2, 14}, {26, 8, 2, 10}, {28, 10, 2, 6}}
	local FLAME = {{4, 0, 6, 3}, {2, 3, 10, 4}, {0, 7, 14, 7}}
	for _, a in ipairs(ARROW) do                                          -- grey arrow
		new("Frame", {BackgroundColor3 = C(139, 139, 139), BorderSizePixel = 0, ZIndex = 4,
			Position = UDim2.fromOffset(163 + a[1], 67 + a[2]), Size = UDim2.fromOffset(a[3], a[4])}, furnWin)
	end
	local arrowClip = new("Frame", {BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 5,
		Position = UDim2.fromOffset(163, 71), Size = UDim2.fromOffset(0, 18)}, furnWin)
	for _, a in ipairs(ARROW) do                                          -- white arrow that fills up while cooking
		new("Frame", {BackgroundColor3 = C(250, 250, 250), BorderSizePixel = 0, ZIndex = 5,
			Position = UDim2.fromOffset(a[1], a[2] - 4), Size = UDim2.fromOffset(a[3], a[4])}, arrowClip)
	end
	for _, a in ipairs(FLAME) do                                          -- grey flame
		new("Frame", {BackgroundColor3 = C(139, 139, 139), BorderSizePixel = 0, ZIndex = 4,
			Position = UDim2.fromOffset(115 + a[1], 73 + a[2]), Size = UDim2.fromOffset(a[3], a[4])}, furnWin)
	end
	local flameClip = new("Frame", {BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 5,
		Position = UDim2.fromOffset(115, 87), Size = UDim2.fromOffset(14, 0)}, furnWin)
	local flameIn = new("Frame", {BackgroundTransparency = 1, ZIndex = 5, Position = UDim2.fromOffset(0, -14), Size = UDim2.fromOffset(14, 14)}, flameClip)
	for _, a in ipairs(FLAME) do                                          -- orange flame that burns down
		new("Frame", {BackgroundColor3 = C(255, 140, 20), BorderSizePixel = 0, ZIndex = 5,
			Position = UDim2.fromOffset(a[1], a[2]), Size = UDim2.fromOffset(a[3], a[4])}, flameIn)
	end

	function UI.furnUpdate(st)
		arrowClip.Size = UDim2.fromOffset(math.floor(30 * math.clamp(st.cook / COOK, 0, 1) + 0.5), 18)
		local h = st.burn > 0 and math.ceil(14 * math.clamp(st.burn / st.burnMax, 0, 1)) or 0
		flameClip.Position = UDim2.fromOffset(115, 73 + 14 - h)
		flameClip.Size = UDim2.fromOffset(14, h)
		flameIn.Position = UDim2.fromOffset(0, h - 14)
	end

	-- while a furnace screen is open its 3 slots live in inv[83..85]; otherwise in st.s[1..3]
	local function fget(st, k) if st.open then return inv[82 + k] end return st.s[k] end
	local function fset(st, k, v)
		if st.open then inv[82 + k] = v render(82 + k) else st.s[k] = v end
	end
	local function touch(st, k) if st.open then render(82 + k) end end

	local function tick(st, dt)
		dt = math.min(dt, 0.25)
		local inp, fuel, out = fget(st, 1), fget(st, 2), fget(st, 3)
		local res = inp and SMELT[inp.name]
		local can = res and (not out or (out.name == res and out.count < cap(res)))
		if st.burn <= 0 and can and fuel and FUEL[fuel.name] then       -- light a new piece of fuel
			st.burn, st.burnMax = FUEL[fuel.name], FUEL[fuel.name]
			fuel.count -= 1
			if fuel.count <= 0 then fset(st, 2, nil) else touch(st, 2) end
		end
		if st.burn > 0 then
			st.burn = math.max(0, st.burn - dt)
			if can then
				st.cook += dt
				if st.cook >= COOK then
					st.cook = 0
					inp.count -= 1
					if inp.count <= 0 then fset(st, 1, nil) else touch(st, 1) end
					if out then out.count += 1 touch(st, 3) else fset(st, 3, {name = res, count = 1}) end
				end
			else
				st.cook = math.max(0, st.cook - dt * 2)
			end
		else
			st.cook = math.max(0, st.cook - dt * 2)
		end
	end

	on(RS.Heartbeat, function(dt)
		for i = #FURN, 1, -1 do
			local st = FURN[i]
			if not st.part.Parent then table.remove(FURN, i) else tick(st, dt) end
		end
		local xs = UI.xst
		if xs then
			if xs.kind == "Furnace" then UI.furnUpdate(xs) end
			local r = getRoot()
			if not xs.part.Parent or (r and (r.Position - xs.part.Position).Magnitude > 30) then UI.closeContainer() end   -- walked away
		end
	end)

	function UI.openContainer(part, kind)
		UI.closeContainer()
		UI.setPanel(false)
		UI.setCraft(false)
		UI.setMenu(false)
		local st = CT[part]
		if not st then
			st = {kind = kind, s = {}, burn = 0, burnMax = 1, cook = 0, part = part}
			CT[part] = st
			if kind == "Furnace" then FURN[#FURN + 1] = st end
		end
		if kind == "Chest" then
			for k = 1, 27 do inv[55 + k] = st.s[k] render(55 + k) end
			chestWin.Visible = true
		else
			for k = 1, 3 do inv[82 + k] = st.s[k] render(82 + k) end
			furnWin.Visible = true
			UI.furnUpdate(st)
		end
		st.open, UI.xst = true, st
		stopBreak()
		UI.sync()
	end

	function UI.closeContainer()
		local st = UI.xst
		if not st then return end
		if cursor then give(cursor.name, cursor.count) cursor = nil renderCursor() end
		if st.kind == "Chest" then
			for k = 1, 27 do st.s[k] = inv[55 + k] inv[55 + k] = nil render(55 + k) end
		else
			for k = 1, 3 do st.s[k] = inv[82 + k] inv[82 + k] = nil render(82 + k) end
		end
		st.open, UI.xst = false, nil
		chestWin.Visible, furnWin.Visible = false, false
		stopBreak()
		UI.sync()
	end
end

---------- Camera: zoom 0 (first person) + F5 like Minecraft ----------
do
	UI.perspNames = {"First Person", "Third Person (back)", "Third Person (front)"}
	UI.origMin, UI.origMax = player.CameraMinZoomDistance, player.CameraMaxZoomDistance

	function UI.applyPersp()
		if UI.persp == 0 then                        -- zoom 0
			player.CameraMinZoomDistance = 0.5
			player.CameraMaxZoomDistance = 0.5
		else
			player.CameraMaxZoomDistance = 12
			player.CameraMinZoomDistance = 12
		end
		UI.refreshHand()
	end

	function UI.cyclePersp()                         -- F5: first person -> back -> front -> first person
		UI.persp = (UI.persp + 1) % 3
		UI.applyPersp()
		if UI.refreshOpts then UI.refreshOpts() end
	end

	-- front view = the normal camera, mirrored to the other side of you right after Roblox moves it
	pcall(function() RS:UnbindFromRenderStep("MCFrontRestore") end)
	pcall(function() RS:UnbindFromRenderStep("MCFrontMirror") end)
	RS:BindToRenderStep("MCFrontRestore", Enum.RenderPriority.First.Value, function()
		if UI.mirrored then
			Workspace.CurrentCamera.CFrame = UI.origCF
			UI.mirrored = false
		end
	end)
	RS:BindToRenderStep("MCFrontMirror", Enum.RenderPriority.Camera.Value + 1, function()
		if UI.persp ~= 2 then return end
		local hrp = getRoot()
		if not hrp then return end
		local c = Workspace.CurrentCamera
		UI.origCF = c.CFrame
		local focus = hrp.Position + Vector3.new(0, 1.5, 0)
		c.CFrame = CFrame.lookAt(focus + (focus - c.CFrame.Position), focus)
		UI.mirrored = true
	end)

	UI.applyPersp()
end

