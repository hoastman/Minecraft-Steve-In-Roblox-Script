-- BREAK PARTICLES: little cubes of the block burst out when you break it, fall and fade
do
	local parts = {}
	local FACES = {Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Top, Enum.NormalId.Bottom}
	function UI.breakFX(pos, def, color)
		local tex = def and def.Texture and (def.Texture.All or def.Texture.Side or def.Texture.Front or def.Texture.Top or select(2, next(def.Texture)))
		for _ = 1, 14 do
			local size = 0.45 + math.random() * 0.3
			local p = new("Part", {Size = Vector3.one * size, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
				Color = def and def.Color or color or C(150, 150, 150), Material = def and def.Material or Enum.Material.SmoothPlastic,
				TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, dropFolder)
			if tex then
				for _, f in ipairs(FACES) do new("Decal", {Texture = tex, Face = f, Color3 = def.Tint or WHITE}, p) end
			end
			local off = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (BLOCK * 0.8)
			parts[#parts + 1] = {part = p, pos = pos + off, vel = off.Unit * (6 + math.random() * 8) + Vector3.new(0, 7 + math.random() * 5, 0),
				life = 0.55 + math.random() * 0.4, age = 0, size = size, rot = Vector3.new(math.random() * 6, math.random() * 6, math.random() * 6)}
		end
	end
	on(RS.Heartbeat, function(dt)
		for i = #parts, 1, -1 do
			local q = parts[i]
			q.age += dt
			if q.age >= q.life or not q.part.Parent then
				pcall(function() q.part:Destroy() end)
				table.remove(parts, i)
			else
				q.vel += Vector3.new(0, -60 * dt, 0)
				q.pos += q.vel * dt
				local k = q.age / q.life
				q.part.Size = Vector3.one * (q.size * (1 - k * 0.6))
				q.part.Transparency = math.max(0, (k - 0.6) / 0.4)
				q.part.CFrame = CFrame.new(q.pos) * CFrame.Angles(q.rot.X * q.age * 3, q.rot.Y * q.age * 3, q.rot.Z * q.age * 3)
			end
		end
	end)
end

local function breakPart(part)
	local kind, bpos = part:GetAttribute("BlockType"), part:GetAttribute("Cell") or part:GetPivot().Position
	UI.spill(part, bpos)
	UI.breakFX(bpos, kind and BY_NAME[kind], part:IsA("BasePart") and part.Color or nil)   -- particles
	local wasStair = kind and BY_NAME[kind] and BY_NAME[kind].Shape == "Stairs"
	part:Destroy()
	if wasStair then UI.refreshStairs(bpos) end
	UI.broken += 1
	if mode == "survival" and kind and BY_NAME[kind] then spawnDrop(bpos, BY_NAME[kind]) end   -- drops an item
end

-- TNT: it NEVER explodes by itself or when you break it. It only goes off when it is lit by
--   * Flint and Steel (right-click the TNT),            * a redstone item in your hand (Redstone Dust / Lever, right-click the TNT),
--   * a Redstone Block touching it (place either one next to the other),   * Fire next to it,   * another TNT exploding nearby.
-- Lit TNT flashes for a few seconds, then blows a hole in the blocks around it, pushes you away (hurts you in survival)
-- and lights the TNT it reaches (chain reaction).
local NEIGHBORS = {Vector3.xAxis, -Vector3.xAxis, Vector3.yAxis, -Vector3.yAxis, Vector3.zAxis, -Vector3.zAxis}

local function blockAtCell(p)
	for _, part in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(p), Vector3.one * 0.6)) do
		local r = blockRoot(part)
		if r then return r end
	end
end

function UI.igniteTNT(root, fuse)
	if not root or not root.Parent or root:GetAttribute("Lit") then return end
	root:SetAttribute("Lit", true)
	local pos = root:GetAttribute("Cell") or root:GetPivot().Position
	local flash = new("Part", {Size = Vector3.one * (BLOCK + 0.06), CFrame = CFrame.new(pos), Anchored = true, CanCollide = false, CanQuery = false,
		CanTouch = false, Material = Enum.Material.Neon, Color = WHITE, Transparency = 1}, root)
	task.spawn(function()
		local total, t, nextFlip, on_ = fuse or 3.2, 0, 0, false
		while t < total do
			if t >= nextFlip then                              -- flashes white, faster and faster
				on_ = not on_
				flash.Transparency = on_ and 0.35 or 1
				nextFlip = t + (t > total * 0.6 and 0.12 or 0.25)
			end
			t += RS.Heartbeat:Wait()
		end
		if flash.Parent then flash:Destroy() end
		UI.explode(pos, root)
	end)
end

function UI.explode(pos, selfRoot)
	local R = BLOCK * 3.2                                      -- blast radius
	local ex = new("Explosion", {Position = pos, BlastRadius = BLOCK * 2, BlastPressure = 0, DestroyJointRadiusPercent = 0,
		ExplosionType = Enum.ExplosionType.NoCraters}, Workspace)       -- just the fireball: it pushes nothing by itself
	task.delay(3, function() pcall(function() ex:Destroy() end) end)
	local fx, drops = 0, 0
	for _, b in ipairs(folder:GetChildren()) do
		local bp = b:GetAttribute("Cell") or (b:IsA("Model") and b:GetPivot().Position) or b.Position
		local dist = (bp - pos).Magnitude
		if b == selfRoot then
			b:Destroy()
		elseif dist <= R then
			local kind = b:GetAttribute("BlockType")
			if kind == "TNT" then
				UI.igniteTNT(b, 0.4 + math.random() * 0.8)    -- chain reaction: a short fuse
			else
				local k = dist / R
				if k < 0.6 or math.random() > (k - 0.6) / 0.4 then   -- the middle always breaks, the edge only sometimes
					UI.spill(b, bp)
					if fx < 30 then fx += 1 UI.breakFX(bp, kind and BY_NAME[kind], b:IsA("BasePart") and b.Color or nil) end
					if mode == "survival" and kind and BY_NAME[kind] and drops < 20 and math.random() < 0.25 then
						drops += 1
						spawnDrop(bp, BY_NAME[kind])
					end
					b:Destroy()
					UI.broken += 1
				end
			end
		end
	end
	UI.breakFX(pos, BY_NAME["TNT"])
	local r, hum = getRoot(), MV.hum                          -- you: pushed away, hurt in survival
	if r then
		local off = r.Position - pos
		local dist = off.Magnitude
		local reach = R * 1.8
		if dist < reach then
			local k = 1 - dist / reach
			local dir = dist > 0.1 and off.Unit or Vector3.yAxis
			r.AssemblyLinearVelocity += (dir + Vector3.new(0, 0.6, 0)).Unit * (70 * k + 10)
			if hum and mode == "survival" then hum:TakeDamage(math.floor(18 * k + 0.5)) end
		end
	end
end

-- placing a Redstone Block next to TNT (or TNT / Fire next to a Redstone Block / TNT) lights it
function UI.redstoneCheck(pos, d, placed)
	if not d or not placed then return end
	for _, dv in ipairs(NEIGHBORS) do
		local nb = blockAtCell(pos + dv * BLOCK)
		if nb then
			local bt = nb:GetAttribute("BlockType")
			if (d.Name == "Redstone Block" or d.Name == "Fire") and bt == "TNT" then
				UI.igniteTNT(nb)
			elseif d.Name == "TNT" and (bt == "Redstone Block" or bt == "Fire") then
				UI.igniteTNT(placed)
			end
		end
	end
end

local function startBreak(getPt, input)
	if panelOpen or chatOpen then return end
	hold.active, hold.getPt, hold.input = true, getPt, input
	hold.part, hold.prog, hold.lastSwing, hold.lastBreak = nil, 0, os.clock(), 0
	swing()                                            -- the arm swings the moment you press BREAK (even on air)
end

function stopBreak()
	hold.active, hold.input, hold.part, hold.prog = false, nil, nil, 0
	bbar.Visible = false
end

on(RS.Heartbeat, function(dt)
	if not hold.active then return end
	if panelOpen or chatOpen then stopBreak() return end
	local now = os.clock()
	if now - hold.lastSwing > 0.35 then hold.lastSwing = now swing() end
	local hit = getTarget(hold.getPt())
	local r = getRoot()
	local part = hit and r and (r.Position - hit.Position).Magnitude <= REACH and blockRoot(hit.Instance) or nil
	if part ~= hold.part then hold.part, hold.prog = part, 0 end
	if not part then bbar.Visible = false return end
	if mode == "creative" then
		bbar.Visible = false
		if now - hold.lastBreak > 0.25 then
			hold.lastBreak = now
			hold.part = nil
			breakPart(part)
		end
		return
	end
	local def = BY_NAME[part:GetAttribute("BlockType") or ""]
	local need = (def and def.BreakTime) or BREAK_TIME
	hold.prog += dt
	bbar.Visible = true
	bfill.Size = UDim2.fromScale(math.min(hold.prog / need, 1), 1)
	if hold.prog >= need then
		hold.part, hold.prog = nil, 0
		bbar.Visible = false
		breakPart(part)
	end
end)

-- SNEAK EDGE GUARD: while sneaking you cannot fall off a block's edge (like Minecraft), and you can LEAN OUT over it:
-- you stay up while ANY part of your body is over ground, so your head / camera hangs past the edge and looks down the side.
local edgeParams = RaycastParams.new()
edgeParams.FilterType = Enum.RaycastFilterType.Exclude
edgeParams.IgnoreWater = true
pcall(function() edgeParams.RespectCanCollide = true end)
-- A thin invisible ledge (UI.sneakPad) follows your feet while you sneak, so the part of your body that hangs over the edge
-- still has floor under it and you do not slip off. It is only there while you sneak.
pcall(function() RS:UnbindFromRenderStep("MCSneakEdge") end)
RS:BindToRenderStep("MCSneakEdge", Enum.RenderPriority.Input.Value + 1, function(dt)
	local sneaking = (MV.sneakHeld or MV.sneakTog) and not UI.flying
	local pad = UI.sneakPad
	if not sneaking then                                          -- not sneaking: the ledge is gone (you fall like normal)
		if pad and pad.CanCollide then pad.CanCollide = false end
		UI.sneakY = nil
		return
	end
	local hum, root = MV.hum, getRoot()
	if not hum or not root or hum.Health <= 0 then return end
	if not pad or not pad.Parent then
		pad = new("Part", {Name = "MCSneakPad", Size = Vector3.new(2, 0.4, 2), Anchored = true, CanCollide = false, CanQuery = false,
			CanTouch = false, Transparency = 1}, Workspace)
		UI.sneakPad = pad
	end
	edgeParams.FilterDescendantsInstances = {player.Character, dropFolder, pad, UI.ghost}
	local pos = root.Position
	local near = Workspace:Raycast(pos, Vector3.new(0, -4.5, 0), edgeParams)   -- the ground you stand on
	if near then
		UI.sneakY, UI.sneakAir = near.Position.Y, 0
	elseif hum.FloorMaterial == Enum.Material.Air then            -- really in the air (jump / fall): forget the ledge
		UI.sneakAir = (UI.sneakAir or 0) + dt
		if UI.sneakAir > 0.4 then UI.sneakY = nil end
	end
	if UI.sneakY then                                             -- keep the little ledge under your feet at ground height
		pad.CFrame = CFrame.new(pos.X, UI.sneakY - 0.2, pos.Z)
		pad.CanCollide = true
	else
		pad.CanCollide = false
	end

	local md = hum.MoveDirection
	local flat = Vector3.new(md.X, 0, md.Z)
	if not UI.sneakY or flat.Magnitude < 0.05 then return end
	local floorY = UI.sneakY
	local function ground(p)                                      -- ground under this spot, at most ~1.5 studs lower than where you stand
		return Workspace:Raycast(Vector3.new(p.X, floorY + 1.8, p.Z), Vector3.new(0, -3.4, 0), edgeParams) ~= nil
	end
	local HALF = 1.4                                              -- like Minecraft: you stay up while ANY part of your body is over ground
	local function supported(p)
		return ground(p) or ground(p + Vector3.new(HALF, 0, HALF)) or ground(p + Vector3.new(-HALF, 0, HALF))
			or ground(p + Vector3.new(HALF, 0, -HALF)) or ground(p + Vector3.new(-HALF, 0, -HALF))
	end
	local step = flat.Unit * (0.45 + hum.WalkSpeed * dt * 2)       -- a little ahead of where you are about to be
	if supported(pos + step) then return end                      -- still over ground: walk normally (you can lean out past the edge)
	local out = Vector3.zero                                      -- nothing under you ahead: keep only the part that is safe (slide along the edge)
	if math.abs(step.X) > 0.05 and supported(pos + Vector3.new(step.X, 0, 0)) then out += Vector3.new(md.X, 0, 0) end
	if math.abs(step.Z) > 0.05 and supported(pos + Vector3.new(0, 0, step.Z)) then out += Vector3.new(0, 0, md.Z) end
	hum:Move(out, false)
end)

-- SPRINT: hold Shift (phone: SPRINT button).   SNEAK: hold Ctrl or C (phone: SNEAK button) = slow + lower camera.
on(RS.Heartbeat, function(dt)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if hum ~= MV.hum then MV.hum, MV.base, MV.camY = hum, nil, 0 end
	local sneak = MV.sneakHeld or MV.sneakTog
	local sprint = (MV.sprintHeld or MV.sprintTog) and not sneak
	if MV.sprintTog and hum.MoveDirection.Magnitude < 0.1 then      -- the SPRINT button switches off when you stop
		MV.idle += dt
		if MV.idle > 0.3 then MV.sprintTog = false if MV.refresh then MV.refresh() end end
	else
		MV.idle = 0
	end
	if sneak or sprint then
		if not MV.base then MV.base = hum.WalkSpeed end
		hum.WalkSpeed = sneak and 6 or MV.base * 1.6
	elseif MV.base then
		hum.WalkSpeed, MV.base = MV.base, nil
	end
	local k = math.min(1, dt * 12)
	if sneak or math.abs(MV.camY) > 0.01 then
		local nxt = MV.camY + ((sneak and -1 or 0) - MV.camY) * k
		hum.CameraOffset += Vector3.new(0, nxt - MV.camY, 0)
		MV.camY = nxt
	end
	if sprint or math.abs(MV.fov) > 0.05 then
		local nxt = MV.fov + ((sprint and 8 or 0) - MV.fov) * k
		Workspace.CurrentCamera.FieldOfView += nxt - MV.fov
		MV.fov = nxt
	end
end)

-- SNEAK POSE: your body hunches over like in Minecraft (R6 and R15). Built by bending the body joints, so it needs no animation id.
do
	local joints, jhum, blend, restored = nil, nil, 0, true
	local function rot(base, ang, pivot)               -- turn a joint around the X axis (side to side), around its own point
		local p = pivot or base.Position
		return CFrame.new(p) * CFrame.Angles(ang, 0, 0) * CFrame.new(-p) * base
	end
	local function scan(ch, hum)
		local j = {}
		local function add(name, kind)
			local m = ch:FindFirstChild(name, true)
			if m and m:IsA("Motor6D") then j[#j + 1] = {m = m, base = m.C0, kind = kind} end
		end
		if hum.RigType == Enum.HumanoidRigType.R15 then
			add("Waist", "waist") add("RightHip", "hip") add("LeftHip", "hip") add("RightKnee", "knee") add("LeftKnee", "knee") add("Root", "root")
		else
			add("RootJoint", "r6root") add("Right Hip", "r6hip") add("Left Hip", "r6hip")
		end
		return j
	end
	on(RS.RenderStepped, function(dt)
		local hum, ch = MV.hum, player.Character
		if not hum or not ch or hum.Health <= 0 then return end
		local want = ((MV.sneakHeld or MV.sneakTog) and not UI.flying and #(UI.poseParts or {}) == 0) and 1 or 0
		if hum ~= jhum or (joints and joints[1] and not joints[1].m.Parent) then joints, jhum, blend, restored = nil, hum, 0, true end
		if want == 0 and restored then return end
		if not joints then joints = scan(ch, hum) end
		blend += (want - blend) * math.min(1, dt * 10)
		if want == 0 and blend < 0.01 then                          -- back to normal: give every joint its original place
			for _, j in ipairs(joints) do if j.m.Parent then j.m.C0 = j.base end end
			blend, restored = 0, true
			return
		end
		restored = false
		for _, j in ipairs(joints) do
			if j.m.Parent then
				local k = j.kind
				if k == "waist" then j.m.C0 = rot(j.base, -0.38 * blend)                              -- lean forward
				elseif k == "hip" then j.m.C0 = rot(j.base, 0.32 * blend)                             -- thighs forward
				elseif k == "knee" then j.m.C0 = rot(j.base, -0.65 * blend)                           -- knees bent
				elseif k == "root" then j.m.C0 = CFrame.new(0, -0.22 * blend, 0) * j.base            -- body a bit lower
				elseif k == "r6root" then j.m.C0 = rot(j.base, -0.38 * blend, Vector3.new(0, -1, 0))   -- torso leans forward from the hips
				elseif k == "r6hip" then j.m.C0 = rot(j.base, 0.38 * blend) end                       -- legs stay straight under you
			end
		end
	end)
end

-- the arm bobs while you walk (faster when sprinting, slower when sneaking) and breathes when you stand still
on(RS.RenderStepped, function(dt)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local moving = hum and hum.MoveDirection.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air
	local sneak = MV.sneakHeld or MV.sneakTog
	local sprint = (MV.sprintHeld or MV.sprintTog) and not sneak
	UI.bobA += ((moving and 1 or 0) - UI.bobA) * math.min(1, dt * 8)
	UI.bobT += dt * (moving and (sprint and 13 or (sneak and 6 or 9)) or 0)
	local idle = math.sin(os.clock() * 1.5) * 2.5 * (1 - UI.bobA)
	handBob.Position = UI.opt.bob and UDim2.fromOffset(math.cos(UI.bobT) * 8 * UI.bobA, math.abs(math.sin(UI.bobT)) * 10 * UI.bobA + idle) or UDim2.fromOffset(0, 0)
	if UI.armModel and handRoot.Visible then            -- swing the 3D arm forward around the shoulder, then back
		local k = UI.swingAt and math.clamp((os.clock() - UI.swingAt) / 0.3, 0, 1) or 1
		local sw = math.sin(k * math.pi)
		local p = UI.armShoulder
		UI.armModel:PivotTo(CFrame.new(p) * CFrame.Angles(-0.9 * sw, 0.35 * sw, 0.25 * sw) * CFrame.new(-p) * UI.armBase)
	end
end)

