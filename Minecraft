			local item, ic = newItemView(b, 7)
			item.BackgroundColor3 = d.Color
			item.BackgroundTransparency = bgT(d)
			setIcon(ic, d)
			on(b.MouseEnter, function() title.Text = d.Name end)
			on(b.MouseLeave, function() title.Text = tabTitle() end)
			on(b.Activated, function() -- pick ONE item, then tap a slot to put it
				if cursor then                                       -- carrying something: tapping the list puts it back (never swaps)
					cursor = nil
					renderCursor()
					return
				end
				cursor = {name = d.Name, count = UI.opt.takeOne and 1 or cap(d.Name)}
				renderCursor()
				title.Text = d.Name
			end)
		end
	end
end
