-- SAVED SETTINGS: your options, your skin and the skin history are saved in a file (DeltaMinecraft_settings.json in the executor's workspace folder)
-- and loaded again the next time you run the script.
UI.SAVE_FILE = "DeltaMinecraft_settings.json"
UI.skinHistory = {}
do
	local HttpService = game:GetService("HttpService")
	local hasFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
	if not hasFS then warn("Delta Minecraft: this executor has no file functions, settings can not be saved") end
	function UI.saveSettings()
		if not hasFS then return end
		local data = {opt = {}, skinHistory = UI.skinHistory, skinId = UI.skinId}
		for k, v in pairs(UI.opt) do
			local t = type(v)
			if t == "boolean" or t == "number" or t == "string" then data.opt[k] = v end
		end
		local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
		if ok and json ~= UI.lastSaved then
			if pcall(writefile, UI.SAVE_FILE, json) then UI.lastSaved = json end
		end
	end
	function UI.loadSettings()
		if not hasFS then return end
		local ok, raw = pcall(function() if isfile(UI.SAVE_FILE) then return readfile(UI.SAVE_FILE) end end)
		if not ok or type(raw) ~= "string" then return end
		local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not ok2 or type(data) ~= "table" then return end
		for k, v in pairs(data.opt or {}) do
			if UI.opt[k] ~= nil and type(UI.opt[k]) == type(v) then UI.opt[k] = v end
		end
		if type(data.skinHistory) == "table" then
			for _, id in ipairs(data.skinHistory) do
				if #UI.skinHistory < 12 and tostring(id):match("^%d+$") then UI.skinHistory[#UI.skinHistory + 1] = tostring(id) end
			end
		end
		if type(data.skinId) == "string" and data.skinId ~= "" then UI.savedSkin = data.skinId end
		UI.lastSaved = raw
	end
	function UI.addSkinHistory(id)                       -- newest first, no doubles, 12 at most
		id = tostring(id)
		if UI.skinDefault and UI.skinDefault:find(id, 1, true) then return end   -- the normal Steve skin is not listed
		for i = #UI.skinHistory, 1, -1 do
			if UI.skinHistory[i] == id then table.remove(UI.skinHistory, i) end
		end
		table.insert(UI.skinHistory, 1, id)
		while #UI.skinHistory > 12 do table.remove(UI.skinHistory) end
		UI.saveSettings()
	end
	UI.loadSettings()
	local acc = 0
	on(RS.Heartbeat, function(dt)                        -- changes are written to the file every 3 seconds
		acc += dt
		if acc >= 3 then acc = 0 UI.saveSettings() end
	end)
end

