				new("Decal", {Texture = ic, Face = Enum.NormalId.Front, Color3 = Color3.new(sh, sh, sh)}, sl)
				new("Decal", {Texture = ic, Face = Enum.NormalId.Back, Color3 = Color3.new(sh, sh, sh)}, sl)
			end
		else
			(SHAPE[shapeFor(d) or "plate"])(vf, d.Color, d)
		end
		local dir = Vector3.new(-0.5, 0.32, 1).Unit                  -- seen from the front-left a little: you see the thickness
		vf.CurrentCamera = new("Camera", {FieldOfView = vf:GetAttribute("hv") and 26 or 22, CFrame = CFrame.lookAt(dir * 5, Vector3.zero)}, vf)
	end
