local function addChat(raw)
	local last = chatLines[#chatLines]
	if last and last.raw == raw then          -- duplicate -> "(n)" counter like Compact Chat
		last.n += 1
		last.t = os.clock()
		last.lbl.Text = raw .. ' <font color="#aaaaaa">(' .. last.n .. ')</font>'
	else
		chatSeq += 1
		local lbl = new("TextLabel", {Size = UDim2.new(1, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = UI.opt.chatBg, BorderSizePixel = 0, RichText = true, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
