local order = {}
for i = 36, 44 do order[#order + 1] = i end
for i = 9, 35 do order[#order + 1] = i end

function give(name, amount)
	local limit = cap(name)
	while amount > 0 do
		local target
		for _, i in ipairs(order) do
			if inv[i] and inv[i].name == name and inv[i].count < limit then target = i break end
		end
		if not target then
			for _, i in ipairs(order) do
				if not inv[i] then target = i break end
			end
		end
		if not target then return amount end
		inv[target] = inv[target] or {name = name, count = 0}
		local add = math.min(limit - inv[target].count, amount)
		inv[target].count += add
		amount -= add
		render(target)
	end
	return 0
end

