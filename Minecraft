	if sz then item.Position = UDim2.fromOffset(8, 8) item.Size = UDim2.fromOffset(sz - 20, sz - 20) end
	item.Visible = false
	local count = new("TextLabel", {AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 2), Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1, TextColor3 = WHITE, TextSize = 12, TextStrokeTransparency = 0, Visible = false, ZIndex = 9}, btn)
