		LeftLeg  = {6814397937, Vector3.new(0.686, 2.1, 0.686),   PANTS, "Left Leg", "LeftUpperLeg", 6814398746, Vector3.new(0.753, 2.125, 0.753)},
	}
	local ORDER = {"Torso", "Head", "RightArm", "LeftArm", "RightLeg", "LeftLeg"}

	UI.poseParts = {}
	function UI.unsteve()
		UI.steveNeck = nil
		UI.poseParts, UI.steveTorso = {}, nil
		if UI.steveF then pcall(function() UI.steveF:Destroy() end) UI.steveF = nil end
	end

	-- a Steve MeshPart painted with the skin (nil if the mesh can't be loaded)
	local function newMesh(id, size)
		local ok, mp = pcall(function() return AssetService:CreateMeshPartAsync("rbxassetid://" .. id) end)
		if not ok or not mp then return nil end
		mp.Size = size
		mp.TextureID = UI.skinId
		mp.Color = WHITE
		mp.Material = Enum.Material.SmoothPlastic
		mp.CanCollide, mp.CanQuery, mp.CanTouch, mp.Massless, mp.Anchored = false, false, false, true, false
		return mp
	end

	-- puts a Steve part in place and welds it to the body part it follows
	local function attach(host, part, cf, folder, key)
		part:SetAttribute("Steve", true)
		part.CFrame = cf
		part.Parent = folder
		local rel = host.CFrame:ToObjectSpace(cf)
		local w = new("Weld", {Part0 = host, Part1 = part, C0 = rel}, part)       -- a Weld (not WeldConstraint): the pose below moves it
		UI.poseParts[#UI.poseParts + 1] = {weld = w, host = host, rel = rel, key = key or "Torso"}
	end

	function UI.buildSteve()
		UI.steveTok = (UI.steveTok or 0) + 1
		local tok = UI.steveTok
		UI.unsteve()
		local ch = player.Character
		if not UI.opt.steve or not ch then UI.buildInvSteve() return end
		local f = new("Folder", {Name = "SteveModel"}, ch)
		UI.steveF = f
		local function live() return tok == UI.steveTok and f.Parent ~= nil end

		task.spawn(function()
			-- step 1 (takes a moment): load EVERY mesh first, so nothing is placed on a body that is still moving
			local meshes = {}
			if UI.opt.skin then
				for _, key in ipairs(ORDER) do
					local m = MESH[key]
					meshes[key] = {base = newMesh(m[1], m[2]), layer = UI.opt.layer2 and newMesh(m[6], m[7]) or nil}
					if not live() then
						for _, mm in pairs(meshes) do
							for _, x in pairs(mm) do x:Destroy() end
						end
						return
					end
				end
			end
			local torso = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
			if not live() or not torso then return end
			UI.steveTorso = torso

			-- step 2 (instant, no waiting): place every part where the body is RIGHT NOW and weld it
			for _, key in ipairs(ORDER) do
				local m = MESH[key]
				local host = ch:FindFirstChild(m[4]) or ch:FindFirstChild(m[5])
				if host then
					local size, base = m[2], nil
					if key == "Head" then          -- the head sits on top of the torso
						base = torso.CFrame * CFrame.new(0, torso.Size.Y / 2 + size.Y / 2, 0)
					elseif key == "Torso" then
						base = host.CFrame * CFrame.new(0, host.Size.Y / 2 - size.Y / 2, 0)
					else                           -- arms / legs hang from the top of their part, a bit closer to the body
						local inward = (key:find("Arm") and 0.4715 or 0.157) * (key:find("Right") and -1 or 1)
						base = host.CFrame * CFrame.new(inward, host.Size.Y / 2 - size.Y / 2, 0)
					end

					local mm = meshes[key]
					if mm and mm.base and key == "Head" then
						-- the visible head hangs on its OWN neck joint, so it turns with the camera on any rig (R6 / R15)
						mm.base.Name = "SteveHead"
						mm.base:SetAttribute("Steve", true)
						mm.base.CFrame = base
						mm.base.Parent = f
						UI.steveNeck = new("Motor6D", {Name = "SteveNeck", Part0 = torso, Part1 = mm.base,
							C0 = CFrame.new(0, torso.Size.Y / 2, 0), C1 = CFrame.new(0, -size.Y / 2, 0)}, mm.base)
						if mm.layer then               -- hat / hair layer follows the head
							mm.layer.Name = "Layer2Head"
							mm.layer:SetAttribute("Steve", true)
							mm.layer.CFrame = base
							mm.layer.Parent = f
							new("WeldConstraint", {Part0 = mm.base, Part1 = mm.layer}, mm.layer)
						end
					elseif mm and mm.base then
						mm.base.Name = "Steve" .. key
						attach(host, mm.base, base, f, key)
						if mm.layer then               -- second layer (jacket / sleeves / pants / hat)
							mm.layer.Name = "Layer2" .. key
							attach(host, mm.layer, base, f, key)
						end
					else
						-- fallback: simple colored boxes
						local function mk(name, sz, col, cf)
							local part = new("Part", {Name = name, Size = sz, Color = col, Material = Enum.Material.SmoothPlastic, CanCollide = false,
								CanQuery = false, CanTouch = false, Massless = true, Anchored = false, TopSurface = Enum.SurfaceType.Smooth,
								BottomSurface = Enum.SurfaceType.Smooth}, nil)
							attach(host, part, cf, f, key)
						end
						local function at(x, y, z) return base * CFrame.new(x, y, z) end
						mk("Steve" .. key, size, m[3], base)
						if key == "Head" then                              -- hair, eyes, mouth (the front is -Z)
							local HAIR = C(70, 45, 25)
							mk("Hair", Vector3.new(size.X + 0.06, 0.4, size.Z + 0.06), HAIR, at(0, size.Y / 2 - 0.17, 0))
							mk("HairBack", Vector3.new(size.X + 0.06, size.Y * 0.6, 0.22), HAIR, at(0, size.Y * 0.1, size.Z / 2 - 0.1))
							for _, sx in ipairs({-1, 1}) do
								mk("Eye", Vector3.new(0.3, 0.16, 0.05), C(255, 255, 255), at(sx * 0.3, 0.05, -size.Z / 2 - 0.01))
								mk("Pupil", Vector3.new(0.15, 0.16, 0.06), C(70, 50, 130), at(sx * 0.22, 0.05, -size.Z / 2 - 0.02))
							end
							mk("Mouth", Vector3.new(0.45, 0.09, 0.05), C(130, 80, 60), at(0, -0.3, -size.Z / 2 - 0.01))
						elseif key:find("Arm") then                         -- short sleeve on top of the arm
							mk("Sleeve", Vector3.new(size.X + 0.04, 0.8, size.Z + 0.04), SHIRT, at(0, size.Y / 2 - 0.4, 0))
						elseif key:find("Leg") then                         -- shoes
							mk("Shoe", Vector3.new(size.X + 0.04, 0.3, size.Z + 0.04), C(110, 110, 115), at(0, -size.Y / 2 + 0.15, 0))
						end
					end
				end
			end
			UI.applySkin()
			UI.buildInvSteve()
			UI.heldKey = nil
			if UI.hold3D then UI.hold3D() end
		end)
	end

	-- Steve standing in the inventory screen (his own pose, wearing the skin)
	function UI.buildInvSteve()
		local vpf = UI.invVP
		if not vpf then return end
		if not UI.opt.steve then UI.buildInvAvatar() return end
		vpf:ClearAllChildren()
		vpf.Ambient, vpf.LightColor = C(170, 170, 170), WHITE
		vpf.CurrentCamera = new("Camera", {FieldOfView = 38, CFrame = CFrame.lookAt(Vector3.new(0, 0.5, -9.5), Vector3.new(0, -0.4, 0))}, vpf)
		local model = new("Model", {Name = "InvSteve"}, vpf)
		model.WorldPivot = CFrame.new()
		task.spawn(function()
			local T, H = MESH.Torso[2], MESH.Head[2]
			local armX, legY = T.X / 2 + MESH.RightArm[2].X / 2, T.Y / 2 + MESH.RightLeg[2].Y / 2
			local POS = {Torso = Vector3.zero, Head = Vector3.new(0, T.Y / 2 + H.Y / 2, 0),
				RightArm = Vector3.new(armX, 0, 0), LeftArm = Vector3.new(-armX, 0, 0),
				RightLeg = Vector3.new(0.343, -legY, 0), LeftLeg = Vector3.new(-0.343, -legY, 0)}
			local function put(name, id, size, col, pos)
				local mp = UI.opt.skin and id and newMesh(id, size) or nil
				if not mp then mp = new("Part", {Size = size, Color = col, Material = Enum.Material.SmoothPlastic}, nil) end
				mp.Name, mp.Anchored, mp.CFrame = name, true, CFrame.new(pos)
				mp.Parent = model
			end
			for _, key in ipairs(ORDER) do
				local m = MESH[key]
				put("Inv" .. key, m[1], m[2], m[3], POS[key])
				if UI.opt.skin and UI.opt.layer2 then put("InvLayer" .. key, m[6], m[7], m[3], POS[key]) end
			end
			model:PivotTo(CFrame.Angles(0, math.rad(-25), 0))        -- turned a little, like the Minecraft inventory
		end)
	end

	function UI.buildArmMesh()                       -- the 3D arm on your screen wears the skin too
		if not UI.opt.skin then UI.buildArm() return end
		task.spawn(function()
			local p = newMesh(6814397494, Vector3.new(0.7, 2, 0.55))
			if p then UI.buildArm(p) else UI.buildArm() end
		end)
	end

	function UI.setSkin(text)                        -- a skin image id / link typed in the settings
		local num = tostring(text or ""):match("%d+")
		if not num then return false end
		local url = "rbxassetid://" .. num
		task.spawn(function()
			pcall(function()                         -- a Decal id is not an Image id: ask Roblox for the real image
				local o = game:GetObjects(url)[1]
				if o then
					if (o:IsA("Decal") or o:IsA("Texture")) and o.Texture ~= "" then url = o.Texture end
					o:Destroy()
				end
			end)
			UI.skinId = url
			UI.buildSteve()
			UI.buildArmMesh()
		end)
		return true
	end

	on(player.CharacterAdded, function() task.wait(1.2) UI.buildSteve() end)
	UI.buildSteve()
	UI.buildArmMesh()
end

--====================================================================
-- HEAD LOOK: your head turns and tilts to where the camera looks (only on your screen)
--====================================================================
do
	local motor, torsoPart, c0
	local pitch, yaw = 0, 0
	local function find()
		local ch = player.Character
		if not ch then motor = nil return end
		if motor and motor.Parent and motor:IsDescendantOf(ch) then return end
		motor, torsoPart, c0 = nil, nil, nil
		local m = ch:FindFirstChild("Neck", true)
		if not (m and m:IsA("Motor6D")) then              -- another name: the joint that holds the head
			m = nil
			for _, o in ipairs(ch:GetDescendants()) do
				if o:IsA("Motor6D") and o.Part1 and o.Part1.Name == "Head" then m = o break end
			end
		end
		if m and m.Part0 then
			motor, torsoPart, c0 = m, m.Part0, m.C0
			print("Head look: neck found (" .. m.Name .. ", " .. m.Part0.Name .. " -> Head)")
		else
			if UI.neckWarned ~= ch then UI.neckWarned = ch print("Head look: NO neck joint found") end
		end
	end
	function UI.headApply()
		if motor and motor.Parent and c0 then
			motor.C0 = CFrame.new(c0.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * (c0 - c0.Position)
		end
		local sn = UI.steveNeck                                      -- the Steve head's own neck
		if sn and sn.Parent and sn.Part0 then
			sn.C0 = (UI.leanL or CFrame.identity) * CFrame.new(0, sn.Part0.Size.Y / 2, 0) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		end
	end
	on(RS.Heartbeat, function() UI.headApply() end)         -- (set again after the animations ran, so nothing can undo it)
	function UI.resetHead()
		if motor and motor.Parent and c0 then motor.C0 = c0 end
	end
	on(RS.RenderStepped, function(dt)
		find()
		local sn = UI.steveNeck
		local tpart = torsoPart or (sn and sn.Part0)
		if (not motor and not (sn and sn.Parent)) or not tpart then return end
		local look = UI.look()
		local root = getRoot()
		local hum = MV.hum
		if root and hum and hum.MoveDirection.Magnitude < 0.1 and not hum.Sit then   -- standing still: the body turns after the camera, like Minecraft
			local rl = root.CFrame:VectorToObjectSpace(look)
			local rel = math.atan2(-rl.X, -rl.Z)
			local LIMIT = math.rad(45)
			if math.abs(rel) > LIMIT then
				local dy = (math.abs(rel) - LIMIT) * (rel > 0 and 1 or -1) * math.min(1, dt * 10)
				root.CFrame = root.CFrame * CFrame.Angles(0, dy, 0)
			end
		end
		local lv = tpart.CFrame:VectorToObjectSpace(look)              -- the camera direction as seen from your body
		local ty = math.clamp(math.atan2(-lv.X, -lv.Z), -math.rad(80), math.rad(80))
		local tp = math.clamp(math.asin(math.clamp(lv.Y, -1, 1)), -math.rad(70), math.rad(70))
		local a = math.min(1, dt * 18)
		yaw += (ty - yaw) * a
		pitch += (tp - pitch) * a
		UI.headApply()
	end)
end

--====================================================================
-- STEVE POSE: sneaking leans your body forward and the right arm swings (R6 + R15).
-- It moves the welds that hold the Steve model, so it does not depend on the rig's own joints.
--====================================================================
do
	local lean = 0
	UI.swingA, UI.leanL, UI.holdA = 0, CFrame.identity, 0     -- holdA = how far the right arm is raised while you hold something
	local function apply()
		local list, torso = UI.poseParts, UI.steveTorso
		if not list or #list == 0 or not torso or not torso.Parent then return end
		local hipP = CFrame.new(0, -torso.Size.Y / 2, 0)
		local L = hipP * CFrame.Angles(-lean, 0, 0) * hipP:Inverse()            -- lean forward around the hips, in the torso's space
		UI.leanL = L
		local tcf = torso.CFrame
		local lw = tcf * L * tcf:Inverse()                                       -- the same lean in world space
		for _, p in ipairs(list) do
			if p.weld.Parent and p.host.Parent then
				local hcf = p.host.CFrame
				if p.key == "RightLeg" or p.key == "LeftLeg" then
					p.weld.C0 = p.rel                                            -- legs stay under you
				else
					local S = CFrame.identity
					if p.key == "RightArm" and (UI.swingA ~= 0 or UI.holdA > 0.01) then   -- raise the arm (holding) + swing it forward around the shoulder
						local hy = p.host.Size.Y / 2
						S = CFrame.new(0, hy, 0) * CFrame.Angles(UI.swingA + UI.holdA, 0, 0) * CFrame.new(0, -hy, 0)
					end
					p.weld.C0 = hcf:ToObjectSpace(lw * hcf * S * p.rel)
				end
			end
		end
	end
	on(RS.RenderStepped, function(dt)
		local sneaking = (MV.sneakHeld or MV.sneakTog) and not UI.flying
		lean += ((sneaking and 0.42 or 0) - lean) * math.min(1, dt * 10)
		local st = inv[35 + selected]
		local hd = st and BY_NAME[st.name]
		UI.holdA += (((hd and UI.persp ~= 0) and (hd.IsBlock and 0.35 or 0.55) or 0) - UI.holdA) * math.min(1, dt * 12)
		apply()
	end)
	on(RS.Heartbeat, apply)
end

