-- an icon = 3D item (tools / food / armor) or 3D cube (blocks); the flat picture is not used any more
local function mkIcon(parent, z, sideView)
	local ico = new("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ResampleMode = Enum.ResamplerMode.Pixelated, ZIndex = z}, parent)
	local vf = new("ViewportFrame", {Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0), BackgroundTransparency = 1,
		Visible = false, ZIndex = z, Ambient = C(170, 170, 170), LightColor = WHITE, LightDirection = Vector3.new(-0.6, -1, -0.4)}, parent)
	if sideView == "held" then vf:SetAttribute("hv", true) elseif sideView then vf:SetAttribute("sv", true) end
	local depth
	if sideView == "held" then                          -- the thickness of a tool: dark copies of the picture stacked behind it (like Minecraft's extruded items)
		depth = {}
		for k = 3, 1, -1 do
			depth[#depth + 1] = new("ImageLabel", {Size = UDim2.fromScale(1, 1), Position = UDim2.new(0, k, 0, k), BackgroundTransparency = 1,
				ImageColor3 = Color3.new(0.16, 0.18, 0.2), ResampleMode = Enum.ResamplerMode.Pixelated, ZIndex = math.max(1, z - 1)}, parent)
		end
	end
	return {ico = ico, vf = vf, depth = depth}
end

local function setIcon(o, d)
	local flat = d and UI.FLAT_ICONS and not o.vf:GetAttribute("hv") and UI.flatImage(d)   -- slots / rows: the flat 2D front picture
	o.ico.ImageColor3 = (flat and d.Tint) or WHITE
	if flat then
		o.vf.Visible = false
		o.ico.Image = flat
	elseif d and d.IsBlock then
		o.ico.Image = ""
		o.vf.Visible = true
		fillCube(o.vf, d)
	elseif d then
		o.ico.Image = ""
		o.vf.Visible = true
		UI.fillItem3D(o.vf, d)                           -- tools / food / armor / everything else: real 3D
	else
		o.vf.Visible = false
		o.ico.Image = ""
	end
	if o.depth then
