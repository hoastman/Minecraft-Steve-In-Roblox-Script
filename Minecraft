-- Your Animation IDs (Idle, Walk, Run, and Jump)
local ANIMATIONS = {
	idle = "rbxassetid://116535001531324",
	walk = "rbxassetid://107311699859715",
	run  = "rbxassetid://86183312829169",
	jump = "rbxassetid://86183312829169", -- Using your run ID for jump (you can change this to any ID)
	fall = "rbxassetid://116535001531324", -- Using your idle ID for fall as a fallback
}

local function applyAnimations(character)
	local hum = character:WaitForChild("Humanoid", 5)
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end   -- these animations are R15 only: R6 keeps its normal ones
	local animateScript = character:WaitForChild("Animate", 5)
	if not animateScript then return end

	for animName, animId in pairs(ANIMATIONS) do
		local folder = animateScript:FindFirstChild(animName)
		if folder then
			for _, child in ipairs(folder:GetChildren()) do
				if child:IsA("Animation") then
					child.AnimationId = animId
				end
			end
		end
	end

	-- Restart the Animate script to force it to load the new IDs
	animateScript.Enabled = false
	task.wait(0.1)
	animateScript.Enabled = true
	print("Custom Idle, Walk, Run, and Jump Animations Loaded!")
end

if LocalPlayer.Character then
	applyAnimations(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(applyAnimations)

local function get(t, k)
	local v = t[k] or t[k:lower()]
	if type(v) == "number" then v = tostring(v) end
	if type(v) == "string" and v ~= "" then
		if v:match("^%d+$") then v = "rbxassetid://" .. v end   -- plain numbers work now
		return v
	end
end

local function expand(t)
	if type(t) == "string" then t = {All = t} end
	local all = get(t, "All")
	local side = get(t, "Side") or all
	local ends = get(t, "TopBottom") or get(t, "Ends") or all
	return {
		Top = get(t, "Top") or ends, Bottom = get(t, "Bottom") or ends,
		Left = get(t, "Left") or side, Right = get(t, "Right") or side,
		Front = get(t, "Front") or side, Back = get(t, "Back") or side,
	}
end

local function register(d)
	d.Color = d.Color or C(163, 162, 165)
	local old = BY_NAME[d.Name]
	if old and old.Tab ~= d.Tab then
		d.Dup = true                      -- the same block listed in ANOTHER tab: it shows in that tab, but Search shows it only once
	else
		if old then                       -- the same block redefined in the same tab = it replaces the old one
			for i, x in ipairs(ITEMS) do
				if x == old then table.remove(ITEMS, i) break end
			end
		end
		BY_NAME[d.Name] = d
	end
	ITEMS[#ITEMS + 1] = d
end
local function Block(d)
	if type(d.Texture) == "table" then                  -- door pictures: top half + bottom half of the front
		d.DoorTop = get(d, "DoorTop") or get(d.Texture, "DoorTop") or get(d.Texture, "FrontTop")
		d.DoorBottom = get(d, "DoorBottom") or get(d.Texture, "DoorBottom") or get(d.Texture, "FrontBottom")
	else
		d.DoorTop, d.DoorBottom = get(d, "DoorTop"), get(d, "DoorBottom")
	end
	d.Texture, d.IsBlock = expand(d.Texture or {}), true
	register(d)
end
local function Item(d)
	local f = get(d, "Front")
	if f then d.Icon = d.Icon or f end
	if d.Texture then d.Texture = expand(d.Texture) end
	register(d)
end

