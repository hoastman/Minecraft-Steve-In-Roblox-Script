do
	local track = new("Frame", {Position = UDim2.fromOffset(340, 37), Size = UDim2.fromOffset(26, 222), BackgroundColor3 = C(139, 139, 139),
		BorderSizePixel = 0, ZIndex = 5, Active = true}, itemView)
	bevel(track, C(55, 55, 55), WHITE, 3)
	local inner = new("Frame", {Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), BackgroundTransparency = 1, ZIndex = 5}, track)
	local grip = new("Frame", {Size = UDim2.new(1, 0, 0.2, 0), BackgroundColor3 = C(198, 198, 198), BorderSizePixel = 0, ZIndex = 6}, inner)
	bevel(grip, WHITE, C(85, 85, 85), 2)
	for k = -1, 1 do
		new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, k * 5), Size = UDim2.new(1, -10, 0, 2),
			BackgroundColor3 = C(85, 85, 85), BorderSizePixel = 0, ZIndex = 7}, grip)
	end
	local function syncGrip()
		local canvas, view = math.max(1, grid.AbsoluteCanvasSize.Y), math.max(1, grid.AbsoluteWindowSize.Y)
		local h = math.clamp(view / canvas, 0.12, 1)
		local frac = math.clamp(grid.CanvasPosition.Y / math.max(1, canvas - view), 0, 1)
		grip.Size = UDim2.new(1, 0, h, 0)
		grip.Position = UDim2.new(0, 0, (1 - h) * frac, 0)
		grip.Visible = canvas > view + 1
	end
	on(grid:GetPropertyChangedSignal("CanvasPosition"), syncGrip)
	on(grid:GetPropertyChangedSignal("AbsoluteCanvasSize"), syncGrip)
	on(grid:GetPropertyChangedSignal("AbsoluteWindowSize"), syncGrip)
	local dragging = false
	local function dragTo(y)
		local canvas, view = grid.AbsoluteCanvasSize.Y, grid.AbsoluteWindowSize.Y
		local gh = grip.AbsoluteSize.Y
		local frac = math.clamp((y - inner.AbsolutePosition.Y - gh / 2) / math.max(1, inner.AbsoluteSize.Y - gh), 0, 1)
		grid.CanvasPosition = Vector2.new(0, frac * math.max(0, canvas - view))
	end
	local function isTap(i) return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 end
	on(track.InputBegan, function(i) if isTap(i) then dragging = true dragTo(i.Position.Y) end end)
	on(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then dragTo(i.Position.Y) end
	end)
	on(UIS.InputEnded, function(i) if isTap(i) then dragging = false end end)
	syncGrip()
end

