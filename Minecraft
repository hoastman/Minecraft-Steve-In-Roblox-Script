local function findItem(name)
	name = name:lower():gsub("_", " ")                  -- Oak_Planks = Oak Planks
	if name:match("^%s*$") then return end
	for _, d in ipairs(ITEMS) do if d.Name:lower() == name then return d end end
	for _, d in ipairs(ITEMS) do if d.Name:lower():find(name, 1, true) == 1 then return d end end
end

