-- 2px pixel bevel: top/left = tl, bottom/right = br
local function bevel(parent, tl, br, w)
	local function b(c, s, p)
		new("Frame", {BackgroundColor3 = c, BorderSizePixel = 0, Size = s, Position = p, ZIndex = parent.ZIndex}, parent)
	end
	b(tl, UDim2.new(1, -w, 0, w), UDim2.new(0, 0, 0, 0))
	b(tl, UDim2.new(0, w, 1, -w), UDim2.new(0, 0, 0, 0))
	b(br, UDim2.new(0, w, 1, -w), UDim2.new(1, -w, 0, w))
	b(br, UDim2.new(1, -w, 0, w), UDim2.new(0, w, 1, -w))
end

