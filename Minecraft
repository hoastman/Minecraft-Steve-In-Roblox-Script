	function UI.furnUpdate(st)
		arrowClip.Size = UDim2.fromOffset(math.floor(30 * math.clamp(st.cook / COOK, 0, 1) + 0.5), 18)
		local h = st.burn > 0 and math.ceil(14 * math.clamp(st.burn / st.burnMax, 0, 1)) or 0
		flameClip.Position = UDim2.fromOffset(115, 73 + 14 - h)
		flameClip.Size = UDim2.fromOffset(14, h)
		flameIn.Position = UDim2.fromOffset(0, h - 14)
	end

	-- while a furnace screen is open its 3 slots live in inv[83..85]; otherwise in st.s[1..3]
	local function fget(st, k) if st.open then return inv[82 + k] end return st.s[k] end
	local function fset(st, k, v)
		if st.open then inv[82 + k] = v render(82 + k) else st.s[k] = v end
	end
	local function touch(st, k) if st.open then render(82 + k) end end

	local function tick(st, dt)
		dt = math.min(dt, 0.25)
		local inp, fuel, out = fget(st, 1), fget(st, 2), fget(st, 3)
		local res = inp and SMELT[inp.name]
		local can = res and (not out or (out.name == res and out.count < cap(res)))
		if st.burn <= 0 and can and fuel and FUEL[fuel.name] then       -- light a new piece of fuel
			st.burn, st.burnMax = FUEL[fuel.name], FUEL[fuel.name]
			fuel.count -= 1
			if fuel.count <= 0 then fset(st, 2, nil) else touch(st, 2) end
		end
		if st.burn > 0 then
			st.burn = math.max(0, st.burn - dt)
			if can then
				st.cook += dt
				if st.cook >= COOK then
					st.cook = 0
					inp.count -= 1
					if inp.count <= 0 then fset(st, 1, nil) else touch(st, 1) end
					if out then out.count += 1 touch(st, 3) else fset(st, 3, {name = res, count = 1}) end
				end
			else
				st.cook = math.max(0, st.cook - dt * 2)
			end
		else
			st.cook = math.max(0, st.cook - dt * 2)
		end
	end

	on(RS.Heartbeat, function(dt)
		for i = #FURN, 1, -1 do
			local st = FURN[i]
			if not st.part.Parent then table.remove(FURN, i) else tick(st, dt) end
		end
		local xs = UI.xst
		if xs then
			if xs.kind == "Furnace" then UI.furnUpdate(xs) end
			local r = getRoot()
			if not xs.part.Parent or (r and (r.Position - xs.part.Position).Magnitude > 30) then UI.closeContainer() end   -- walked away
		end
	end)

	function UI.openContainer(part, kind)
		UI.closeContainer()
		UI.setPanel(false)
		UI.setCraft(false)
		UI.setMenu(false)
		local st = CT[part]
		if not st then
			st = {kind = kind, s = {}, burn = 0, burnMax = 1, cook = 0, part = part}
			CT[part] = st
			if kind == "Furnace" then FURN[#FURN + 1] = st end
		end
		if kind == "Chest" then
			for k = 1, 27 do inv[55 + k] = st.s[k] render(55 + k) end
			chestWin.Visible = true
		else
			for k = 1, 3 do inv[82 + k] = st.s[k] render(82 + k) end
			furnWin.Visible = true
			UI.furnUpdate(st)
		end
		st.open, UI.xst = true, st
		stopBreak()
		UI.sync()
	end

	function UI.closeContainer()
		local st = UI.xst
		if not st then return end
		if cursor then give(cursor.name, cursor.count) cursor = nil renderCursor() end
		if st.kind == "Chest" then
			for k = 1, 27 do st.s[k] = inv[55 + k] inv[55 + k] = nil render(55 + k) end
		else
			for k = 1, 3 do st.s[k] = inv[82 + k] inv[82 + k] = nil render(82 + k) end
		end
		st.open, UI.xst = false, nil
		chestWin.Visible, furnWin.Visible = false, false
		stopBreak()
		UI.sync()
	end
end

