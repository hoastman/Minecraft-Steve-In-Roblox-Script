		if ic then
			ic = normImg(ic)
			local N, T = 7, 0.03
			for l = 1, N do
				local sl = new("Part", {Size = Vector3.new(1.15, 1.15, T), CFrame = CFrame.new(0, 0, (l - (N + 1) / 2) * T), Anchored = true, Transparency = 1}, vf)
