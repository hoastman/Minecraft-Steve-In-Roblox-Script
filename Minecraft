-- creative list order (like Minecraft):  Oak Planks, Oak Planks Slab, Oak Planks Stairs, Oak Planks Trapdoor, Oak Fence, Oak Fence Gate
do
	local rank = {Slab = 1, Stairs = 2, Trapdoor = 3, Fence = 4, FenceGate = 5}
	local variants, rest = {}, {}
	for _, d in ipairs(ITEMS) do
		if d.Base and BY_NAME[d.Base] and rank[d.Shape] then
			variants[d.Base] = variants[d.Base] or {}
			table.insert(variants[d.Base], d)
		else
			rest[#rest + 1] = d
		end
	end
	for _, list in pairs(variants) do table.sort(list, function(a, b) return rank[a.Shape] < rank[b.Shape] end) end
	table.clear(ITEMS)
	for _, d in ipairs(rest) do
		ITEMS[#ITEMS + 1] = d
		for _, v in ipairs(variants[d.Name] or {}) do ITEMS[#ITEMS + 1] = v end
	end
end

-- how a block is turned when placed
local function blockCFrame(pos, def, n, r)
	if def.Pillar and n then                         -- logs: top follows the face you clicked
		local x = (math.abs(n.Y) > 0.5) and Vector3.xAxis or Vector3.yAxis:Cross(n)
		return CFrame.fromMatrix(pos, x, n, x:Cross(n))
	end
	if def.Facing then                                -- furnace / chest: the Front face looks back at you
		return CFrame.lookAt(pos, pos - UI.axis())
	end
	return CFrame.new(pos)                           -- every other block: fixed, never turns to the camera
end

-- slab = 1 flat box, stairs = 2 boxes (a Model). Textures are TILED so the half-height sides are cropped, not squashed.
-- cf = centre of the block's cell. flip = upside-down (top half). Stairs go up toward local +Z.
local function buildShape(d, S, cf, parent, flip, corner)
	local h = S / 2
	local function box(size, off, name, par)
		local plain = d.Shape == "Door" or d.Shape == "Fence" or d.Shape == "FenceGate" or d.Shape == "Carpet" or d.Shape == "Trapdoor"      -- plain material: no Roblox wood grain under the texture
		if d.Shape == "Door" and not (parent and parent:IsA("ViewportFrame")) then
			-- the door itself is invisible (Transparency 1) and its picture sits on SurfaceGuis, so empty pixels (windows) are really see-through
			local dp = new("Part", {Name = name, Size = size, CFrame = cf * CFrame.new(off), Anchored = true, Color = d.Color,
				Material = Enum.Material.SmoothPlastic, Transparency = 1, TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, nil)
			local faces = {}
			for face, id in pairs(d.Texture) do faces[face] = id end
			if d.DoorTop or d.DoorBottom then
				faces.Front = faces.Front or d.DoorTop or d.DoorBottom
				faces.Back = faces.Back or faces.Front
			end
			for face, id in pairs(faces) do
				local big = face == "Front" or face == "Back"
				local sg = new("SurfaceGui", {Face = FACE[face], SizingMode = Enum.SurfaceGuiSizingMode.FixedSize, LightInfluence = 0,
					CanvasSize = big and Vector2.new(128, 256) or ((face == "Top" or face == "Bottom") and Vector2.new(128, 32) or Vector2.new(32, 256))}, dp)
				if big and (d.DoorTop or d.DoorBottom) then          -- two pictures: the top half and the bottom half of the door
					for k = 1, 2 do
						new("ImageLabel", {Size = UDim2.fromScale(1, 0.5), Position = UDim2.fromScale(0, k == 1 and 0 or 0.5), BackgroundTransparency = 1,
							Image = (k == 1 and d.DoorTop or d.DoorBottom) or id, ImageColor3 = d.Tint or WHITE, ResampleMode = Enum.ResamplerMode.Pixelated}, sg)
					end
				else
					new("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = id, ImageColor3 = d.Tint or WHITE,
						ResampleMode = Enum.ResamplerMode.Pixelated}, sg)
				end
			end
			if next(faces) == nil then                        -- no picture given (Iron Door): a metal door with window panes and a handle, drawn here
				dp.Transparency, dp.Material = 0, d.Material or Enum.Material.Metal
				for _, nrm in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
					local sg = new("SurfaceGui", {Face = nrm, SizingMode = Enum.SurfaceGuiSizingMode.FixedSize, CanvasSize = Vector2.new(128, 256), LightInfluence = 0}, dp)
					local function fr(x, y, w, h, col) new("Frame", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = col, BorderSizePixel = 0}, sg) end
					local edge, mid, glass = C(140, 142, 150), C(188, 190, 196), C(70, 82, 100)
					fr(0, 0, 128, 8, edge) fr(0, 248, 128, 8, edge) fr(0, 0, 8, 256, edge) fr(120, 0, 8, 256, edge)      -- frame
					fr(8, 124, 112, 6, edge)                                                                              -- middle bar
					for _, p in ipairs({{20, 24}, {70, 24}, {20, 66}, {70, 66}}) do fr(p[1], p[2], 38, 34, glass) end    -- 4 window panes
					fr(20, 150, 88, 90, mid) fr(24, 154, 80, 82, d.Color)                                                -- lower panel
					fr(100, 118, 12, 18, edge)                                                                            -- handle
				end
			end
			dp.Parent = par
			return dp
		end
		if d.Shape == "Door" and (d.DoorTop or d.DoorBottom) then     -- icon of a door with two pictures: two stacked halves
			local dm = new("Model", {Name = name}, nil)
			for k = 1, 2 do
				local hp = new("Part", {Name = name, Size = Vector3.new(size.X, size.Y / 2, size.Z), Anchored = true, Color = d.Color,
					CFrame = cf * CFrame.new(off + Vector3.new(0, k == 1 and size.Y / 4 or -size.Y / 4, 0)), Material = Enum.Material.SmoothPlastic}, dm)
				local img = (k == 1 and d.DoorTop or d.DoorBottom) or d.Texture.Front
				for face, id in pairs(d.Texture) do
					new("Texture", {Texture = (face == "Front" or face == "Back") and img or id, Face = FACE[face], StudsPerTileU = S, StudsPerTileV = S,
						Color3 = d.Tint or WHITE}, hp)
				end
			end
			dm.Parent = par
			return dm
		end
		local p = new("Part", {Name = name, Size = size, CFrame = cf * CFrame.new(off), Anchored = true, Color = d.Color,
			Material = plain and Enum.Material.SmoothPlastic or d.Material or Enum.Material.SmoothPlastic, Transparency = d.Clear and 1 or d.Transparency or 0,
			TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, nil)
		for face, id in pairs(d.Texture) do
			new("Texture", {Texture = id, Face = FACE[face], StudsPerTileU = S, StudsPerTileV = (d.Shape == "Door" and (face == "Front" or face == "Back")) and S * 2 or S,
				Color3 = d.Tint or WHITE, Transparency = d.Clear and 0.2 or 0}, p)
		end
		p.Parent = par
		return p
	end
	local y = flip and h / 2 or -h / 2
	if d.Shape == "Door" then                         -- 2 blocks tall thin panel, flush with the FRONT edge of the block (toward you)
		return box(Vector3.new(S, S * 2, S * 0.18), Vector3.new(0, S / 2, -S / 2 + S * 0.09), "Door", parent)
	end
	if d.Shape == "Carpet" then                       -- a very thin layer lying on the floor of the cell (1/16 of a block)
		return box(Vector3.new(S, S / 16, S), Vector3.new(0, -S / 2 + S / 32, 0), "Carpet", parent)
	end
	if d.Shape == "Trapdoor" then                     -- a thin panel (3/16 of a block) in the lower or upper part of the cell
		local T = S * 0.1875
		return box(Vector3.new(S, T, S), Vector3.new(0, flip and (S / 2 - T / 2) or (-S / 2 + T / 2), 0), "Trapdoor", parent)
	end
	if d.Shape == "Piston" then                       -- body (3/4 block, the back) + head plate (1/4 block) at the FRONT (-Z of cf). corner == true: arm out
		local m = new("Model", {Name = "Piston"}, nil)
		local ext = corner == true
		local function pp(name, size, z, color, mat, tr)
			return new("Part", {Name = name, Size = size, CFrame = cf * CFrame.new(0, 0, z), Anchored = true, Color = color,
				Material = mat or Enum.Material.SmoothPlastic, Transparency = tr or 0, TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, m)
		end
		pp("Body", Vector3.new(S, S, S * 0.75), S / 8, C(128, 128, 128), Enum.Material.Slate)
		pp("Head", Vector3.new(S, S, S * 0.25), ext and (-1.375 * S) or (-0.375 * S), d.Sticky and C(120, 190, 70) or C(190, 145, 80),
			d.Sticky and Enum.Material.SmoothPlastic or Enum.Material.Wood)
		local rod = pp("Rod", Vector3.new(S * 0.25, S * 0.25, S), -0.75 * S, C(190, 145, 80), Enum.Material.Wood, ext and 0 or 1)
		rod.CanCollide, rod.CanQuery, rod.CanTouch = ext, ext, ext
		m.WorldPivot = cf
		m.Parent = parent
		return m
	end
	local u = S / 16                                  -- one "pixel" of a 16x16 block
	local zc = 0                                      -- fence / gate: in the MIDDLE of the block
	if d.Shape == "Fence" then                        -- a post in the middle + two rails toward every fence / solid block next to it (like Minecraft)
		local m = new("Model", {Name = "Fence"}, nil)
		local conn = corner or {px = true, nx = true}   -- (icons: show the rails left and right)
		box(Vector3.new(4 * u, S, 4 * u), Vector3.new(0, 0, zc), "Post", m)
		local dark = Color3.new(d.Color.R * 0.6, d.Color.G * 0.6, d.Color.B * 0.6)
		for _, ry in ipairs({-0.5 * u, 5.5 * u}) do
			new("Part", {Name = "Band", Size = Vector3.new(4.3 * u, 3 * u, 4.3 * u), CFrame = cf * CFrame.new(0, ry, zc), Anchored = true, Color = dark,   -- dark band where the rails join the post
				Material = Enum.Material.SmoothPlastic, TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, m)
			if conn.px then box(Vector3.new(6 * u, 3 * u, 2 * u), Vector3.new(5 * u, ry, zc), "Rail", m) end
			if conn.nx then box(Vector3.new(6 * u, 3 * u, 2 * u), Vector3.new(-5 * u, ry, zc), "Rail", m) end
			if conn.pz then box(Vector3.new(2 * u, 3 * u, 6 * u), Vector3.new(0, ry, 5 * u + zc), "Rail", m) end
			if conn.nz then box(Vector3.new(2 * u, 3 * u, 6 * u), Vector3.new(0, ry, -5 * u + zc), "Rail", m) end
		end
		m.WorldPivot = cf
		m.Parent = parent
		return m
	end
	if d.Shape == "FenceGate" then                    -- two posts + two leaves; right-click turns each leaf 90 degrees around its post
		local m = new("Model", {Name = "FenceGate"}, nil)
		for _, side in ipairs({-1, 1}) do
			box(Vector3.new(2 * u, 11 * u, 4 * u), Vector3.new(side * 7 * u, 2.5 * u, zc), "Post", m)
			local half = new("Model", {Name = side < 0 and "HalfL" or "HalfR"}, nil)
			for _, ry in ipairs({-0.5 * u, 5.5 * u}) do
				box(Vector3.new(6 * u, 3 * u, 2 * u), Vector3.new(side * 3 * u, ry, zc), "Rail", half)
			end
			box(Vector3.new(2 * u, 9 * u, 2 * u), Vector3.new(side * u, 2.5 * u, zc), "Stile", half)
			half.WorldPivot = cf * CFrame.new(side * 7 * u, 0, zc)
			half.Parent = m
		end
		m.WorldPivot = cf
		m.Parent = parent
		return m
	end
	if d.Shape == "Slab" then
		return box(Vector3.new(S, h, S), Vector3.new(0, y, 0), "Slab", parent)
	end
	local m = new("Model", {Name = "Stairs"}, nil)
	box(Vector3.new(S, h, S), Vector3.new(0, y, 0), "Base", m)
	if corner and corner.kind == "outer" then          -- outer corner: only a quarter of the top is high
		box(Vector3.new(h, h, h), Vector3.new(corner.side * h / 2, -y, h / 2), "Step", m)
	else
		box(Vector3.new(S, h, h), Vector3.new(0, -y, h / 2), "Step", m)
		if corner and corner.kind == "inner" then      -- inner corner: an extra quarter makes the L shape
			box(Vector3.new(h, h, h), Vector3.new(corner.side * h / 2, -y, -h / 2), "Step2", m)
		end
	end
	m.WorldPivot = cf
	m.Parent = parent
	return m
end

-- the block (Part or stairs Model) that a hit part belongs to; nil if it is not one of our blocks
local function blockRoot(inst)
	while inst and inst.Parent do
		if inst.Parent == folder then return inst end
		inst = inst.Parent
	end
end

-- STAIR CORNERS (same rules as Minecraft): a stair next to a stair that faces sideways turns into an inner / outer corner.
function UI.rootAt(pos)                                 -- the block that sits in this grid cell
	for _, c in ipairs(folder:GetChildren()) do
		local cell = c:GetAttribute("Cell")
		if cell and (cell - pos).Magnitude < 0.5 then return c end
		local hc = c:GetAttribute("HeadCell")                 -- the head of an extended piston is in this cell
		if hc and (hc - pos).Magnitude < 0.5 then return c end
	end
end
local function stairFacing(p, flip)                      -- the facing of a stair in cell p (same half), or nil
	local r = UI.rootAt(p)
	local d = r and BY_NAME[r:GetAttribute("BlockType") or ""]
	if d and d.Shape == "Stairs" and (r:GetAttribute("Flip") and true or false) == flip then return r:GetAttribute("Face") or Vector3.zAxis end
end
local function perp(a, b) return math.abs(a:Dot(b)) < 0.1 end
function UI.stairCorner(pos, face, flip)
	flip = flip and true or false
	local right = CFrame.lookAt(pos, pos - face).RightVector
	local back = stairFacing(pos + face * BLOCK, flip)             -- the stair behind (on the high side)
	if back and perp(back, face) then
		local o = stairFacing(pos - back * BLOCK, flip)
		if not (o and (o - face).Magnitude < 0.1) then return {kind = "outer", side = back:Dot(right) > 0 and 1 or -1} end
	end
	local front = stairFacing(pos - face * BLOCK, flip)            -- the stair in front (low side)
	if front and perp(front, face) then
		local o = stairFacing(pos + front * BLOCK, flip)
		if not (o and (o - face).Magnitude < 0.1) then return {kind = "inner", side = front:Dot(right) > 0 and 1 or -1} end
	end
end
local function cornerKey(c) return c and (c.kind .. c.side) or "" end
function UI.refreshStairs(pos, except)                  -- stairs next to this cell may change shape
	for _, off in ipairs({Vector3.new(BLOCK, 0, 0), Vector3.new(-BLOCK, 0, 0), Vector3.new(0, 0, BLOCK), Vector3.new(0, 0, -BLOCK)}) do
		local r = UI.rootAt(pos + off)
		local d = r and r ~= except and BY_NAME[r:GetAttribute("BlockType") or ""]
		if d and d.Shape == "Stairs" then
			local cell, face, flip = r:GetAttribute("Cell"), r:GetAttribute("Face") or Vector3.zAxis, r:GetAttribute("Flip") and true or false
			local c = UI.stairCorner(cell, face, flip)
			if cornerKey(c) ~= (r:GetAttribute("Corner") or "") then
				local nr = buildShape(d, BLOCK, CFrame.lookAt(cell, cell - face), folder, flip, c)
				nr:SetAttribute("BlockType", d.Name) nr:SetAttribute("Cell", cell) nr:SetAttribute("Flip", flip)
				nr:SetAttribute("Face", face) nr:SetAttribute("Corner", cornerKey(c))
				r:Destroy()
			end
		end
	end
end

UI.fenceDirs = {px = Vector3.new(BLOCK, 0, 0), nx = Vector3.new(-BLOCK, 0, 0), pz = Vector3.new(0, 0, BLOCK), nz = Vector3.new(0, 0, -BLOCK)}
function UI.fenceConn(pos)                              -- which sides touch another fence, a fence gate (in line with it) or a solid block
	local conn = {}
	for k, off in pairs(UI.fenceDirs) do
		local r = UI.rootAt(pos + off)
		local d = r and BY_NAME[r:GetAttribute("BlockType") or ""]
		if d then
			if d.Shape == "Fence" then
				conn[k] = true
			elseif d.Shape == "FenceGate" then
				local right = CFrame.lookAt(Vector3.zero, -(r:GetAttribute("Face") or Vector3.zAxis)).RightVector
				if math.abs(right:Dot(off.Unit)) > 0.9 then conn[k] = true end
			elseif d.IsBlock and not d.Shape and not d.Liquid and not d.Clear and (d.Transparency or 0) == 0 then
				conn[k] = true
			end
		end
	end
	return conn
end
function UI.connKey(c) return (c.px and 1 or 0) .. (c.nx and 1 or 0) .. (c.pz and 1 or 0) .. (c.nz and 1 or 0) end
function UI.refreshFences(pos, except)                  -- fences next to this cell grow / lose rails
	if not UI.hasFence then return end
	for _, off in pairs(UI.fenceDirs) do
		local r = UI.rootAt(pos + off)
		local d = r and r ~= except and BY_NAME[r:GetAttribute("BlockType") or ""]
		if d and d.Shape == "Fence" then
			local cell = r:GetAttribute("Cell")
			local c = UI.fenceConn(cell)
			if UI.connKey(c) ~= (r:GetAttribute("Conn") or "") then
				local nr = buildShape(d, BLOCK, CFrame.new(cell), folder, false, c)
				nr:SetAttribute("BlockType", d.Name) nr:SetAttribute("Cell", cell) nr:SetAttribute("Flip", false) nr:SetAttribute("Conn", UI.connKey(c))
				r:Destroy()
			end
		end
	end
end

local function makeBlock(pos, def, n, r, flip, face)
	local root
	local corner
	if def.Shape then
		local cf = (face and def.Shape ~= "Fence") and CFrame.lookAt(pos, pos - face, (def.Shape == "Piston" and math.abs(face.Y) > 0.9) and Vector3.zAxis or Vector3.yAxis) or CFrame.new(pos)
		if def.Shape == "Stairs" then corner = UI.stairCorner(pos, face or Vector3.zAxis, flip) end
		if def.Shape == "Fence" then UI.hasFence = true corner = UI.fenceConn(pos) end
		root = buildShape(def, BLOCK, cf, folder, flip, corner)
	else
		root = new("Part", {Size = Vector3.new(BLOCK, BLOCK, BLOCK), CFrame = blockCFrame(pos, def, n, r), Anchored = true,
			Color = def.Color, Material = def.Material or Enum.Material.SmoothPlastic, Transparency = def.Clear and 1 or def.Transparency or 0,
			TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, folder)
		for f, id in pairs(def.Texture) do
			new("Decal", {Texture = id, Face = FACE[f], Color3 = def.Tint or WHITE, Transparency = def.Clear and 0.2 or 0}, root)
		end
	end
	root:SetAttribute("BlockType", def.Name)
	root:SetAttribute("Cell", pos)                 -- the grid cell it sits in (slabs only fill half of it)
	root:SetAttribute("Flip", flip and true or false)
	if def.Shape == "Stairs" then
		root:SetAttribute("Face", face or Vector3.zAxis)
		root:SetAttribute("Corner", cornerKey(corner))
		UI.refreshStairs(pos, root)                      -- the stairs around it may turn into corners
	end
	if def.Shape == "Fence" then root:SetAttribute("Conn", UI.connKey(corner)) end
	UI.refreshFences(pos, root)                          -- fences around it may grow a rail toward it
	UI.fluidPoke(pos, def)                               -- water / lava nearby may start to flow (or stop)
	if def.Liquid then                                   -- Water / Lava / Fire: no collision, you walk into them
		root.CanCollide = false
		if def.Liquid == "Fire" then
			root.Transparency = 1
			new("Fire", {Size = 7, Heat = 8, Color = C(255, 150, 20), SecondaryColor = C(200, 40, 0)}, root)
			task.delay(30, function() if root.Parent then root:Destroy() end end)   -- the fire burns out
		end
	end
	if def.Shape == "Door" or def.Shape == "FenceGate" or def.Shape == "Trapdoor" then root:SetAttribute("Open", false) root:SetAttribute("Face", face or Vector3.zAxis) end
	if def.Shape == "Piston" then root:SetAttribute("Face", face or Vector3.zAxis) root:SetAttribute("Extended", false) end
	if def.Gravity and UI.gravAdd then UI.gravAdd(root) end      -- Sand / Gravel / Concrete Powder can fall
	return root
end

