function UI.toggleTrapdoor(root)                      -- right-click a trapdoor: lies flat <-> stands up against the far side (instant)
	local open = not root:GetAttribute("Open")
	root:SetAttribute("Open", open)
	local cell, face = root:GetAttribute("Cell"), root:GetAttribute("Face") or Vector3.zAxis
	local T = BLOCK * 0.1875
	local base = CFrame.lookAt(cell, cell - face)    -- its local -Z points toward the player
	if open then
		root.CFrame = base * CFrame.new(0, 0, BLOCK / 2 - T / 2) * CFrame.Angles(math.rad(90), 0, 0)
	else
		root.CFrame = base * CFrame.new(0, root:GetAttribute("Flip") and (BLOCK / 2 - T / 2) or (-BLOCK / 2 + T / 2), 0)
	end
end

function UI.toggleDoor(root)                         -- right-click a door: opens / closes INSTANTLY (no animation)
	local open = not root:GetAttribute("Open")
	root:SetAttribute("Open", open)
	local cell, face = root:GetAttribute("Cell"), root:GetAttribute("Face") or Vector3.zAxis
	local T = BLOCK * 0.18                           -- door thickness
	local base = CFrame.lookAt(cell, cell - face)    -- its local -Z points toward the player
	if open then                                     -- turned 90 degrees, flat against the left side of the block
		root.CFrame = base * CFrame.new(-BLOCK / 2 + T / 2, BLOCK / 2, 0) * CFrame.Angles(0, math.rad(-90), 0)
	else                                             -- closed: standing at the FRONT edge of the block
		root.CFrame = base * CFrame.new(0, BLOCK / 2, -BLOCK / 2 + T / 2)
	end
end

function UI.toggleGate(root)                         -- right-click a fence gate: opens / closes INSTANTLY (no animation)
	local open = not root:GetAttribute("Open")
	root:SetAttribute("Open", open)
	local cell, face = root:GetAttribute("Cell"), root:GetAttribute("Face") or Vector3.zAxis
	local cf = CFrame.lookAt(cell, cell - face)       -- its local -Z points toward the player
	local u = BLOCK / 16
	for _, side in ipairs({-1, 1}) do
		local half = root:FindFirstChild(side < 0 and "HalfL" or "HalfR")
		if half then
			local pivot = cf * CFrame.new(side * 7 * u, 0, 0)
			half:PivotTo(open and pivot * CFrame.Angles(0, math.rad(90 * side), 0) or pivot)   -- both leaves fold into the block, away from you
		end
	end
end

local function useItem(idx)
	local s = inv[idx]
	s.count -= 1
	if s.count <= 0 then inv[idx] = nil end
	render(idx)
end

local function doAction(action, pt)   -- right click / PLACE
	if action ~= "Place" or panelOpen or chatOpen then return end
	local hs = inv[35 + selected]
	if hs and hs.name == "Firework Rocket" and UI.useFirework then UI.useFirework(35 + selected) return end   -- works in the air too
	UI.wantLiquid = hs ~= nil and hs.name == "Bucket"        -- (only a Bucket aims at water / lava)
	local hit = getTarget(pt)
	UI.wantLiquid = false
	if not hit then return end
	local r = getRoot()
	if not r or (r.Position - hit.Position).Magnitude > REACH then return end
	local model = hit.Instance:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then return end

	local clicked = blockRoot(hit.Instance)
	if clicked and clicked:GetAttribute("BlockType") == "Crafting Table" and not (MV.sneakHeld or MV.sneakTog) then
		swing()
		UI.setCraft(true)                            -- right-click a Crafting Table = open the 3x3 crafting screen
		return
	end
	local rsKind = clicked and clicked:GetAttribute("RS")
	if (rsKind == "Lever" or rsKind == "Button") and not (MV.sneakHeld or MV.sneakTog) then
		swing()
		UI.rsUse(clicked)                            -- right-click a lever / button
		return
	end

	local cdef = clicked and BY_NAME[clicked:GetAttribute("BlockType") or ""]
	if cdef and (cdef.Shape == "Door" or cdef.Shape == "FenceGate" or cdef.Shape == "Trapdoor") and not (MV.sneakHeld or MV.sneakTog) then
		swing()
		if cdef.RedstoneOnly then sys("This only opens with redstone (lever, button, pressure plate, ...)") return end
		if cdef.Shape == "Door" then UI.toggleDoor(clicked) elseif cdef.Shape == "Trapdoor" then UI.toggleTrapdoor(clicked) else UI.toggleGate(clicked) end   -- right-click = open / close (instant)
		return
	end
	if clicked and not (MV.sneakHeld or MV.sneakTog) then
		local bt = clicked:GetAttribute("BlockType")
		if bt == "Chest" or bt == "Furnace" then
			swing()
			UI.openContainer(clicked, bt)                -- right-click a Chest / Furnace = open it
			return
		end
	end

	local idx = 35 + selected
	local s = inv[idx]
	if not s then return end
	local d = BY_NAME[s.name]
	if clicked and clicked:GetAttribute("BlockType") == "TNT" and (d.Name == "Flint and Steel" or d.Name == "Redstone Dust" or d.Name == "Lever") then
		swing()                                          -- TNT only explodes when lit: Flint and Steel, or a redstone item (Redstone Dust / Lever)
		UI.igniteTNT(clicked)
		return
	end
	if d.Name == "Flint and Steel" then                  -- lights a Fire block next to the block you look at
		local fpos, fn = placePos(hit)
		swing()
		if UI.tryPortal(fpos) then return end              -- Flint and Steel inside an Obsidian frame = Nether portal
		local blocked = false
		for _, part in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(fpos), Vector3.one * (BLOCK - 0.2))) do
			if blockRoot(part) then blocked = true break end
		end
		if not blocked and BY_NAME["Fire"] then UI.redstoneCheck(fpos, BY_NAME["Fire"], makeBlock(fpos, BY_NAME["Fire"], fn, r, false, nil)) end
		return
	end
	if d.Name == "Water Bucket" or d.Name == "Lava Bucket" then      -- pour it out
		local liquid = d.Name == "Water Bucket" and "Water" or "Lava"
		local pos, n = placePos(hit)
		swing()
		local ex = UI.rootAt(pos)
		if ex then
			if ex:GetAttribute("Flow") ~= nil then ex:Destroy() else return end     -- flowing water / lava is replaced by the new source
		end
		makeBlock(pos, BY_NAME[liquid], n, r, false, nil)
		if mode == "survival" then inv[idx] = {name = "Bucket", count = 1} render(idx) end   -- you keep the empty bucket
		return
	end
	if d.Name == "Bucket" and clicked then                            -- scoop a water / lava block back up
		local bt = clicked:GetAttribute("BlockType")
		if (bt == "Water" or bt == "Lava") and clicked:GetAttribute("Flow") == nil then     -- only a SOURCE can be scooped up
			swing()
			clicked:Destroy()
			UI.fluidPoke(hit.Position)
			local filled = bt .. " Bucket"
			local st = inv[idx]
			if mode == "survival" and st.count > 1 then
				st.count -= 1
				render(idx)
				give(filled, 1)
			else
				inv[idx] = {name = filled, count = 1}
				render(idx)
			end
			return
		end
	end
	if d.Name == "Redstone Dust" or d.Name == "Lever" or d.Name == "Stone Button" or d.Name == "Pressure Plate" then
		local cpos = placePos(hit)
		swing()
		if UI.rsPlace(d.Name, cpos) and mode == "survival" then useItem(idx) end
		return
	end
	if d.IsBlock then
		local pos, n = placePos(hit)
		local flip, face, boxCF, boxSize = false, nil, CFrame.new(pos), Vector3.one * (BLOCK - 0.2)
		if d.Shape then
			-- top half when you click an underside or the upper half of a side
			flip = n.Y < -0.5 or (math.abs(n.Y) < 0.5 and hit.Position.Y > pos.Y)
			if d.Shape == "Slab" then
				-- slab on the flat side of a slab = the other half of the same cell (double slab)
				local root = blockRoot(hit.Instance)
				if root and root.Name == "Slab" and root:GetAttribute("Cell") then
					local topSlab = root:GetAttribute("Flip")
					if (n.Y > 0.5 and not topSlab) or (n.Y < -0.5 and topSlab) then
						pos, flip = root:GetAttribute("Cell"), not topSlab
					end
				end
				boxCF = CFrame.new(pos + Vector3.new(0, flip and BLOCK / 4 or -BLOCK / 4, 0))
				boxSize = Vector3.new(BLOCK - 0.2, BLOCK / 2 - 0.2, BLOCK - 0.2)
			else
				-- stairs rise away from you (the high side is the way you are looking); a door faces you too
				face = UI.axis()
				if d.Shape == "Piston" then                  -- a piston can also face up / down (look steeply down = the head faces up)
					local lk = UI.look()
					if math.abs(lk.Y) > 0.8 then face = Vector3.new(0, lk.Y > 0 and 1 or -1, 0) end
				end
				if d.Shape == "Door" then                -- a door fills 2 blocks, so check both cells
					boxCF, boxSize = CFrame.new(pos + Vector3.new(0, BLOCK / 2, 0)), Vector3.new(BLOCK - 0.2, BLOCK * 2 - 0.2, BLOCK - 0.2)
				end
			end
		end
		for _, part in ipairs(Workspace:GetPartBoundsInBox(boxCF, boxSize)) do
			local br = blockRoot(part)
			local bd = br and BY_NAME[br:GetAttribute("BlockType") or ""]
			if br and (br:GetAttribute("RS") or (bd and bd.Liquid)) then br:Destroy() elseif br then return end   -- a block replaces redstone / water / lava / fire
			local m = part:FindFirstAncestorOfClass("Model")
			if m and m:FindFirstChildOfClass("Humanoid") then return end
		end
		UI.redstoneCheck(pos, d, makeBlock(pos, d, n, r, flip, face))     -- TNT next to a Redstone Block / Fire lights up
		UI.placed += 1
		swing()
		if mode == "survival" then useItem(idx) end
	elseif UI.armorInfo(d.Name) then
		local slot = UI.armorInfo(d.Name).slot
		local old = inv[slot]
		swing()
		inv[slot] = {name = d.Name, count = 1}
		if mode == "survival" then
			useItem(idx)                                                              -- the piece leaves your hand...
			if old then
				if inv[idx] then give(old.name, old.count) else inv[idx] = old render(idx) end   -- ...and the old piece takes its place
			end
		end
		render(slot)
		sys("Equipped " .. d.Name)
	elseif d.Food then
		if mode == "survival" then
			if UI.foodLevel() >= 20 and d.Name ~= "Golden Apple" then sys("You are not hungry") return end   -- already full
			swing()
			useItem(idx)
			UI.eat(d.Food, d.Name == "Golden Apple")
		else
			swing()
		end
		sys("Ate " .. d.Name .. " (+" .. d.Food .. ")")
	elseif d.Drink then
		sys("Drank " .. d.Name)
	end
end

--====================================================================
-- HOW STRONG BLOCKS ARE (numbers of the real Minecraft)
--   hard = how long it takes to break (Minecraft "hardness")       tool = the tool that is fast on it (pickaxe / axe / shovel)
--   tier = the weakest tool that makes the block DROP (1 wood / gold, 2 stone, 3 iron, 4 diamond)
--   res  = blast resistance: how well it survives TNT (Obsidian never breaks)
-- Give a Block{...} your own numbers with  Hardness = , Tool = , Tier = , BlastRes = , DropName = "Dirt"
--====================================================================
do
	local function S(hard, tool, tier, res, extra)
		local t = {hard = hard, tool = tool, tier = tier or 0, res = res}
		if extra then for k, v in pairs(extra) do t[k] = v end end
		return t
	end
	local STATS = {
		["Stone"] = S(1.5, "pickaxe", 1, 6, {drop = "Cobblestone"}), ["Cobblestone"] = S(2, "pickaxe", 1, 6), ["Bricks"] = S(2, "pickaxe", 1, 6),
		["Oak Planks"] = S(2, "axe", 0, 3), ["Oak Log"] = S(2, "axe", 0, 2), ["Glass"] = S(0.3, nil, 0, 0.3, {nodrop = true}),
		["Gold Block"] = S(3, "pickaxe", 3, 6), ["Diamond Block"] = S(5, "pickaxe", 3, 6), ["Obsidian"] = S(50, "pickaxe", 4, 1200),
		["Grass Block"] = S(0.6, "shovel", 0, 0.6, {drop = "Dirt"}), ["Dirt"] = S(0.5, "shovel", 0, 0.5), ["Sand"] = S(0.5, "shovel", 0, 0.5),
		["Gravel"] = S(0.6, "shovel", 0, 0.6), ["Clay"] = S(0.6, "shovel", 0, 0.6), ["Snow"] = S(0.2, "shovel", 0, 0.2),
		["Leaves"] = S(0.2, nil, 0, 0.2, {nodrop = true}),
		["Crafting Table"] = S(2.5, "axe", 0, 2.5), ["Furnace"] = S(3.5, "pickaxe", 1, 3.5), ["Chest"] = S(2.5, "axe", 0, 2.5),
		["Bookshelf"] = S(1.5, "axe", 0, 1.5),
		["Redstone Block"] = S(5, "pickaxe", 1, 6), ["Redstone Lamp"] = S(0.3, nil, 0, 0.3), ["TNT"] = S(0, nil, 0, 0), ["Piston"] = S(1.5, "pickaxe", 0, 1.5), ["Sticky Piston"] = S(1.5, "pickaxe", 0, 1.5), ["Iron Door"] = S(5, "pickaxe", 1, 6), ["Iron Trapdoor"] = S(5, "pickaxe", 1, 6),
		["Redstone Dust"] = S(0, nil, 0, 0), ["Pressure Plate"] = S(0.5, "pickaxe", 0, 0.5), ["Lever"] = S(0.5, nil, 0, 0.5), ["Stone Button"] = S(0.5, "pickaxe", 0, 0.5),
		["Netherrack"] = S(0.4, "pickaxe", 1, 0.4), ["Nether Bricks"] = S(2, "pickaxe", 1, 6), ["Soul Sand"] = S(0.5, "shovel", 0, 0.5),
		["Glowstone"] = S(0.3, nil, 0, 0.3), ["Magma Block"] = S(0.5, "pickaxe", 1, 0.5), ["Nether Quartz Block"] = S(0.8, "pickaxe", 1, 0.8),
		["Water"] = S(0.05, nil, 0, 100, {nodrop = true}), ["Lava"] = S(0.05, nil, 0, 100, {nodrop = true}), ["Fire"] = S(0, nil, 0, 0, {nodrop = true}),
	}
	local BY_SHAPE = {Door = S(3, "axe", 0, 3), Trapdoor = S(3, "axe", 0, 3), Fence = S(2, "axe", 0, 3), FenceGate = S(2, "axe", 0, 3)}
	local DEFAULT = S(1.5, nil, 0, 3)
	local TOOL_MATS = {wooden = {2, 1}, stone = {4, 2}, iron = {6, 3}, golden = {12, 1}, gold = {12, 1}, diamond = {8, 4}, netherite = {9, 5}}   -- {speed, tier}

	function UI.blockStats(kind)
		local d = BY_NAME[kind or ""]
		local st = STATS[kind or ""]
		if not st and d then
			if d.Shape and BY_SHAPE[d.Shape] then st = BY_SHAPE[d.Shape]
			elseif d.Base and STATS[d.Base] then st = STATS[d.Base]                       -- slab / stairs = same as the block they are made of
			elseif d.Shape == "Carpet" then st = S(0.1, nil, 0, 0.1)
			elseif kind and kind:find("Wool") then st = S(0.8, nil, 0, 0.8) end
		end
		st = st or DEFAULT
		if d and (d.Hardness or d.Tool or d.Tier or d.BlastRes or d.DropName) then       -- your own numbers
			local c = {}
			for k, v in pairs(st) do c[k] = v end
			c.hard, c.tool, c.tier, c.res = d.Hardness or c.hard, d.Tool or c.tool, d.Tier or c.tier, d.BlastRes or c.res
			c.drop = d.DropName or c.drop
			st = c
		end
		return st
	end

	local function heldTool()                             -- tool type, speed, tier of the item in your hand
		local s = inv[35 + selected]
		local mat, typ = (s and s.name:lower() or ""):match("^(%a+) (%a+)$")
		local m = mat and TOOL_MATS[mat]
		if m and (typ == "pickaxe" or typ == "axe" or typ == "shovel" or typ == "hoe") then return typ, m[1], m[2] end
		return nil, 1, 0
	end

	function UI.canHarvest(kind)                          -- does the block drop something when broken with what you hold?
		local st = UI.blockStats(kind)
		if not st.tool or st.tier == 0 then return true end
		local typ, _, tier = heldTool()
		return typ == st.tool and tier >= st.tier
	end

	function UI.breakTime(kind)                           -- seconds, same formula as Minecraft
		local st = UI.blockStats(kind)
		if st.hard <= 0 then return 0.03 end
		local typ, speed = heldTool()
		if typ ~= st.tool then speed = 1 end
		return math.max(0.03, st.hard * (UI.canHarvest(kind) and 1.5 or 5) / speed)
	end

	function UI.dropFor(kind, ignoreTool)                 -- the item a broken block gives (nil = nothing). TNT ignores the tool.
		local st = UI.blockStats(kind)
		if st.nodrop then return nil end
		if not ignoreTool and not UI.canHarvest(kind) then return nil end
		return BY_NAME[st.drop or kind or ""]
	end
end

-- CRACKS (like Minecraft): the breaking animation has 10 crack textures, stage 0 to 9 (destroy_stage_0 ... destroy_stage_9),
-- one after the other while you hold. Without picture ids they are drawn with pixels (a crack that grows from the middle and branches).
-- To use your OWN 10 pictures, fill the list:  UI.CRACK_IDS = {[0] = "rbxassetid://...", "rbxassetid://...", ... up to [9]}
-- (or a normal list of 10 ids: the first one = stage 0, the last one = stage 9)
UI.CRACK_IDS = {"rbxassetid://80024627329017", "rbxassetid://107514785906422", "rbxassetid://82491147121015", "rbxassetid://71036097965259", "rbxassetid://115327391013644", "rbxassetid://100538819885629", "rbxassetid://97199894279901", "rbxassetid://105563560403703", "rbxassetid://114045569919450", "rbxassetid://115122614331209"}   -- your 10 pictures: stage 0 (first) ... stage 9 (almost broken)
do
	local crack, crackPart, stage = nil, nil, -1
	local templates, built = {}, false
	local resolved = {}
	local function realImage(id)                           -- a Decal id is not an Image id: ask Roblox for the real image (same trick as the skin)
		id = tostring(id)
		if id:match("^%d+$") then id = "rbxassetid://" .. id end
		if resolved[id] then return resolved[id] end
		local url = id
		pcall(function()
			local o = game:GetObjects(id)[1]
			if o then
				if (o:IsA("Decal") or o:IsA("Texture")) and o.Texture ~= "" then url = o.Texture end
				o:Destroy()
			end
		end)
		resolved[id] = url
		return url
	end
	task.spawn(function()                                  -- once at the start, so nothing waits while you break a block
		for _, id in pairs(UI.CRACK_IDS) do realImage(id) end
	end)
	local function makeTemplates()                          -- the 10 built-in textures (16 x 16 pixels each), made once
		built = true
		local rng = Random.new(2024)
		local grid = {}                                      -- grid[y * 16 + x] = the step (1 - 10) where this pixel appears
		local function setp(x, y, st)
			if x >= 0 and x < 16 and y >= 0 and y < 16 and not grid[y * 16 + x] then grid[y * 16 + x] = st end
		end
		setp(8, 8, 1) setp(7, 8, 1) setp(8, 7, 1)
		local heads = {{x = 8, y = 8, dx = 1, dy = 0}, {x = 8, y = 8, dx = -1, dy = 1}, {x = 7, y = 8, dx = 0, dy = -1}}
		for st = 1, 10 do
			local newHeads = {}
			for _, hd in ipairs(heads) do
				local x, y, dx, dy = hd.x, hd.y, hd.dx, hd.dy
				for _ = 1, (st > 5 and 3 or 2) do
					if rng:NextNumber() < 0.4 then
						dx = math.clamp(dx + rng:NextInteger(-1, 1), -1, 1)
						dy = math.clamp(dy + rng:NextInteger(-1, 1), -1, 1)
						if dx == 0 and dy == 0 then dx = 1 end
					end
					x += dx
					y += dy
					setp(x, y, st)
					if rng:NextNumber() < 0.5 then setp(x + (dy ~= 0 and 1 or 0), y + (dx ~= 0 and 1 or 0), st) end
				end
				newHeads[#newHeads + 1] = {x = x, y = y, dx = dx, dy = dy}
				if st >= 2 and st <= 8 and rng:NextNumber() < 0.45 then                       -- the crack splits
					newHeads[#newHeads + 1] = {x = x, y = y, dx = (-dy ~= 0) and -dy or 1, dy = (dx ~= 0) and dx or 1}
				end
			end
			heads = {}
			for i = 1, math.min(#newHeads, 9) do heads[i] = newHeads[i] end
		end
		for k = 0, 9 do                                      -- texture k = every pixel up to step k + 1 (a row of pixels = one bar)
			local fr = new("Frame", {Name = "Tex", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0}, nil)
			for y = 0, 15 do
				local x = 0
				while x < 16 do
					local g = grid[y * 16 + x]
					if g and g <= k + 1 then
						local x0 = x
						while x < 16 and grid[y * 16 + x] and grid[y * 16 + x] <= k + 1 do x += 1 end
						new("Frame", {Position = UDim2.fromOffset(x0 * 8, y * 8), Size = UDim2.fromOffset((x - x0) * 8, 8),
							BackgroundColor3 = C(25, 25, 25), BackgroundTransparency = 0.25, BorderSizePixel = 0}, fr)
					else
						x += 1
					end
				end
			end
			templates[k] = fr
		end
	end

	function UI.clearCrack()
		if crack then crack:Destroy() end
		crack, crackPart, stage = nil, nil, -1
	end

	function UI.updateCrack(part, frac)
		if not built then makeTemplates() end
		if crackPart ~= part or not crack or not crack.Parent then
			UI.clearCrack()
			crackPart = part
			local cf, size
			if part:IsA("Model") then cf, size = part:GetBoundingBox() else cf, size = part.CFrame, part.Size end
			crack = new("Part", {Name = "MCCrack", Size = size + Vector3.new(0.05, 0.05, 0.05), CFrame = cf, Anchored = true, CanCollide = false,
				CanQuery = false, CanTouch = false, Transparency = 1, CastShadow = false}, Workspace)
			for _, face in ipairs(Enum.NormalId:GetEnumItems()) do
				new("SurfaceGui", {Face = face, SizingMode = Enum.SurfaceGuiSizingMode.FixedSize, CanvasSize = Vector2.new(128, 128), LightInfluence = 0}, crack)
			end
		end
		local ids = UI.CRACK_IDS
		local zero = ids[0] ~= nil
		local n = #ids + (zero and 1 or 0)                            -- how many pictures you gave (any number works)
		local total = n > 0 and n or 10
		local st = math.clamp(math.floor(frac * total), 0, total - 1)   -- first part of the way = first picture ... last part = last picture
		if st == stage then return end
		stage = st
		local id = n > 0 and (zero and ids[st] or ids[st + 1]) or nil
		for _, sg in ipairs(crack:GetChildren()) do
			if sg:IsA("SurfaceGui") then
				local old = sg:FindFirstChild("Tex")
				if old then old:Destroy() end
				if id then
					new("ImageLabel", {Name = "Tex", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = realImage(id), ImageTransparency = 0.25,
						ResampleMode = Enum.ResamplerMode.Pixelated}, sg)
				else
					templates[st]:Clone().Parent = sg
				end
			end
		end
	end
end

