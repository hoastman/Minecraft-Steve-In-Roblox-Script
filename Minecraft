			TextStrokeTransparency = 0.6, LayoutOrder = chatSeq, Text = raw}, chatBox)
		new("UIPadding", {PaddingLeft = UDim.new(0, 4)}, lbl)
		chatLines[#chatLines + 1] = {lbl = lbl, raw = raw, n = 1, t = os.clock()}
		if #chatLines > 40 then chatLines[1].lbl:Destroy() table.remove(chatLines, 1) end
	end
