function UI.toggleDoor(root)                         -- right-click a door: opens / closes INSTANTLY (no animation)
	local open = not root:GetAttribute("Open")
	root:SetAttribute("Open", open)
	local cell, face = root:GetAttribute("Cell"), root:GetAttribute("Face") or Vector3.zAxis
	local T = BLOCK * 0.18                           -- door thickness
	local base = CFrame.lookAt(cell, cell - face)    -- its local -Z points toward the player
	if open then                                     -- turned 90 degrees, flat against the left side of the block
		root.CFrame = base * CFrame.new(-BLOCK / 2 + T / 2, BLOCK / 2, 0) * CFrame.Angles(0, math.rad(-90), 0)
	else                                             -- closed: standing at the FRONT edge of the block
		root.CFrame = base * CFrame.new(0, BLOCK / 2, -BLOCK / 2 + T / 2)
	end
end

function UI.toggleGate(root)                         -- right-click a fence gate: opens / closes INSTANTLY (no animation)
	local open = not root:GetAttribute("Open")
	root:SetAttribute("Open", open)
	local cell, face = root:GetAttribute("Cell"), root:GetAttribute("Face") or Vector3.zAxis
	local cf = CFrame.lookAt(cell, cell - face)       -- its local -Z points toward the player
	local u = BLOCK / 16
	for _, side in ipairs({-1, 1}) do
		local half = root:FindFirstChild(side < 0 and "HalfL" or "HalfR")
		if half then
			local pivot = cf * CFrame.new(side * 7 * u, 0, 0)
			half:PivotTo(open and pivot * CFrame.Angles(0, math.rad(90 * side), 0) or pivot)   -- both leaves fold into the block, away from you
		end
	end
end

local function useItem(idx)
	local s = inv[idx]
	s.count -= 1
	if s.count <= 0 then inv[idx] = nil end
	render(idx)
end

local function doAction(action, pt)   -- right click / PLACE
	if action ~= "Place" or panelOpen or chatOpen then return end
	local hit = getTarget(pt)
	if not hit then return end
	local r = getRoot()
	if not r or (r.Position - hit.Position).Magnitude > REACH then return end
	local model = hit.Instance:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then return end

	local clicked = blockRoot(hit.Instance)
	if clicked and clicked:GetAttribute("BlockType") == "Crafting Table" and not (MV.sneakHeld or MV.sneakTog) then
		swing()
		UI.setCraft(true)                            -- right-click a Crafting Table = open the 3x3 crafting screen
		return
	end

	local cdef = clicked and BY_NAME[clicked:GetAttribute("BlockType") or ""]
	if cdef and (cdef.Shape == "Door" or cdef.Shape == "FenceGate") and not (MV.sneakHeld or MV.sneakTog) then
		swing()
		if cdef.Shape == "Door" then UI.toggleDoor(clicked) else UI.toggleGate(clicked) end   -- right-click = open / close (instant)
		return
	end
	if clicked and not (MV.sneakHeld or MV.sneakTog) then
		local bt = clicked:GetAttribute("BlockType")
		if bt == "Chest" or bt == "Furnace" then
			swing()
			UI.openContainer(clicked, bt)                -- right-click a Chest / Furnace = open it
			return
		end
	end

	local idx = 35 + selected
	local s = inv[idx]
	if not s then return end
	local d = BY_NAME[s.name]
	if clicked and clicked:GetAttribute("BlockType") == "TNT" and (d.Name == "Flint and Steel" or d.Name == "Redstone Dust" or d.Name == "Lever") then
		swing()                                          -- TNT only explodes when lit: Flint and Steel, or a redstone item (Redstone Dust / Lever)
		UI.igniteTNT(clicked)
		return
	end
	if d.Name == "Flint and Steel" then                  -- lights a Fire block next to the block you look at
		local fpos, fn = placePos(hit)
		swing()
		local blocked = false
		for _, part in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(fpos), Vector3.one * (BLOCK - 0.2))) do
			if blockRoot(part) then blocked = true break end
		end
		if not blocked and BY_NAME["Fire"] then UI.redstoneCheck(fpos, BY_NAME["Fire"], makeBlock(fpos, BY_NAME["Fire"], fn, r, false, nil)) end
		return
	end
	if d.IsBlock then
		local pos, n = placePos(hit)
		local flip, face, boxCF, boxSize = false, nil, CFrame.new(pos), Vector3.one * (BLOCK - 0.2)
		if d.Shape then
			-- top half when you click an underside or the upper half of a side
			flip = n.Y < -0.5 or (math.abs(n.Y) < 0.5 and hit.Position.Y > pos.Y)
			if d.Shape == "Slab" then
				-- slab on the flat side of a slab = the other half of the same cell (double slab)
				local root = blockRoot(hit.Instance)
				if root and root.Name == "Slab" and root:GetAttribute("Cell") then
					local topSlab = root:GetAttribute("Flip")
					if (n.Y > 0.5 and not topSlab) or (n.Y < -0.5 and topSlab) then
						pos, flip = root:GetAttribute("Cell"), not topSlab
					end
				end
				boxCF = CFrame.new(pos + Vector3.new(0, flip and BLOCK / 4 or -BLOCK / 4, 0))
				boxSize = Vector3.new(BLOCK - 0.2, BLOCK / 2 - 0.2, BLOCK - 0.2)
			else
				-- stairs rise away from you (the high side is the way you are looking); a door faces you too
				face = UI.axis()
				if d.Shape == "Door" then                -- a door fills 2 blocks, so check both cells
					boxCF, boxSize = CFrame.new(pos + Vector3.new(0, BLOCK / 2, 0)), Vector3.new(BLOCK - 0.2, BLOCK * 2 - 0.2, BLOCK - 0.2)
				end
			end
		end
		for _, part in ipairs(Workspace:GetPartBoundsInBox(boxCF, boxSize)) do
			if blockRoot(part) then return end
			local m = part:FindFirstAncestorOfClass("Model")
			if m and m:FindFirstChildOfClass("Humanoid") then return end
		end
		UI.redstoneCheck(pos, d, makeBlock(pos, d, n, r, flip, face))     -- TNT next to a Redstone Block / Fire lights up
		UI.placed += 1
		swing()
		if mode == "survival" then useItem(idx) end
	elseif d.Food then
		swing()
		if mode == "survival" then useItem(idx) end
		sys("Ate " .. d.Name .. " (+" .. d.Food .. ")")
	elseif d.Drink then
		sys("Drank " .. d.Name)
	end
end

