			new("Frame", {Position = UDim2.fromOffset(4 + k * 8, 3), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = C(170, 170, 170), BorderSizePixel = 0, ZIndex = 8}, strip)
		end
	else
		local first = pick
		if not first then
			for _, d in ipairs(ITEMS) do
				if d.Tab == name then first = d break end
			end
		end
		local item, ic = newItemView(ib, 7)
		item.Position = UDim2.fromOffset(0, 0)
		item.Size = UDim2.fromScale(1, 1)
