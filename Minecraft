---------- Recipe book (the green book in the inventory and in the crafting table): tap a recipe = it fills the grid ----------
do
	local function ingredients(rc)                    -- what ONE craft needs, and which grid cells to fill
		local need, cells = {}, {}
		for r, row in ipairs(rc.rows) do
			for c = 1, #row do
				local name = rc.key[row:sub(c, c)]
				if name then
					need[name] = (need[name] or 0) + 1
					cells[#cells + 1] = {r = r, c = c, name = name}
				end
			end
		end
		return need, cells
	end
	local function have(name)                         -- how many you carry (inventory + hotbar, not the crafting grid)
		local n = 0
		for i = 9, 44 do
			if inv[i] and inv[i].name == name then n += inv[i].count end
		end
		return n
	end
	local function take(name)                         -- remove ONE from your inventory
		for i = 9, 44 do
			local st = inv[i]
			if st and st.name == name then
				st.count -= 1
				if st.count <= 0 then inv[i] = nil end
				render(i)
				return true
			end
		end
		return false
	end

	local books = {}
	local function make(ctx, winFrame, scale, viewFrame, first, size)    -- ctx 1 = inventory (2x2), ctx 2 = crafting table (3x3)
		local P = new("Frame", {Position = UDim2.fromOffset(-180, 0), Size = UDim2.fromOffset(172, 320), BackgroundColor3 = C(198, 198, 198),
			BorderSizePixel = 0, ZIndex = 3, Visible = false}, winFrame)
		bevel(P, WHITE, C(85, 85, 85), 4)
		local head = new("TextLabel", {Text = "Recipe Book", Position = UDim2.fromOffset(10, 8), Size = UDim2.fromOffset(150, 14), BackgroundTransparency = 1,
			TextColor3 = C(64, 64, 64), TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5}, P)
		pixelFont(head)
		local list = new("ScrollingFrame", {Position = UDim2.fromOffset(8, 28), Size = UDim2.fromOffset(156, 236), BackgroundColor3 = C(139, 139, 139),
			BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 5}, P)
		new("UIPadding", {PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)}, list)
		new("UIGridLayout", {CellSize = UDim2.fromOffset(32, 32), CellPadding = UDim2.fromOffset(4, 4), SortOrder = Enum.SortOrder.LayoutOrder}, list)
		local note = new("TextLabel", {Text = "Tap a recipe to fill the grid", Position = UDim2.fromOffset(10, 270), Size = UDim2.fromOffset(152, 42),
			BackgroundTransparency = 1, TextColor3 = C(64, 64, 64), TextSize = 8, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 5}, P)
		pixelFont(note)

		local entries = {}
		local function needText(e)
			local t = {}
			for name, n in pairs(e.need) do t[#t + 1] = n .. " " .. name end
			table.sort(t)
			return table.concat(t, ", ")
		end
		local function refresh()
			for _, e in ipairs(entries) do
				local ok = true
				for name, n in pairs(e.need) do
					if have(name) < n then ok = false break end
				end
				e.ok = ok
				e.dim.Visible = not ok
				e.btn.LayoutOrder = ok and 0 or 1          -- the ones you can craft come first
			end
		end
		local function fill(e)
			note.Text = e.rc.out .. ":  " .. needText(e)
			UI.returnGrid(first, size * size)             -- empty the grid first (your items come back)
			refresh()
			if not e.ok then note.Text = e.rc.out .. ": you need " .. needText(e) return end
			for _, cell in ipairs(e.cells) do
				if take(cell.name) then
					local idx = first + (cell.r - 1) * size + (cell.c - 1)
					inv[idx] = {name = cell.name, count = 1}
					render(idx)
				end
			end
			UI.refreshCraft()
			refresh()
		end

		for _, rc in ipairs(UI.recipes) do
			local h, w = #rc.rows, #rc.rows[1]
			local d = BY_NAME[rc.out]
			if h <= size and w <= size and d then
				local need, cells = ingredients(rc)
				local b = new("TextButton", {Size = UDim2.fromOffset(32, 32), BackgroundColor3 = C(139, 139, 139), BorderSizePixel = 0, Text = "",
					AutoButtonColor = false, ZIndex = 6}, list)
				new("UIStroke", {Color = C(55, 55, 55), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, b)
				local item, ic = newItemView(b, 7)
				item.BackgroundColor3, item.BackgroundTransparency = d.Color, bgT(d)
				setIcon(ic, d)
				local dim = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(70, 70, 70), BackgroundTransparency = 0.4,
					BorderSizePixel = 0, ZIndex = 12}, b)
				local e = {rc = rc, need = need, cells = cells, btn = b, dim = dim}
				entries[#entries + 1] = e
				on(b.Activated, function() fill(e) end)
			end
		end

		local function set(open)
			if open == P.Visible then return end
			P.Visible = open
			winFrame.Position = open and UDim2.new(0.5, 89 * scale.Scale, 0.45, 0) or UDim2.fromScale(0.5, 0.45)   -- the screen slides over, like Minecraft
			if open then refresh() note.Text = "Tap a recipe to fill the grid" end
		end
		on(viewFrame:GetPropertyChangedSignal("Visible"), function() if not viewFrame.Visible then set(false) end end)   -- screen / tab closed
		on(winFrame:GetPropertyChangedSignal("Visible"), function() if not winFrame.Visible then set(false) end end)
		books[ctx] = {P = P, set = set, refresh = refresh}
	end
	make(1, win, wscale, invView, 1, 2)
	make(2, UI.cwin, UI.cscale, UI.cwin, 46, 3)

	function UI.toggleBook(ctx)
		local b = books[ctx]
		if b then b.set(not b.P.Visible) end
	end
	function UI.bookRefresh()
		for _, b in pairs(books) do
