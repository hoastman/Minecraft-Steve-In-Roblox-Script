-- STATUS BARS: hearts (left), hunger (right) and XP bar + level above the hotbar.
-- Survival only (hidden in creative, like Minecraft).
--   UI.addXP(n)        give XP            UI.eat(points)   fill hunger
--   UI.resetStats()    full food, 0 XP    UI.hungerSpeed     1 = normal, 2 = hungry twice as fast, 0 = never hungry
--====================================================================
UI.hungerSpeed = 1      -- (kept in the UI table so the script does not run out of local variables)
UI.xpPerBlock = 1

do
	local PX = 2   -- size of one pixel of the icons
	local HEART = {
		".OOO.OOO.",
		"OWRRORRRO",
		"OWRRRRRRO",
		"ORRRRRRRO",
		".ORRRRRO.",
		"..ORRRO..",
		"...ORO...",
		"....O....",
	}
	local DRUMSTICK = {
		"....OOO..",
		"..OORRRO.",
		".ORWRRRRO",
		".ORRRRRRO",
		".ORRRRRO.",
		"OBORRRO..",
		"OBBOOO...",
		".OO......",
	}
	local ARMOR_ICON = {
		"OOO...OOO",
		"OWRO.ORRO",
		"OWRRORRRO",
		".ORRRRRO.",
		".ORRRRRO.",
		".ORRRRRO.",
		".ORRRRRO.",
		"..OOOOO..",
	}
	local OUTLINE = C(0, 0, 0)
	local HEART_PAL = {full = C(235, 30, 30), shine = C(255, 175, 175), empty = C(58, 58, 58), bone = C(58, 58, 58)}
	local FOOD_PAL = {full = C(190, 105, 45), shine = C(240, 180, 120), empty = C(58, 58, 58), bone = C(238, 238, 228)}
	local ARMOR_PAL = {full = C(200, 205, 212), shine = C(255, 255, 255), empty = C(58, 58, 58), bone = C(58, 58, 58)}
	local GREEN, GREEN_LIGHT = C(128, 255, 32), C(195, 255, 130)

	local holder = new("Frame", {Name = "StatusBars", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -(8 + BAR_H + 6)),
		Size = UDim2.fromOffset(BAR_W, 44), BackgroundTransparency = 1, Active = false, Visible = false}, gui)

	UI.statusHolder = holder
	local armorRow = new("Frame", {Size = UDim2.fromOffset(BAR_W, 16), BackgroundTransparency = 1, Active = false, Visible = false}, holder)
	local function buildIcon(pattern, x, y, parent)
		local cells = {}
		local icon = new("Frame", {Position = UDim2.fromOffset(x, y or 12), Size = UDim2.fromOffset(9 * PX, #pattern * PX),
			BackgroundTransparency = 1, BorderSizePixel = 0, Active = false}, parent or holder)
		for r, row in ipairs(pattern) do
			for col = 1, 9 do
				local ch = row:sub(col, col)
				if ch ~= "." then
					local f = new("Frame", {Position = UDim2.fromOffset((col - 1) * PX, (r - 1) * PX), Size = UDim2.fromOffset(PX, PX),
						BorderSizePixel = 0, BackgroundColor3 = OUTLINE, Active = false}, icon)
					cells[#cells + 1] = {f = f, k = ch, col = col}
				end
			end
		end
		return cells
	end

	local function paint(cells, pal, state)   -- state: 0 = empty, 1 = half, 2 = full
		for _, cell in ipairs(cells) do
			local k, color = cell.k, OUTLINE
			local lit = state == 2 or (state == 1 and cell.col <= 5)
			if k == "R" then color = lit and pal.full or pal.empty
			elseif k == "W" then color = lit and pal.shine or pal.empty
			elseif k == "B" then color = state > 0 and pal.bone or pal.empty end
			cell.f.BackgroundColor3 = color
		end
	end

	local function stateOf(points, i)
		return points >= i * 2 and 2 or (points == i * 2 - 1 and 1 or 0)
	end

	local hearts, hunger, armor = {}, {}, {}
	for i = 1, 10 do
		armor[i] = buildIcon(ARMOR_ICON, (i - 1) * 8 * PX, -6, armorRow)   -- armor row sits above the hearts
		hearts[i] = buildIcon(HEART, (i - 1) * 8 * PX)
		hunger[i] = buildIcon(DRUMSTICK, BAR_W - 9 * PX - (i - 1) * 8 * PX)   -- hunger empties from the left side
	end

	-- XP bar
	local xpBack = new("Frame", {Position = UDim2.fromOffset(0, 34), Size = UDim2.fromOffset(BAR_W, 10), BackgroundColor3 = OUTLINE,
		BorderSizePixel = 0, Active = false}, holder)
	local xpIn = new("Frame", {Position = UDim2.fromOffset(2, 2), Size = UDim2.new(1, -4, 1, -4), BackgroundColor3 = C(70, 70, 70),
		BorderSizePixel = 0, ClipsDescendants = true, Active = false}, xpBack)
	local xpFill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = GREEN, BorderSizePixel = 0, Active = false}, xpIn)
	new("Frame", {Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = GREEN_LIGHT, BorderSizePixel = 0, Active = false}, xpFill)
	local levelLbl = new("TextLabel", {AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, 32), Size = UDim2.fromOffset(40, 14),
		BackgroundTransparency = 1, Text = "", TextSize = 12, TextColor3 = GREEN, TextStrokeColor3 = OUTLINE, TextStrokeTransparency = 0, Active = false}, holder)
	pixelFont(levelLbl)

	-- numbers
	local food, exhaustion, healT = 20, 0, 0
	local xp, level = 0, 0
	local lastHp, lastFood, lastArmor = -1, -1, -1

	-- ARMOR: every piece you wear (slots H / C / L / B of the inventory) adds points, each point blocks 4% of explosion damage
	local ARMOR_MATS = {Leather = {1, 3, 2, 1}, Chainmail = {2, 5, 4, 1}, Iron = {2, 6, 5, 2}, Gold = {2, 5, 3, 1}, Golden = {2, 5, 3, 1},
		Diamond = {3, 8, 6, 3}, Netherite = {3, 8, 6, 3}}
	local ARMOR_PIECES = {Helmet = 1, Cap = 1, Chestplate = 2, Tunic = 2, Leggings = 3, Pants = 3, Boots = 4}
	function UI.armorInfo(name)
		if name == "Elytra" then return {pts = 0, slot = 6} end        -- the chest slot
		local mat, piece = tostring(name):match("^(%a+) (%a+)$")
		local m, pc = ARMOR_MATS[mat or ""], ARMOR_PIECES[piece or ""]
		if m and pc then return {pts = m[pc], slot = 4 + pc} end
	end
	function UI.armorPoints()
		local total = 0
		for i = 5, 8 do
			local st = inv[i]
			local info = st and UI.armorInfo(st.name)
			if info then total += info.pts end
		end
		return math.min(20, total)
	end

	function UI.playSound(id, pitch, vol)
		pcall(function()
			local snd = new("Sound", {SoundId = id, PlaybackSpeed = pitch or 1, Volume = vol or 0.5}, gui)
			snd:Play()
			task.delay(3, function() snd:Destroy() end)
		end)
	end

	local function need(l)   -- XP needed to go from level l to l+1 (same numbers as Minecraft)
		if l <= 15 then return 2 * l + 7 elseif l <= 30 then return 5 * l - 38 end
		return 9 * l - 158
	end

	local function refreshXP()
		xpFill.Size = UDim2.fromScale(math.clamp(xp / need(level), 0, 1), 1)
		levelLbl.Text = level > 0 and tostring(level) or ""
	end

	function UI.addXP(n)
		local before = level
		xp += n
		while xp >= need(level) do xp -= need(level) level += 1 end
		if level > before then UI.playSound("rbxasset://sounds/electronicpingshort.wav", 0.6, 0.6) end   -- level up "ding"
		refreshXP()
	end

	function UI.eat(points, golden)
		food = math.min(20, food + points)
		lastFood = -1
		if golden then
			local ch = player.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * 0.4) end   -- 4 hearts
		end
	end

	function UI.exhaust(n) exhaustion += n * UI.hungerSpeed end
	function UI.foodLevel() return food end

	function UI.resetStats()
		food, exhaustion, healT, xp, level = 20, 0, 0, 0, 0
		lastHp, lastFood, lastArmor = -1, -1, -1
		refreshXP()
	end
	UI.resetStats()

	on(player.CharacterAdded, function() UI.resetStats() end)   -- new body = full food, XP is lost (like dying in Minecraft)

	on(RS.Heartbeat, function(dt)
		local show = mode == "survival"
		if holder.Visible ~= show then holder.Visible = show end
		if not show then return end

		local ch = player.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		local maxH = math.max(hum.MaxHealth, 1)
		local hp = hum.Health <= 0 and 0 or math.clamp(math.ceil(hum.Health / maxH * 20), 1, 20)

		if hp ~= lastHp then
			lastHp = hp
			for i = 1, 10 do paint(hearts[i], HEART_PAL, stateOf(hp, i)) end
		end
		local ap = UI.armorPoints()
		if ap ~= lastArmor then
			lastArmor = ap
			armorRow.Visible = ap > 0
			for i = 1, 10 do paint(armor[i], ARMOR_PAL, stateOf(ap, i)) end
		end
		if food ~= lastFood then
			lastFood = food
			for i = 1, 10 do paint(hunger[i], FOOD_PAL, stateOf(food, i)) end
		end
		if hum.Health <= 0 then return end

		-- hunger drains faster when you move, much faster when you sprint
		local moving = hum.MoveDirection.Magnitude > 0.1
		local sneaking = MV.sneakHeld or MV.sneakTog
		local sprinting = moving and (MV.sprintHeld or MV.sprintTog) and not sneaking
		exhaustion += (moving and (sprinting and 0.3 or 0.07) or 0.04) * dt * UI.hungerSpeed
		while exhaustion >= 4 do
			exhaustion -= 4
			food = math.max(0, food - 1)
		end

		-- full hunger heals you, empty hunger hurts you (never kills, stops at half a heart)
		healT += dt
		if food >= 18 and hum.Health < maxH then
			if healT >= 4 then
				healT = 0
				hum.Health = math.min(maxH, hum.Health + maxH / 20)
				exhaustion += 0.6 * UI.hungerSpeed
			end
		elseif food <= 0 then
			if healT >= 4 then
				healT = 0
				if hum.Health > maxH / 20 then hum:TakeDamage(maxH / 20) end
			end
		else
			healT = 0
		end
	end)
end

