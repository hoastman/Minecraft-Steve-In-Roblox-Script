		new("Frame", {Position = UDim2.fromOffset(1, 3), Size = UDim2.fromOffset(22, 18), BackgroundColor3 = C(150, 105, 50), BorderSizePixel = 0, ZIndex = 7}, ib)
		new("Frame", {Position = UDim2.fromOffset(1, 9), Size = UDim2.fromOffset(22, 2), BackgroundColor3 = C(80, 50, 20), BorderSizePixel = 0, ZIndex = 8}, ib)
		new("Frame", {Position = UDim2.fromOffset(10, 8), Size = UDim2.fromOffset(4, 5), BackgroundColor3 = C(235, 200, 70), BorderSizePixel = 0, ZIndex = 9}, ib)
	elseif not pick and name == "Saved Hotbars" then        -- tiny hotbar
		local strip = new("Frame", {Position = UDim2.fromOffset(-2, 6), Size = UDim2.fromOffset(28, 12), BackgroundColor3 = C(60, 60, 60), BorderSizePixel = 0, ZIndex = 7}, ib)
		new("UIStroke", {Color = WHITE, Thickness = 1}, strip)
