--        Block{Name = "Ruby Block", Tab = "Building Blocks", Color = C(200, 20, 60), Texture = {All = "rbxassetid://123456"}}
--        (add  Shapes = true  to a Block to also get its Slab + Stairs with the same texture)
--        Slab{Name = "Ruby Slab", Tab = "Building Blocks", Color = C(200, 20, 60), Texture = {Top = "", Side = ""}}
--        Stairs{...}  Fence{...}  FenceGate{...}  Door{...}  work in a paste too
--        Item{Name = "Ruby Sword", Tab = "Combat", Front = "rbxassetid://654321", Stack = 1}
--   2) Click "raw" on the paste and copy that link (https://pastebin.com/raw/XXXXXXXX)
--   3) Paste it between the quotes below (you can add several links)
--====================================================================
local PASTEBIN_URLS = {
	"https://raw.githubusercontent.com/hoastman/Minecraft-Steve-In-Roblox-Script/refs/heads/main/Creative/Tab/Building%20Blocks", "https://raw.githubusercontent.com/hoastman/Minecraft-Steve-In-Roblox-Script/refs/heads/main/Creative/Tab/Combat",
}
for _, url in ipairs(PASTEBIN_URLS) do
	if url ~= "" then
		local ok, src = pcall(function() return game:HttpGet(url) end)
		if not ok or type(src) ~= "string" then                   -- some executors only have request()
			ok, src = pcall(function() return (request or http_request or syn.request)({Url = url, Method = "GET"}).Body end)
		end
		if ok and type(src) == "string" then
			local before = #ITEMS
			local fn, err = loadstring("local Block, Item, C, Slab, Stairs, Fence, FenceGate, Door = ...\n" .. src)
			if fn then
				local function PBlock(d)                       -- Block{..., Shapes = true} also makes "<name> Slab" and "<name> Stairs"
					Block(d)
					if d.Shapes then addShapes(d.Name) end
				end
				local ran, e2 = pcall(fn, PBlock, Item, C, Slab, Stairs, Fence, FenceGate, Door)
				if not ran then warn("Pastebin script error: " .. tostring(e2)) end
			else
				warn("Pastebin script has a mistake: " .. tostring(err))
			end
			print("Pastebin: added " .. (#ITEMS - before) .. " items from " .. url)
		else
			warn("Could not download " .. url .. " (use the RAW link)")
		end
	end
end

