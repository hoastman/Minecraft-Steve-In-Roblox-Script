-- Break / Place  (works on any part of the game)
--====================================================================
local function getTarget(pt)                           -- the block you look at. Water and Lava are skipped (you look / place / break THROUGH them);
	local ray = Workspace.CurrentCamera:ViewportPointToRay(pt.X, pt.Y)    -- only a Bucket in your hand can aim at them (UI.wantLiquid)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local skip = {player.Character}
	params.FilterDescendantsInstances = skip
	local hit
	for _ = 1, 16 do
		hit = Workspace:Raycast(ray.Origin, ray.Direction * 90, params)
		if not hit or UI.wantLiquid then break end
		local r = blockRoot(hit.Instance)
		local bd = r and BY_NAME[r:GetAttribute("BlockType") or ""]
		if bd and (bd.Liquid == "Water" or bd.Liquid == "Lava") then
			skip[#skip + 1] = r
			params.FilterDescendantsInstances = skip
		else
			break
		end
	end
	return hit
end

-- every block sits on a whole-number grid: 0, 4, 8, 12 ...  (never 1.173)
local function snap(v)
	return Vector3.new(math.round(v.X / BLOCK) * BLOCK + 0, math.round(v.Y / BLOCK) * BLOCK + 0, math.round(v.Z / BLOCK) * BLOCK + 0)
end

local function placePos(hit)
	-- the face you hit: the strongest axis of the normal (a slope can no longer push the block up AND sideways)
	local nx, ny, nz = hit.Normal.X, hit.Normal.Y, hit.Normal.Z
	local ax, ay, az = math.abs(nx), math.abs(ny), math.abs(nz)
	local n
	if ay >= ax and ay >= az then n = Vector3.new(0, ny >= 0 and 1 or -1, 0)
	elseif ax >= az then n = Vector3.new(nx >= 0 and 1 or -1, 0, 0)
	else n = Vector3.new(0, 0, nz >= 0 and 1 or -1) end
	local root = blockRoot(hit.Instance)
	if root and root:GetAttribute("RS") then return root:GetAttribute("RCell"), Vector3.yAxis end   -- clicking redstone dust / lever: the block goes into its cell
	if root then                                     -- next to another block
		return (root:GetAttribute("Cell") or snap(root:GetPivot().Position)) + n * BLOCK, n
	end
	local q = hit.Position + n * (BLOCK / 2)
	local p = snap(q)                                -- on a game part / terrain
	-- a block already close by decides the grid, so new blocks line up with it (same height, same columns)
	local near, nd
	UI.gridParams = UI.gridParams or OverlapParams.new()
	UI.gridParams.FilterType = Enum.RaycastFilterType.Include
	UI.gridParams.FilterDescendantsInstances = {folder}
	for _, part in ipairs(Workspace:GetPartBoundsInRadius(q, BLOCK * 3, UI.gridParams)) do
		local r = blockRoot(part)
		local cell = r and r:GetAttribute("Cell")
		if cell then
			local d = (cell - q).Magnitude
			if not nd or d < nd then near, nd = cell, d end
		end
	end
	if near then
		UI.gridY0 = UI.gridY0 or near.Y
		p = Vector3.new(near.X + math.round((q.X - near.X) / BLOCK) * BLOCK, near.Y + math.round((q.Y - near.Y) / BLOCK) * BLOCK,
			near.Z + math.round((q.Z - near.Z) / BLOCK) * BLOCK)
	elseif not UI.gridY0 then                        -- the very first block: it touches the floor / ceiling exactly (never floats up or sinks in)
		p = Vector3.new(p.X, n.Y ~= 0 and (hit.Position.Y + n.Y * (BLOCK / 2)) or p.Y, p.Z)
		UI.gridY0 = p.Y
	else                                             -- ONE height grid for the whole world: the first block sets it, every other block (even far away)
		p = Vector3.new(p.X, UI.gridY0 + math.round((q.Y - UI.gridY0) / BLOCK) * BLOCK, p.Z)   -- lines up with it (no more heights like 0.274 / 0.746)
	end
	return p, n
end

--====================================================================
-- Dropped items (survival): break a block -> it pops out, falls, spins,
-- and you pick it up by walking close to it
--====================================================================
local dropFolder = new("Folder", {Name = "LocalMCDrops"}, Workspace)
local drops = {}
local DROP_SIZE, PICKUP, MAGNET = 0.95, 4, 8
local dropParams = RaycastParams.new()
dropParams.FilterType = Enum.RaycastFilterType.Exclude

local function spawnDrop(pos, def, vel, count)
	local ic = (not def.IsBlock) and iconOf(def)
	local p, layers
	if ic then                                                      -- tools / items: a spinning 3D item (thin slices of the picture stacked = real thickness, like Minecraft)
		local W, SLICES, T = DROP_SIZE * 1.7, 8, 0.06
		p = new("Part", {Size = Vector3.new(W, W, SLICES * T), CFrame = CFrame.new(pos), Anchored = true, CanCollide = false,
			CanQuery = false, CanTouch = false, Transparency = 1}, dropFolder)
		layers = {}
		for l = 1, SLICES do
			local off = CFrame.new(0, 0, (l - (SLICES + 1) / 2) * T)
			local sl = new("Part", {Size = Vector3.new(W, W, T), CFrame = CFrame.new(pos) * off, Anchored = true, CanCollide = false,
				CanQuery = false, CanTouch = false, Transparency = 1}, p)
			local shade = (l == 1 or l == SLICES) and 1 or 0.6          -- the two outer slices are bright, the slices between are darker = the side of the item
			for _, face in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
				local sg = new("SurfaceGui", {Face = face, SizingMode = Enum.SurfaceGuiSizingMode.FixedSize, CanvasSize = Vector2.new(128, 128), LightInfluence = 0}, sl)
				new("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = ic, ImageColor3 = Color3.new(shade, shade, shade),
					ResampleMode = Enum.ResamplerMode.Pixelated}, sg)
			end
			layers[#layers + 1] = {part = sl, off = off}
		end
	end
	if not p then
	p = new("Part", {Size = Vector3.one * DROP_SIZE, CFrame = CFrame.new(pos), Anchored = true, CanCollide = false, CanQuery = false,
		CanTouch = false, Color = def.Color, Material = def.Material or Enum.Material.SmoothPlastic, Transparency = def.Clear and 1 or def.Transparency or 0,
		TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, dropFolder)
	for face, id in pairs(def.Texture or {}) do
		new("Decal", {Texture = id, Face = FACE[face], Color3 = def.Tint or WHITE, Transparency = def.Clear and 0.2 or 0}, p)
	end
	end
	drops[#drops + 1] = {part = p, layers = layers, name = def.Name, x = pos.X, y = pos.Y, z = pos.Z, vy = vel and vel.Y or 14, vx = vel and vel.X or 0, vz = vel and vel.Z or 0,
		count = count or 1, delay = vel and 1.3 or 0.6, born = os.clock(), spin = math.random() * 6}
end

-- DROP: Q drops 1 item (Ctrl + Q the whole stack), the DROP button drops 1, tapping outside an open screen drops what you carry
function UI.dropItem(name, count)
	local def, root = BY_NAME[name], getRoot()
	if not def or not root then return end
	local look = UI.look()
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.zAxis
	spawnDrop(root.Position + Vector3.new(0, 1.2, 0) + flat * 2, def, Vector3.new(flat.X * 16, 9, flat.Z * 16), count)
end
function UI.dropSelected(all)
	if panelOpen or chatOpen then return end
	local idx = 35 + selected
	local st = inv[idx]
	if not st then return end
	local name, n = st.name, all and st.count or 1
	st.count -= n
	if st.count <= 0 then inv[idx] = nil end
	render(idx)
	UI.dropItem(name, n)
end
function UI.dropCursor()
	if not cursor then return end
	local c = cursor
	cursor = nil
	renderCursor()
	UI.dropItem(c.name, c.count)
end
on(UI.modal.Activated, function() UI.dropCursor() end)

on(RS.Heartbeat, function(dt)
	if #drops == 0 then return end
	local root = getRoot()
	dropParams.FilterDescendantsInstances = {player.Character, dropFolder}
	local now = os.clock()
	for i = #drops, 1, -1 do
		local d = drops[i]
		local remove = d.part.Parent == nil or now - d.born > 300 or d.y < -500
		if not remove then
			if not d.landed then                                   -- pop up, then fall until we hit something
				d.vy -= 70 * dt
				d.x += d.vx * dt                                       -- thrown items fly forward while they fall...
				d.z += d.vz * dt
				local drag = math.max(0, 1 - 2.5 * dt)                 -- ...and slow down in the air
				d.vx *= drag
				d.vz *= drag
				local ny = d.y + d.vy * dt
				if d.vy < 0 then
					local hit = Workspace:Raycast(Vector3.new(d.x, d.y, d.z), Vector3.new(0, ny - d.y - DROP_SIZE / 2, 0), dropParams)
					if hit then
						d.landed, d.y, d.baseY = true, hit.Position.Y + DROP_SIZE / 2, hit.Position.Y + DROP_SIZE / 2
					else
						d.y = ny
					end
				else
					d.y = ny
				end
			end
			local py = d.landed and (d.baseY + 0.35 + math.sin(now * 3 + d.spin) * 0.2) or d.y
			if root then
				local dist = (root.Position - Vector3.new(d.x, py, d.z)).Magnitude
				if now - d.born > (d.delay or 0.6) then
					if dist < PICKUP then
						local left = give(d.name, d.count or 1)
						if left == 0 then remove = true else d.count = left end   -- (stays on the ground if your inventory is full)
					elseif dist < MAGNET and d.landed then          -- slide toward the player
						local dir = (root.Position - Vector3.new(d.x, d.baseY, d.z))
						dir = Vector3.new(dir.X, 0, dir.Z).Unit * 14 * dt
						d.x += dir.X
						d.z += dir.Z
					end
				end
			end
			if not remove then
				local cf = CFrame.new(d.x, py, d.z) * CFrame.Angles(0, now * 1.5 + d.spin, 0)
				d.part.CFrame = cf
				if d.layers then for _, L in ipairs(d.layers) do L.part.CFrame = cf * L.off end end
			end
		end
		if remove then
			pcall(function() d.part:Destroy() end)
			table.remove(drops, i)
		end
	end
end)

--====================================================================
-- XP ORBS (like Minecraft): breaking a block in survival pops out glowing green-yellow orbs. They bounce,
-- fly to you when you come close, and give XP with a little "pling".
--====================================================================
do
	local orbs = {}
	local ORB_PICKUP, ORB_MAGNET = 3, 10
	local SPLIT = {11, 7, 3, 1}

	function UI.spawnOrbs(pos, value)
		while value > 0 do
			local v = 1
			for _, sz in ipairs(SPLIT) do if value >= sz then v = sz break end end
			value -= v
			local size = 0.4 + 0.05 * v
			local part = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.one * size, Material = Enum.Material.Neon, Color = C(128, 255, 0),
				Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, CFrame = CFrame.new(pos)}, dropFolder)
			local light = new("PointLight", {Color = C(140, 255, 40), Range = 6, Brightness = 0.8}, part)
			local ang, spd = math.random() * math.pi * 2, 3 + math.random() * 6
			orbs[#orbs + 1] = {part = part, light = light, value = v, r = size / 2, x = pos.X, y = pos.Y, z = pos.Z,
				vx = math.cos(ang) * spd, vz = math.sin(ang) * spd, vy = 10 + math.random() * 5, born = os.clock(), seed = math.random() * 6}
		end
	end

	on(RS.Heartbeat, function(dt)
		if #orbs == 0 then return end
		local root = getRoot()
		dropParams.FilterDescendantsInstances = {player.Character, dropFolder}
		local now = os.clock()
		for i = #orbs, 1, -1 do
			local o = orbs[i]
			local remove = o.part.Parent == nil or now - o.born > 120 or o.y < -500
			if not remove then
				local age = now - o.born
				local pos = Vector3.new(o.x, o.y, o.z)
				local target = root and (root.Position + Vector3.new(0, 0.5, 0))
				if target and age > 0.35 and (o.pulling or (target - pos).Magnitude < ORB_MAGNET) then
					o.pulling = true
					o.pull = math.min((o.pull or 6) + 50 * dt, 45)               -- faster and faster, like in Minecraft
					local dir = target - pos
					if dir.Magnitude < ORB_PICKUP then
						UI.addXP(o.value)
						UI.playSound("rbxasset://sounds/electronicpingshort.wav", 1.1 + math.random() * 0.8, 0.3)   -- random pitch "pling"
						remove = true
					else
						local mv = dir.Unit * o.pull * dt
						o.x += mv.X o.y += mv.Y o.z += mv.Z
					end
				else
					o.vy -= 45 * dt
					o.x += o.vx * dt
					o.z += o.vz * dt
					local ny = o.y + o.vy * dt
					if o.vy < 0 then
						local hit = Workspace:Raycast(pos, Vector3.new(0, ny - o.y - o.r, 0), dropParams)
						if hit then
							o.y = hit.Position.Y + o.r
							o.vy = -o.vy * 0.45
							if o.vy < 3 then o.vy = 0 end
							o.vx *= 0.6
							o.vz *= 0.6
						else
							o.y = ny
						end
					else
						o.y = ny
					end
				end
				if not remove then
					-- the colour pulses between green and yellow (same maths as Minecraft's orb)
					local t = age * 5 + o.seed
					local col = Color3.new((math.sin(t) + 1) / 2, 1, (math.sin(t + 4 * math.pi / 3) + 1) * 0.1)
					o.part.Color = col
					o.light.Color = col
					o.part.Position = Vector3.new(o.x, o.y, o.z)
				end
			end
			if remove then
				pcall(function() o.part:Destroy() end)
				table.remove(orbs, i)
			end
		end
	end)
end

