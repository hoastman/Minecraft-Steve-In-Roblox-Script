local function click(i)
	local s = inv[i]
	if UI.opt.takeOne and not cursor and s then
		-- take just ONE item / block out of the stack (turn off in Options > Accessibility)
		cursor = {name = s.name, count = 1}
		s.count -= 1
		if s.count <= 0 then inv[i] = nil end
	elseif cursor and s and s.name == cursor.name then
		local add = math.min(cap(s.name) - s.count, cursor.count)
		s.count += add
		cursor.count -= add
		if cursor.count <= 0 then cursor = nil end
	elseif cursor and cursor.count > cap(cursor.name) then
		-- carrying more than one stack: put ONE stack down, keep the rest on the cursor
		if not s then
			local put = cap(cursor.name)
			inv[i] = {name = cursor.name, count = put}
			cursor.count -= put
		end
	else
		inv[i], cursor = cursor, s
	end
	render(i)
	renderCursor()
	if i <= 4 or (i >= 46 and i <= 55) then UI.refreshCraft() end
	if UI.bookRefresh then UI.bookRefresh() end
end

