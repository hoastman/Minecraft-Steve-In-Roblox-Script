env.MCCleanup = function()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	pcall(function()
		if MV.hum then
			if MV.base then MV.hum.WalkSpeed = MV.base end
			MV.hum.CameraOffset -= Vector3.new(0, MV.camY, 0)
			Workspace.CurrentCamera.FieldOfView -= MV.fov
		end
	end)
	pcall(function() RS:UnbindFromRenderStep("MCFrontRestore") end)
	pcall(function() RS:UnbindFromRenderStep("MCFrontMirror") end)
	pcall(function() RS:UnbindFromRenderStep("MCSneakEdge") end)
	pcall(function() if UI.sneakPad then UI.sneakPad:Destroy() end end)
	pcall(function()
		player.CameraMinZoomDistance = UI.origMin
		player.CameraMaxZoomDistance = UI.origMax
	end)
	pcall(function() Workspace.CurrentCamera.FieldOfView = UI.origFov end)
	pcall(function() game:GetService("Lighting").GlobalShadows = UI.origShadows end)
	pcall(function()
		UI.opt.acc = true
		UI.opt.hideBody = false
		UI.opt.steve = false
		if UI.showJump then UI.showJump() end
		UI.unsteve()
		UI.resetHead()
		UI.flying = false
		local fr = getRoot()                              -- remove the anti-gravity force
		if fr then
			for _, o in ipairs(fr:GetChildren()) do
				if o.Name == "MCFlyForce" or o.Name == "MCFlyAt" then o:Destroy() end
			end
		end
		if UI.heldF then UI.heldF:Destroy() end
		UI.applySkin()
	end)
	pcall(function() gui:Destroy() end)
	pcall(function() UI.handGui:Destroy() end)
	pcall(function() folder:Destroy() end)
	pcall(function() dropFolder:Destroy() end)
	pcall(function() SG:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true) end)
	pcall(function() SG:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true) end)
	pcall(function() TCS.ChatWindowConfiguration.Enabled = true end)
	pcall(function() TCS.ChatInputBarConfiguration.Enabled = true end)
end

