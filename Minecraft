-- HOLD a slot (about 0.7 sec) -> the item / block in it disappears
local HOLD_DELETE = 0.7
local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
local function holdDelete(btn, i)
	local st, token = {deleted = false}, 0
	on(btn.InputBegan, function(input)
		if not isPress(input) then return end
		st.deleted = false
		token += 1
		local my = token
		task.delay(HOLD_DELETE, function()
			if token == my and inv[i] and not cursor then
				inv[i] = nil
				st.deleted = true      -- the tap that ends this hold must not also pick things up
				render(i)
				if i <= 4 or (i >= 46 and i <= 55) then UI.refreshCraft() end
			end
		end)
	end)
	on(btn.InputEnded, function(input) if isPress(input) then token += 1 end end)
	return st
end

-- 3D block icon (isometric cube like the Minecraft inventory), built from the block's textures
local function fillCube(vf, d)
	if vf:GetAttribute("def") == d.Name then return end
	vf:SetAttribute("def", d.Name)
	vf:ClearAllChildren()
	if d.Shape then
		local sc = d.Shape == "Door" and 0.55 or 1                      -- a door is 2 blocks tall: draw it smaller so it fits
		buildShape(d, sc, CFrame.new(0, d.Shape == "Door" and -sc / 2 or 0, 0), vf, false)
	else
		local p = new("Part", {Size = Vector3.one, Anchored = true, Color = d.Color, Material = d.Material or Enum.Material.SmoothPlastic,
			Transparency = d.Clear and 1 or d.Transparency or 0}, vf)
		for face, id in pairs(d.Texture) do new("Decal", {Texture = id, Face = FACE[face], Color3 = d.Tint or WHITE, Transparency = d.Clear and 0.2 or 0}, p) end
	end
	-- normal slots: isometric cube (top + 2 sides).  Carried blocks (hand / dragged): only the side + front faces.
	local sv, hvw = vf:GetAttribute("sv"), vf:GetAttribute("hv")
	local dir = hvw and UI.heldDir or (sv and Vector3.new(-1, 0, -1) or Vector3.new(-1, 1, -1))
	vf.CurrentCamera = new("Camera", {FieldOfView = hvw and 24 or 20,
		CFrame = CFrame.lookAt(dir.Unit * (hvw and 5 or (sv and 4.6 or 6)), Vector3.zero)}, vf)
end

-- an icon = flat image (tools / food) + 3D cube (blocks); only one is shown
local function mkIcon(parent, z, sideView)
	local ico = new("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ResampleMode = Enum.ResamplerMode.Pixelated, ZIndex = z}, parent)
	local vf = new("ViewportFrame", {Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0), BackgroundTransparency = 1,
		Visible = false, ZIndex = z, Ambient = C(170, 170, 170), LightColor = WHITE, LightDirection = Vector3.new(-0.6, -1, -0.4)}, parent)
	if sideView == "held" then vf:SetAttribute("hv", true) elseif sideView then vf:SetAttribute("sv", true) end
	return {ico = ico, vf = vf}
end

local function setIcon(o, d)
	if d and d.IsBlock then
		o.ico.Image = ""
		o.vf.Visible = true
		fillCube(o.vf, d)
	else
		o.vf.Visible = false
		o.ico.Image = (d and iconOf(d)) or ""
	end
end

