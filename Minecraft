local armIsDown
function updateHand()
	local s = inv[35 + selected]
	local d = s and BY_NAME[s.name]
	held.Visible = d ~= nil
	local down = d ~= nil and d.IsBlock == true   -- blocks: arm moves down, only the block shows. Tools / items: the hand stays and holds them
	if down ~= armIsDown then
		armIsDown = down
		TweenService:Create(arm, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = down and ARM_DOWN or ARM_UP}):Play()
	end
	if d then
		held.BackgroundColor3 = d.Color
		held.BackgroundTransparency = bgT(d)
		if d.IsBlock then                                                          -- blocks sit turned a little, like Minecraft
			held.Rotation, held.Size, held.Position = -6, UI.HELD_SIZE, UI.HELD_POS
		else                                                                       -- tools: big, handle at the bottom right, blade up-left (like Minecraft)
			held.Rotation, held.Size, held.Position = UI.TOOL_ROT, UI.TOOL_SIZE, UI.TOOL_POS
		end
		setIcon(heldIc, d)
		heldLbl.Text = (not d.IsBlock and not iconOf(d)) and d.Name or ""
	end
	local o = inv[45]                                                              -- the off hand (shield...) on the left of the screen
	local od = o and BY_NAME[o.name]
	UI.offF.Visible = od ~= nil and UI.persp == 0
	if od then
		UI.offF.BackgroundColor3, UI.offF.BackgroundTransparency = od.Color, bgT(od)
		UI.offF.Rotation = od.IsBlock and 8 or UI.OFF_ROT
		setIcon(UI.offIc, od)
		UI.offLbl.Text = (not od.IsBlock and not iconOf(od)) and od.Name or ""
	end
	if UI.hold3D then UI.hold3D() end
end

