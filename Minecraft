	return cf.LookVector
end
function UI.axis()                                  -- that direction snapped to north / south / east / west
	local look = UI.look()
	if math.abs(look.X) > math.abs(look.Z) then return Vector3.new(look.X > 0 and 1 or -1, 0, 0) end
	return Vector3.new(0, 0, look.Z > 0 and 1 or -1)
end

-- creative list order (like Minecraft):  Oak Planks, Oak Planks Slab, Oak Planks Stairs, Oak Fence, Oak Fence Gate
do
	local rank = {Slab = 1, Stairs = 2, Fence = 3, FenceGate = 4}
	local variants, rest = {}, {}
	for _, d in ipairs(ITEMS) do
		if d.Base and BY_NAME[d.Base] and rank[d.Shape] then
			variants[d.Base] = variants[d.Base] or {}
			table.insert(variants[d.Base], d)
		else
			rest[#rest + 1] = d
		end
	end
	for _, list in pairs(variants) do table.sort(list, function(a, b) return rank[a.Shape] < rank[b.Shape] end) end
	table.clear(ITEMS)
	for _, d in ipairs(rest) do
		ITEMS[#ITEMS + 1] = d
		for _, v in ipairs(variants[d.Name] or {}) do ITEMS[#ITEMS + 1] = v end
	end
end

-- how a block is turned when placed
local function blockCFrame(pos, def, n, r)
	if def.Pillar and n then                         -- logs: top follows the face you clicked
		local x = (math.abs(n.Y) > 0.5) and Vector3.xAxis or Vector3.yAxis:Cross(n)
		return CFrame.fromMatrix(pos, x, n, x:Cross(n))
	end
	if def.Facing then                                -- furnace / chest: the Front face looks back at you
		return CFrame.lookAt(pos, pos - UI.axis())
	end
	return CFrame.new(pos)                           -- every other block: fixed, never turns to the camera
end

-- slab = 1 flat box, stairs = 2 boxes (a Model). Textures are TILED so the half-height sides are cropped, not squashed.
-- cf = centre of the block's cell. flip = upside-down (top half). Stairs go up toward local +Z.
local function buildShape(d, S, cf, parent, flip)
	local h = S / 2
	local function box(size, off, name, par)
		local p = new("Part", {Name = name, Size = size, CFrame = cf * CFrame.new(off), Anchored = true, Color = d.Color,
			Material = d.Material or Enum.Material.SmoothPlastic, Transparency = d.Clear and 1 or d.Transparency or 0,
			TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, nil)
		for face, id in pairs(d.Texture) do
			new("Texture", {Texture = id, Face = FACE[face], StudsPerTileU = S, StudsPerTileV = (d.Shape == "Door" and (face == "Front" or face == "Back")) and S * 2 or S,
				Color3 = d.Tint or WHITE, Transparency = d.Clear and 0.2 or 0}, p)
		end
		p.Parent = par
		return p
	end
	local y = flip and h / 2 or -h / 2
	if d.Shape == "Door" then                         -- 2 blocks tall thin panel, flush with the FRONT edge of the block (toward you)
		return box(Vector3.new(S, S * 2, S * 0.18), Vector3.new(0, S / 2, -S / 2 + S * 0.09), "Door", parent)
	end
	local u = S / 16                                  -- one "pixel" of a 16x16 block
	local zc = 0                                      -- fence / gate: in the MIDDLE of the block
	if d.Shape == "Fence" then                        -- a post + two rails across the block
		local m = new("Model", {Name = "Fence"}, nil)
		box(Vector3.new(4 * u, S, 4 * u), Vector3.new(0, 0, zc), "Post", m)
		for _, ry in ipairs({-0.5 * u, 5.5 * u}) do
			box(Vector3.new(S, 3 * u, 2 * u), Vector3.new(0, ry, zc), "Rail", m)
		end
		m.WorldPivot = cf
		m.Parent = parent
		return m
	end
	if d.Shape == "FenceGate" then                    -- two posts + two leaves; right-click turns each leaf 90 degrees around its post
		local m = new("Model", {Name = "FenceGate"}, nil)
		for _, side in ipairs({-1, 1}) do
			box(Vector3.new(2 * u, 11 * u, 4 * u), Vector3.new(side * 7 * u, 2.5 * u, zc), "Post", m)
			local half = new("Model", {Name = side < 0 and "HalfL" or "HalfR"}, nil)
			for _, ry in ipairs({-0.5 * u, 5.5 * u}) do
				box(Vector3.new(6 * u, 3 * u, 2 * u), Vector3.new(side * 3 * u, ry, zc), "Rail", half)
			end
			box(Vector3.new(2 * u, 9 * u, 2 * u), Vector3.new(side * u, 2.5 * u, zc), "Stile", half)
			half.WorldPivot = cf * CFrame.new(side * 7 * u, 0, zc)
			half.Parent = m
		end
		m.WorldPivot = cf
		m.Parent = parent
		return m
	end
	if d.Shape == "Slab" then
		return box(Vector3.new(S, h, S), Vector3.new(0, y, 0), "Slab", parent)
	end
	local m = new("Model", {Name = "Stairs"}, nil)
	box(Vector3.new(S, h, S), Vector3.new(0, y, 0), "Base", m)
	box(Vector3.new(S, h, h), Vector3.new(0, -y, h / 2), "Step", m)
	m.WorldPivot = cf
	m.Parent = parent
	return m
end

-- the block (Part or stairs Model) that a hit part belongs to; nil if it is not one of our blocks
local function blockRoot(inst)
	while inst and inst.Parent do
		if inst.Parent == folder then return inst end
		inst = inst.Parent
	end
end

local function makeBlock(pos, def, n, r, flip, face)
	local root
	if def.Shape then
		local cf = face and CFrame.lookAt(pos, pos - face) or CFrame.new(pos)
		root = buildShape(def, BLOCK, cf, folder, flip)
	else
		root = new("Part", {Size = Vector3.new(BLOCK, BLOCK, BLOCK), CFrame = blockCFrame(pos, def, n, r), Anchored = true,
			Color = def.Color, Material = def.Material or Enum.Material.SmoothPlastic, Transparency = def.Clear and 1 or def.Transparency or 0,
			TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, folder)
		for f, id in pairs(def.Texture) do
			new("Decal", {Texture = id, Face = FACE[f], Color3 = def.Tint or WHITE, Transparency = def.Clear and 0.2 or 0}, root)
		end
	end
	root:SetAttribute("BlockType", def.Name)
	root:SetAttribute("Cell", pos)                 -- the grid cell it sits in (slabs only fill half of it)
	root:SetAttribute("Flip", flip and true or false)
	if def.Shape == "Door" or def.Shape == "FenceGate" then root:SetAttribute("Open", false) root:SetAttribute("Face", face or Vector3.zAxis) end
	return root
end

