		elseif name == "Lever" then
			root = new("Part", {Size = Vector3.new(BLOCK * 0.5, 0.22, BLOCK * 0.32), CFrame = CFrame.new(cpos.X, fy + 0.11, cpos.Z), Anchored = true,
				CanCollide = false, Color = C(120, 120, 120)}, folder)
			new("Part", {Name = "Stick", Size = Vector3.new(0.22, BLOCK * 0.55, 0.22), Anchored = true, CanCollide = false, Color = WOOD}, root)
			root:SetAttribute("RS", "Lever")
			root:SetAttribute("On", false)
		elseif name == "Pressure Plate" then
			root = new("Part", {Size = Vector3.new(BLOCK * 0.8, 0.14, BLOCK * 0.8), CFrame = CFrame.new(cpos.X, fy + 0.07, cpos.Z), Anchored = true,
				CanCollide = false, Color = C(125, 125, 125), Material = Enum.Material.Slate}, folder)
			root:SetAttribute("RS", "Plate")
			root:SetAttribute("On", false)
			UI.plates = UI.plates or {}
			table.insert(UI.plates, root)
		else
			root = new("Part", {Size = Vector3.new(BLOCK * 0.4, 0.4, BLOCK * 0.3), CFrame = CFrame.new(cpos.X, fy + 0.2, cpos.Z), Anchored = true,
				CanCollide = false, Color = C(125, 125, 125)}, folder)
			root:SetAttribute("RS", "Button")
			root:SetAttribute("On", false)
		end
		root:SetAttribute("BlockType", name)
		root:SetAttribute("RCell", cpos)
		UI.rsLook(root)
		UI.rsDirty()
		return true
	end

	function UI.rsUse(root)
		local t = root:GetAttribute("RS")
		if t == "Lever" then
			root:SetAttribute("On", not root:GetAttribute("On"))
			UI.rsLook(root)
			UI.playSound("rbxasset://sounds/electronicpingshort.wav", root:GetAttribute("On") and 1.7 or 1.2, 0.4)
		elseif t == "Button" then
			if root:GetAttribute("On") then return end
			root:SetAttribute("On", true)
			UI.rsLook(root)
			UI.playSound("rbxasset://sounds/electronicpingshort.wav", 1.7, 0.4)
			task.delay(1.2, function()
				if root.Parent then root:SetAttribute("On", false) UI.rsLook(root) UI.rsDirty() end
			end)
		else
			return
		end
		UI.rsDirty()
	end

	local function setLamp(b, lit)
		if b:GetAttribute("Lit") == lit then return end
		b:SetAttribute("Lit", lit)
		if lit then
			b.Material = Enum.Material.Neon
			b.Color = C(255, 205, 110)
			new("PointLight", {Name = "RSLight", Range = 16, Brightness = 1.2, Color = C(255, 210, 120)}, b)
		else
			local def = BY_NAME["Redstone Lamp"]
			b.Material = (def and def.Material) or Enum.Material.Glass
			b.Color = def and def.Color or C(215, 165, 85)
			local l = b:FindFirstChild("RSLight")
			if l then l:Destroy() end
		end
	end

	function UI.rsUpdate()
		local dust, conn, srcK, sources, lamps, tnts = {}, {}, {}, {}, {}, {}
		local pistons, doors = {}, {}
		for _, b in ipairs(folder:GetChildren()) do
			local c = cellOf(b)
			if c then
				local t, bt, k = b:GetAttribute("RS"), b:GetAttribute("BlockType"), key(c)
				if t == "Dust" then
					dust[k] = b conn[k] = true
				elseif t == "Lever" or t == "Button" or t == "Plate" then
					conn[k] = true
					if b:GetAttribute("On") then sources[#sources + 1] = c srcK[k] = true end
				elseif bt == "Redstone Block" then
					conn[k] = true sources[#sources + 1] = c srcK[k] = true
				elseif bt == "Redstone Lamp" then
					conn[k] = true lamps[#lamps + 1] = b
				elseif bt == "TNT" then
					conn[k] = true tnts[#tnts + 1] = b
				elseif bt and BY_NAME[bt] and BY_NAME[bt].Shape == "Piston" then
					conn[k] = true pistons[#pistons + 1] = b
				elseif bt and BY_NAME[bt] and (BY_NAME[bt].Shape == "Door" or BY_NAME[bt].Shape == "Trapdoor" or BY_NAME[bt].Shape == "FenceGate") then
					doors[#doors + 1] = b
				end
			end
		end
		-- power flows from every source through the dust, weaker with every block
		local pw, queue, qi = {}, {}, 1
		local function feed(pos, s)
			local k = key(pos)
			if dust[k] and (pw[k] or 0) < s then
				pw[k] = s
				queue[#queue + 1] = {pos, s}
			end
		end
		for _, sp in ipairs(sources) do
			for _, dv in ipairs(NEIGHBORS) do feed(sp + dv * BLOCK, 15) end
		end
		while queue[qi] do
			local pos, s = queue[qi][1], queue[qi][2]
			qi += 1
			if s > 1 and pw[key(pos)] == s then
				for _, dv in ipairs(H4) do
					for _, dy in ipairs({0, 1, -1}) do feed(pos + dv * BLOCK + UP * (dy * BLOCK), s - 1) end
				end
			end
		end
		local function powered(c)
			for _, dv in ipairs(NEIGHBORS) do
				local k = key(c + dv * BLOCK)
				if pw[k] or srcK[k] then return true end
			end
			return false
		end
		for _, b in ipairs(lamps) do setLamp(b, powered(cellOf(b))) end
		for _, b in ipairs(tnts) do
			if powered(cellOf(b)) then UI.igniteTNT(b) end
		end
		for _, b in ipairs(doors) do                          -- doors / trapdoors / fence gates open when powered and close when the power stops
			local d = BY_NAME[b:GetAttribute("BlockType") or ""]
			local c = cellOf(b)
			local on = powered(c) or (d.Shape == "Door" and powered(c + UP * BLOCK))     -- a door is 2 blocks tall
			if on ~= (b:GetAttribute("RSPow") or false) then
				b:SetAttribute("RSPow", on)
				if (b:GetAttribute("Open") or false) ~= on then
					if d.Shape == "Door" then UI.toggleDoor(b) elseif d.Shape == "Trapdoor" then UI.toggleTrapdoor(b) else UI.toggleGate(b) end
					UI.playSound("rbxasset://sounds/electronicpingshort.wav", on and 1.4 or 1.0, 0.35)
				end
			end
		end
		for _, b in ipairs(pistons) do                        -- pistons: powered from any side except the front
			local dir = -(b:GetAttribute("Face") or Vector3.zAxis)
			local c, on = cellOf(b), false
			for _, dv in ipairs(NEIGHBORS) do
				if dv:Dot(dir) < 0.9 then
					local k = key(c + dv * BLOCK)
					if pw[k] or srcK[k] then on = true break end
				end
			end
			UI.pistonSet(b, on)
		end
		-- look of the dust: dark red = off, bright glowing red = powered, little arms toward everything it touches
		for k, b in pairs(dust) do
			local s = pw[k] or 0
			local col = s > 0 and C(70 + 12 * s, 0, 0) or C(70, 0, 0)
			local mat = s > 0 and Enum.Material.Neon or Enum.Material.SmoothPlastic
			b.Color, b.Material = col, mat
			local c = cellOf(b)
			for i, dv in ipairs(H4) do
				local arm = b:FindFirstChild("Arm" .. i)
				if arm then
					local p = c + dv * BLOCK
					local touch = conn[key(p)] or conn[key(p + UP * BLOCK)] or conn[key(p - UP * BLOCK)]
					arm.Transparency = touch and 0 or 1
					arm.Color, arm.Material = col, mat
				end
			end
		end
	end

	-- PISTONS: a powered Piston pushes the blocks in front of its head (up to 12 in a row). Immovable: Obsidian, extended pistons, doors.
	-- Water / Lava / Fire / redstone dust in the way are destroyed. A STICKY Piston also pulls the block in front of its head back
	-- when the power stops. Pistons need power from any side except the front. The head faces YOU when you place it.
	local function worldSolid(p)                              -- terrain / game parts (not blocks) in this cell
		for _, part in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(p), Vector3.one * (BLOCK - 0.5))) do
			if not blockRoot(part) and part.CanCollide and not part:IsDescendantOf(dropFolder) then
				local m = part:FindFirstAncestorOfClass("Model")
				if not (m and m:FindFirstChildOfClass("Humanoid")) then return true end
			end
		end
		return false
	end
	local function immovable(r)
		local bt = r:GetAttribute("BlockType") or ""
		local d = BY_NAME[bt]
		if r:GetAttribute("Extended") or (d and d.Shape == "Door") then return true end
		return UI.blockStats(bt).res >= 1000                  -- Obsidian
	end
	local function replaceable(r)                             -- destroyed when something is pushed into it
		local d = BY_NAME[r:GetAttribute("BlockType") or ""]
		return r:GetAttribute("RS") ~= nil or (d ~= nil and d.Liquid ~= nil)
	end
	local function clearCell(p)
		for _, b in ipairs(folder:GetChildren()) do
			local c = b:GetAttribute("RCell") or b:GetAttribute("Cell")
			if c and (c - p).Magnitude < 0.5 and replaceable(b) then b:Destroy() end
		end
	end
	local function chain(from, dir)                           -- the blocks that would be pushed, or nil if something stops it
		local list, p = {}, from
		for _ = 1, 13 do
			local r = UI.rootAt(p)
			if not r then
				if worldSolid(p) then return nil end
				return list
			end
			if replaceable(r) then return list end
			if immovable(r) then return nil end
			list[#list + 1] = r
			if #list > 12 then return nil end
			p = p + dir * BLOCK
		end
		return nil
	end
	local function shift(r, v)
		r:SetAttribute("Cell", r:GetAttribute("Cell") + v)
		if r:IsA("Model") then r:PivotTo(r:GetPivot() + v) else r.CFrame = r.CFrame + v end
	end
	local function pushPlayer(cells, v)                       -- you are pushed too (standing on a pushed block / in front of the head)
		local root = getRoot()
		if not root then return end
		for _, c in ipairs(cells) do
			local d = root.Position - c
			if math.abs(d.X) < BLOCK * 0.6 and math.abs(d.Z) < BLOCK * 0.6 and d.Y > -BLOCK / 2 - 0.5 and d.Y < BLOCK / 2 + 3.5 then
				root.CFrame = root.CFrame + v
				return
			end
		end
	end
	local function setHead(root, ext)
		local cf = root:GetPivot()
		local head, rod = root:FindFirstChild("Head"), root:FindFirstChild("Rod")
		if head then head.CFrame = cf * CFrame.new(0, 0, ext and (-1.375 * BLOCK) or (-0.375 * BLOCK)) end
		if rod then
			rod.Transparency = ext and 0 or 1
			rod.CanCollide, rod.CanQuery, rod.CanTouch = ext, ext, ext
		end
	end
	local function pdir(b) return -(b:GetAttribute("Face") or Vector3.zAxis) end

	function UI.pistonExtend(b)
		local dir = pdir(b)
		local front = b:GetAttribute("Cell") + dir * BLOCK
		local list = chain(front, dir)
		if not list then return false end                      -- too many blocks / something that can not move
		local cells = {front}
		for _, r in ipairs(list) do cells[#cells + 1] = r:GetAttribute("Cell") end
		clearCell(front + dir * (#list * BLOCK))
		for i = #list, 1, -1 do shift(list[i], dir * BLOCK) end
		pushPlayer(cells, dir * BLOCK)
		b:SetAttribute("Extended", true)
		b:SetAttribute("HeadCell", front)
		setHead(b, true)
		for _, c in ipairs(cells) do
			UI.refreshFences(c)
			UI.refreshFences(c + dir * BLOCK)
			UI.fluidPoke(c)
		end
		UI.playSound("rbxasset://sounds/electronicpingshort.wav", 0.5, 0.5)
		return true
	end

	function UI.pistonRetract(b)
		local dir = pdir(b)
		local cell = b:GetAttribute("Cell")
		b:SetAttribute("Extended", false)
		b:SetAttribute("HeadCell", nil)
		setHead(b, false)
		local d = BY_NAME[b:GetAttribute("BlockType") or ""]
		if d and d.Sticky then                                 -- Sticky Piston: pulls the block in front of its head back
			local r = UI.rootAt(cell + dir * (BLOCK * 2))
			if r and not replaceable(r) and not immovable(r) then
				shift(r, -dir * BLOCK)
				UI.refreshFences(cell + dir * (BLOCK * 2))
				UI.refreshFences(cell + dir * BLOCK)
			end
		end
		UI.fluidPoke(cell + dir * BLOCK)
		UI.playSound("rbxasset://sounds/electronicpingshort.wav", 0.4, 0.5)
	end

	function UI.pistonSet(b, on)                               -- called by the redstone update: extend when powered, retract when not
		if b:GetAttribute("Busy") then return end
		if on == (b:GetAttribute("Extended") or false) then return end
		b:SetAttribute("Busy", true)
		task.delay(0.15, function()                            -- (a little delay like in Minecraft)
			if b.Parent then
				if on then UI.pistonExtend(b) else UI.pistonRetract(b) end
				b:SetAttribute("Busy", false)
			end
			UI.rsDirty()
		end)
	end

	function UI.rsDirty()
		if UI.rsPending then return end
		UI.rsPending = true
		task.defer(function()
			UI.rsPending = false
			local ok, err = pcall(UI.rsUpdate)
			if not ok then warn("redstone: " .. tostring(err)) end
		end)
	end

	-- PRESSURE PLATE: on while you stand on it
	local plateT = 0
	on(RS.Heartbeat, function(dt)
		plateT += dt
		if plateT < 0.1 or not UI.plates then return end
		plateT = 0
		local root = getRoot()
		for i = #UI.plates, 1, -1 do
			local p = UI.plates[i]
			if not p.Parent then
				table.remove(UI.plates, i)
			else
				local c = p:GetAttribute("RCell")
				local pressed = false
				if root and c then
					local d = root.Position - c
					pressed = math.abs(d.X) < BLOCK * 0.45 and math.abs(d.Z) < BLOCK * 0.45 and d.Y > -BLOCK / 2 and d.Y < BLOCK / 2 + 4
				end
				if pressed ~= (p:GetAttribute("On") or false) then
					p:SetAttribute("On", pressed)
					UI.rsLook(p)
					UI.playSound("rbxasset://sounds/electronicpingshort.wav", pressed and 1.5 or 1.1, 0.4)
					UI.rsDirty()
				end
			end
		end
	end)
end

--====================================================================
-- NETHER PORTAL: build a frame of Obsidian (at least 4 wide and 5 tall, the corners are not needed), then light the inside with
-- Flint and Steel. Walk into the purple portal and wait: you go to the Nether. Walk into a portal there to come back.
-- (the Nether is a closed cave with lava lakes and glowstone; it is only built the first time you go there)
--====================================================================
do
	local S = BLOCK
	local UP = Vector3.yAxis
	local Lighting = game:GetService("Lighting")
	UI.portals = {}
	local function isObs(p)
		local b = blockAtCell(p)
		return b ~= nil and b:GetAttribute("BlockType") == "Obsidian"
	end
	local function isEmpty(p)
		local b = blockAtCell(p)
		return b == nil or b:GetAttribute("BlockType") == "Fire"
	end

	function UI.createPortal(l, ax, w, h)          -- l = lowest inside cell at the left end, ax = direction along the frame
		local center = l + ax * ((w - 1) / 2 * S) + UP * ((h - 1) / 2 * S)
		for _, pt in ipairs(UI.portals) do
			if (pt.center - center).Magnitude < 1 then return pt end
		end
		local normal = ax == Vector3.xAxis and Vector3.zAxis or Vector3.xAxis
		local size = ax == Vector3.xAxis and Vector3.new(w * S, h * S, 0.5) or Vector3.new(0.5, h * S, w * S)
		local part = new("Part", {Size = size, CFrame = CFrame.new(center), Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
			Material = Enum.Material.Neon, Color = C(140, 40, 220), Transparency = 0.4, CastShadow = false}, dropFolder)
		new("PointLight", {Color = C(170, 80, 255), Range = 18, Brightness = 1.5}, part)
		new("ParticleEmitter", {Color = ColorSequence.new(C(205, 130, 255)), Rate = 30, Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(0.5, 2),
			Size = NumberSequence.new(0.5, 0), LightEmission = 1, Transparency = NumberSequence.new(0.2, 1), SpreadAngle = Vector2.new(180, 180),
			Rotation = NumberRange.new(0, 360)}, part)
		local cells = {}
		for i = -1, w do
			for j = -1, h do
				local border = i == -1 or i == w or j == -1 or j == h
				local corner = (i == -1 or i == w) and (j == -1 or j == h)
				if border and not corner then cells[#cells + 1] = l + ax * (i * S) + UP * (j * S) end
			end
		end
		local exit = Vector3.new(center.X, l.Y - S / 2 + 3.2, center.Z) + normal * (S * 2.2)
		local pt = {part = part, cells = cells, exit = exit, center = center, born = os.clock()}
		UI.portals[#UI.portals + 1] = pt
		UI.playSound("rbxasset://sounds/electronicpingshort.wav", 0.5, 0.6)
		return pt
	end

	-- is the cell `start` the inside of an obsidian frame?  (tries a frame along X and along Z)
	function UI.tryPortal(start)
		for _, ax in ipairs({Vector3.xAxis, Vector3.zAxis}) do
			local c, n = start, 0
			while isEmpty(c) and n < 22 do c = c - UP * S n += 1 end
			if n >= 1 and isObs(c) then
				local l, cnt = c + UP * S, 0
				while isEmpty(l - ax * S) and cnt < 22 do l = l - ax * S cnt += 1 end
				if isObs(l - ax * S) then
					local w, r = 1, l
					while isEmpty(r + ax * S) and w < 22 do r = r + ax * S w += 1 end
					local h = 0
					while isEmpty(l + UP * (h * S)) and h < 22 do h += 1 end
					if w >= 2 and h >= 3 and isObs(r + ax * S) and isObs(l + UP * (h * S)) then
						local ok = true
						for i = 0, w - 1 do
							if not isObs(l + ax * (i * S) - UP * S) or not isObs(l + ax * (i * S) + UP * (h * S)) then ok = false break end
							for j = 0, h - 1 do
								if not isEmpty(l + ax * (i * S) + UP * (j * S)) then ok = false break end
							end
							if not ok then break end
						end
						if ok then
							for j = 0, h - 1 do
								if not isObs(l - ax * S + UP * (j * S)) or not isObs(l + ax * (w * S) + UP * (j * S)) then ok = false break end
							end
						end
						if ok then
							UI.createPortal(l, ax, w, h)
							return true
						end
					end
				end
			end
		end
		return false
	end

	-- THE NETHER
	function UI.buildNether()
		local f = new("Folder", {Name = "LocalMCNether"}, Workspace)
		UI.netherFolder = f
		local NO = Vector3.new(0, 1500, 0)                 -- the floor of the Nether (top of the base slab under the blocks)
		local rng = Random.new(77)
		local N = 22                                       -- the cave is 45 x 45 blocks big
		local W = (N + 1) * S
		local function slab(size, pos, color, mat)
			return new("Part", {Size = size, CFrame = CFrame.new(pos), Anchored = true, Color = color, Material = mat or Enum.Material.Slate,
				TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, f)
		end
		slab(Vector3.new(2 * W + 40, 20, 2 * W + 40), NO + Vector3.new(0, -10, 0), C(112, 48, 48))        -- base (under the blocks)
		slab(Vector3.new(2 * W + 40, 20, 2 * W + 40), NO + Vector3.new(0, 80, 0), C(60, 28, 28))          -- ceiling (its bottom is at 70)
		slab(Vector3.new(20, 110, 2 * W + 40), NO + Vector3.new(W + 10, 40, 0), C(80, 34, 34))            -- walls
		slab(Vector3.new(20, 110, 2 * W + 40), NO + Vector3.new(-W - 10, 40, 0), C(80, 34, 34))
		slab(Vector3.new(2 * W + 40, 110, 20), NO + Vector3.new(0, 40, W + 10), C(80, 34, 34))
		slab(Vector3.new(2 * W + 40, 110, 20), NO + Vector3.new(0, 40, -W - 10), C(80, 34, 34))
		for _ = 1, 16 do                                                                                   -- stalactites from the ceiling
			local x, z, w, h = rng:NextNumber(-W, W), rng:NextNumber(-W, W), rng:NextNumber(4, 10), rng:NextNumber(6, 26)
			slab(Vector3.new(w, h, w), NO + Vector3.new(x, 70 - h / 2, z), C(95, 40, 40))
		end
		for _ = 1, 8 do                                                                                    -- glowstone that lights the cave
			local g = slab(Vector3.new(5, 5, 5), NO + Vector3.new(rng:NextNumber(-W, W), 67.5, rng:NextNumber(-W, W)), C(255, 205, 110), Enum.Material.Neon)
			new("PointLight", {Color = C(255, 200, 110), Range = 55, Brightness = 2}, g)
		end

		-- THE MAP: real Nether blocks (Netherrack, Soul Sand, Nether Bricks, Lava)
		local root = getRoot()
		local nr, ss, nb, lava, obs = BY_NAME["Netherrack"], BY_NAME["Soul Sand"], BY_NAME["Nether Bricks"], BY_NAME["Lava"], BY_NAME["Obsidian"]
		local seed = rng:NextNumber(0, 100)
		local function noise(i, j) return math.noise(i * 0.11, j * 0.11, seed) + 0.5 * math.noise(i * 0.27 + 40, j * 0.27 + 40, seed) end
		local function flat(i, j) return math.abs(i) <= 6 and math.abs(j) <= 6 end        -- flat place around the portal
		local function isLava(i, j) return lava ~= nil and not flat(i, j) and noise(i, j) < -0.32 end
		local function height(i, j)
			if flat(i, j) or isLava(i, j) then return 1 end
			return math.clamp(math.floor(2.4 + noise(i, j) * 5), 1, 7)
		end
		local oldFence = UI.hasFence
		UI.hasFence = false                                -- (thousands of blocks: no fence updates meanwhile)
		UI.fluidBusy = true
		local count = 0
		local function put(def, pos)
			if def then makeBlock(pos, def, UP, root, false, nil) end
			count += 1
			if count % 150 == 0 then RS.Heartbeat:Wait() end   -- (a little pause now and then so the game does not freeze)
		end
		for i = -N, N do
			for j = -N, N do
				if isLava(i, j) then
					put(lava, Vector3.new(i * S, NO.Y + 0.5 * S, j * S))
				else
					local h = height(i, j)
					local lo = h
					for _, o in ipairs({{1, 0}, {-1, 0}, {0, 1}, {0, -1}}) do
						local ni, nj = i + o[1], j + o[2]
						if math.abs(ni) <= N and math.abs(nj) <= N then lo = math.min(lo, height(ni, nj)) end
					end
					for k = math.max(1, lo), h do
						local def = nr
						if k == h then
							if math.noise(i * 0.2 + 9, j * 0.2, seed) > 0.25 then def = ss end
							if rng:NextNumber() < 0.02 then def = nb end
						end
						put(def, Vector3.new(i * S, NO.Y + (k - 0.5) * S, j * S))
					end
				end
			end
		end
		UI.hasFence = oldFence
		UI.fluidBusy = false
		if lava then UI.fluidCount = (UI.fluidCount or 0) + 1 UI.pendW, UI.pendL = true, true end

		-- the portal you arrive in (an Obsidian frame on the flat place, 2 wide and 3 tall inside)
		local l = Vector3.new(0, NO.Y + 2.5 * S, 0)
		if obs then
			for i = -1, 2 do
				for j = -1, 3 do
					local border = i == -1 or i == 2 or j == -1 or j == 3
					local corner = (i == -1 or i == 2) and (j == -1 or j == 3)
					if border and not corner then makeBlock(l + Vector3.xAxis * (i * S) + UP * (j * S), obs, UP, root, false, nil) end
				end
			end
		end
		local pt = UI.createPortal(l, Vector3.xAxis, 2, 3)
		pt.born = os.clock() + 4                           -- (do not check this portal until the blocks are really there)
		pt.exit = Vector3.new(pt.exit.X, NO.Y + S + 3.2, pt.exit.Z)   -- you arrive on the floor in front of it
		UI.netherExit = pt.exit
	end

	function UI.setNether(on_)
		if on_ == (UI.inNether or false) then return end
		UI.inNether = on_
		local sky, atm = Lighting:FindFirstChildOfClass("Sky"), Lighting:FindFirstChildOfClass("Atmosphere")
		if on_ then
			if not UI.netherFolder then UI.buildNether() end
			UI.lightSave = {Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, FogColor = Lighting.FogColor, FogStart = Lighting.FogStart,
				FogEnd = Lighting.FogEnd, Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, sky = sky and sky.CelestialBodiesShown,
				atm = atm and atm.Density}
			Lighting.Ambient, Lighting.OutdoorAmbient = C(105, 48, 40), C(105, 48, 40)
			Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = C(70, 18, 14), 10, 260
			Lighting.Brightness, Lighting.ClockTime = 0.6, 0
			if sky then sky.CelestialBodiesShown = false end
			if atm then atm.Density = 0 end
		else
			local sv = UI.lightSave
			if sv then
				Lighting.Ambient, Lighting.OutdoorAmbient, Lighting.FogColor = sv.Ambient, sv.OutdoorAmbient, sv.FogColor
				Lighting.FogStart, Lighting.FogEnd, Lighting.Brightness, Lighting.ClockTime = sv.FogStart, sv.FogEnd, sv.Brightness, sv.ClockTime
				if sky and sv.sky ~= nil then sky.CelestialBodiesShown = sv.sky end
				if atm and sv.atm then atm.Density = sv.atm end
			end
		end
	end

	function UI.portalGo(pt)
		if UI.travelling then return end
		local root = getRoot()
		if not root then return end
		UI.travelling = true
		UI.portalCD = os.clock() + 120                     -- (while it loads, no second trip)
		task.spawn(function()
			if UI.inNether then
				UI.setNether(false)
				root.CFrame = CFrame.new(UI.owReturn or Vector3.new(0, 30, 0))
			else
				UI.owReturn = pt.exit
				if not UI.netherFolder then
					if sys then sys("Building the Nether ...") end
					UI.buildNether()                           -- the first time only (it takes a moment)
				end
				UI.setNether(true)
				root = getRoot() or root
				root.CFrame = CFrame.new(UI.netherExit or Vector3.new(0, 1510, 0))
			end
			root.AssemblyLinearVelocity = Vector3.zero
			UI.portalCD = os.clock() + 6
			UI.travelling = false
			UI.playSound("rbxasset://sounds/electronicpingshort.wav", 0.4, 0.7)
		end)
	end

	local fade = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(110, 30, 190), BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = 14, Active = false}, gui)
	local inside, checkT = 0, 0
	on(RS.Heartbeat, function(dt)
		if #UI.portals == 0 then
			inside = 0
			if fade.BackgroundTransparency < 1 then fade.BackgroundTransparency = 1 end
			return
		end
		checkT += dt
		if checkT > 0.7 then                                  -- a portal vanishes when its frame is broken
			checkT = 0
			for i = #UI.portals, 1, -1 do
				local pt = UI.portals[i]
				local ok = pt.part.Parent ~= nil
				if ok and os.clock() - pt.born > 2 then
					for _, c in ipairs(pt.cells) do
						if not isObs(c) then ok = false break end
					end
				end
				if not ok then
					pcall(function() pt.part:Destroy() end)
					table.remove(UI.portals, i)
				end
			end
		end
		local root = getRoot()
		local here, cur = false, nil
		if root and os.clock() > (UI.portalCD or 0) then
			for _, pt in ipairs(UI.portals) do
				local lp = pt.part.CFrame:PointToObjectSpace(root.Position)
				local sz = pt.part.Size
				if math.abs(lp.X) < sz.X / 2 + 0.3 and math.abs(lp.Y) < sz.Y / 2 and math.abs(lp.Z) < sz.Z / 2 + 1.6 then here, cur = true, pt break end
			end
		end
		local need = mode == "creative" and 0.5 or 3
		if here then inside += dt else inside = math.max(0, inside - dt * 2) end
		fade.BackgroundTransparency = 1 - math.clamp(inside / need, 0, 1) * 0.6
		if here and inside >= need then
			inside = 0
			UI.portalGo(cur)
		end
	end)

	-- You only see the players of YOUR dimension (the Nether is far above the normal world, Y > 1000)
	local visT = 0
	on(RS.Heartbeat, function(dt)
		visT += dt
		if visT < 0.5 then return end
		visT = 0
		local mine = UI.inNether or false
		for _, pl in ipairs(Players:GetPlayers()) do
			local ch = pl ~= player and pl.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
			if hrp then
				local hide = (hrp.Position.Y > 1000) ~= mine
				if hide or ch:GetAttribute("DimHidden") then
					ch:SetAttribute("DimHidden", hide)
					for _, o in ipairs(ch:GetDescendants()) do
						if o:IsA("BasePart") then o.LocalTransparencyModifier = hide and 1 or 0
						elseif o:IsA("BillboardGui") then o.Enabled = not hide end
					end
					local hum = ch:FindFirstChildOfClass("Humanoid")
					if hum then hum.DisplayDistanceType = hide and Enum.HumanoidDisplayDistanceType.None or Enum.HumanoidDisplayDistanceType.Viewer end
				end
			end
		end
	end)

	on(player.CharacterAdded, function()                      -- dying in the Nether: you wake up in the normal world
		if UI.inNether then UI.setNether(false) end
	end)
end

--====================================================================
-- FALLING BLOCKS (like Minecraft): Sand, Gravel and Concrete Powder fall when there is nothing solid under them - when you place
-- them in the air, or break / blow up the block they were resting on. They land on the first solid thing (a block or a part of the
-- game), replace soft blocks (Fire, Water, Lava) and drop as an item if the spot they land in got filled meanwhile.
-- Concrete Powder turns into Concrete as soon as it touches Water.
--====================================================================
do
	UI.gravList = {}
	local SOFT = {Fire = true, Water = true, Lava = true}            -- not solid: falling blocks go through / replace them
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.MaxParts = 40

	local function solidAt(center, ignore)                           -- is there something solid in this cell?
		local skip = {dropFolder}
		if player.Character then skip[#skip + 1] = player.Character end
		if ignore then skip[#skip + 1] = ignore end
		params.FilterDescendantsInstances = skip
		for _, part in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.one * (BLOCK - 0.5), params)) do
			local r = blockRoot(part)
			if r then
				local bd = BY_NAME[r:GetAttribute("BlockType") or ""]
				if bd and not SOFT[bd.Name] and not bd.Liquid then return true end
			else
				local m = part:FindFirstAncestorOfClass("Model")
				if part.CanCollide and not (m and m:FindFirstChildOfClass("Humanoid")) then return true end
			end
		end
		return false
	end

	local function gravDef(root) local bd = BY_NAME[root:GetAttribute("BlockType") or ""] return bd and bd.Gravity and bd end

	function UI.fallBlock(root)
		local d = gravDef(root)
		local cell = root:GetAttribute("Cell")
		if not d or not cell or root:GetAttribute("Falling") then return end
		root:SetAttribute("Falling", true)
		local pic = root:Clone()                                     -- the picture that falls (it is not a block while it falls)
		pic.CanCollide, pic.CanQuery, pic.CanTouch, pic.Anchored = false, false, false, true
		pic.Parent = dropFolder
		root:Destroy()
		task.spawn(function()
			local x, z = cell.X, cell.Z
			local j = math.round(cell.Y / BLOCK)                     -- the grid row it is in (rows are BLOCK apart)
			local v, G = 0, 16 * BLOCK                               -- Minecraft: 0.04 blocks per tick^2
			while true do
				if solidAt(Vector3.new(x, (j - 1) * BLOCK, z)) then break end         -- something solid under me: land here
				if j * BLOCK < Workspace.FallenPartsDestroyHeight + 60 then pic:Destroy() return end   -- fell out of the world
				local t = (-v + math.sqrt(v * v + 2 * G * BLOCK)) / G                   -- time to fall one block (faster and faster)
				v += G * t
				local y0, el = j * BLOCK, 0
				while el < t do
					el += RS.Heartbeat:Wait()
					pic.CFrame = CFrame.new(x, y0 - BLOCK * math.min(1, el / t), z)
				end
				j -= 1
			end
			pic:Destroy()
			local pos = Vector3.new(x, j * BLOCK, z)
			local blocked = false
			skip = nil
			for _, part in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.one * (BLOCK - 0.5))) do
				local r = blockRoot(part)
				if r then
					local bd = BY_NAME[r:GetAttribute("BlockType") or ""]
					if bd and (SOFT[bd.Name] or bd.Liquid) then r:Destroy() else blocked = true end   -- soft = replaced, solid = in the way
				end
			end
			if blocked then spawnDrop(pos, d) return end                                       -- no room: it drops as an item
			makeBlock(pos, d, Vector3.yAxis, getRoot() or {Position = pos}, false, nil)
		end)
	end

	function UI.gravCheck(root)                                      -- should this block fall (or turn into concrete)?
		if not root or not root.Parent or root:GetAttribute("Falling") then return end
		local d = gravDef(root)
		local cell = root:GetAttribute("Cell")
		if not d or not cell then return end
		if d.Powder and BY_NAME[d.Powder] then                       -- Concrete Powder + Water = Concrete
			for _, dv in ipairs(NEIGHBORS) do
				local nb = blockAtCell(cell + dv * BLOCK)
				if nb and nb:GetAttribute("BlockType") == "Water" then
					root:Destroy()
					makeBlock(cell, BY_NAME[d.Powder], Vector3.yAxis, getRoot() or {Position = cell}, false, nil)
					return
				end
			end
		end
		if not solidAt(cell - Vector3.new(0, BLOCK, 0), root) then UI.fallBlock(root) end
	end

	function UI.gravAdd(root)
		UI.gravList[#UI.gravList + 1] = root
		task.defer(function() UI.gravCheck(root) end)                -- right away
	end

	local idx = 0
	on(RS.Heartbeat, function()                                      -- all falling-type blocks are checked again and again (30 per frame)
		local list = UI.gravList
		for _ = 1, math.min(#list, 30) do
			idx = idx % #list + 1
			local root = list[idx]
			if not root or not root.Parent then
				table.remove(list, idx)
				idx -= 1
				if #list == 0 then return end
			else
				UI.gravCheck(root)
			end
		end
	end)
end

--====================================================================
-- DAMAGE like Minecraft (survival only). Everything that hurts you goes through UI.hurt(points, kind):  points = half hearts (20 = all).
--   * after a hit you can not be hurt for 0.5 s - only a STRONGER hit still counts (for the extra damage)
--   * armor blocks 4% of the damage per armor point (80% at most) - but NOT for falling, drowning or hunger
--   * falling: every block you fall more than 3 blocks = half a heart (falling into water / lava = no damage)
--   * the screen flashes red, hurting costs a little hunger, lava = 2 hearts per hit, fire = half a heart, burning = half a heart per second
--====================================================================
--====================================================================
-- WATER + LAVA FLOW (like Minecraft)
--   A source spreads sideways: Water 7 blocks (a new step every 0.25 s), Lava only 3 blocks and SLOW (a step every 1.5 s;
--   in the Nether lava reaches 7 blocks and is faster). The farther from the source, the thinner (lower) the flow.
--   Over a hole it flows down (a full falling column), and lands + spreads again. Remove the source and the flow drains away.
--   Water + flowing Lava = Cobblestone.   Water + a Lava SOURCE = Obsidian.   Lava flowing down onto Water = Stone.
--====================================================================
do
	local S = BLOCK
	local UP = Vector3.yAxis
	local H4 = {Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis}
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.MaxParts = 30
	UI.pendW, UI.pendL, UI.fluidCount = false, false, 0

	local function key(p) return math.floor(p.X * 10 + 0.5) .. "," .. math.floor(p.Y * 10 + 0.5) .. "," .. math.floor(p.Z * 10 + 0.5) end

	local solidCache = {}
	local function solidAt(center)                         -- is there something solid in this cell (water / lava / fire / dust are not)
		local k = key(center)
		local v = solidCache[k]
		if v ~= nil then return v end
		local skip = {dropFolder}
		if player.Character then skip[#skip + 1] = player.Character end
		params.FilterDescendantsInstances = skip
		v = false
		for _, part in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.one * (S - 0.5), params)) do
			local r = blockRoot(part)
			if r then
				local bd = BY_NAME[r:GetAttribute("BlockType") or ""]
				if not r:GetAttribute("RS") and not (bd and bd.Liquid) then v = true break end
			elseif part.CanCollide then
				local m = part:FindFirstAncestorOfClass("Model")
				if not (m and m:FindFirstChildOfClass("Humanoid")) then v = true break end
			end
		end
		solidCache[k] = v
		return v
	end

	local function rangeOf(kind, p)
		if kind == "Water" then return 7 end
		return p.Y > 1000 and 7 or 3                       -- lava: 3 blocks in the normal world, 7 in the Nether
	end

	local function setLook(part, decay, falling, range)    -- the farther from the source, the lower the flow
		local h = falling and S or S * math.max(0.12, (range + 1 - decay) / (range + 1))
		local c = part:GetAttribute("Cell")
		part.Size = Vector3.new(S, h, S)
		part.Position = Vector3.new(c.X, c.Y - S / 2 + h / 2, c.Z)
		part:SetAttribute("Flow", decay)
		part:SetAttribute("Falling", falling and true or false)
	end

	local function put(pos, name)                          -- a normal block (Obsidian / Cobblestone / Stone) where the fluid was
		local def = BY_NAME[name]
		if not def then return end
		UI.fluidBusy = true
		makeBlock(pos, def, UP, getRoot() or {Position = pos}, false, nil)
		UI.fluidBusy = false
	end

	local function convert(part, pos, name)
		pcall(function() part:Destroy() end)
		put(pos, name)
		UI.playSound("rbxasset://sounds/electronicpingshort.wav", 0.35, 0.5)       -- "fizz"
	end

	local function pass(doW, doL)
		solidCache = {}
		local occ, src, flow, lavas, count = {}, {}, {}, {}, 0
		for _, b in ipairs(folder:GetChildren()) do
			local bt = b:GetAttribute("BlockType")
			if bt == "Water" or bt == "Lava" then
				local c = b:GetAttribute("Cell")
				if c then
					local fl = b:GetAttribute("Flow")
					local rec = {kind = bt, decay = fl or 0, falling = b:GetAttribute("Falling") or false, part = b, source = fl == nil, pos = c}
					occ[key(c)] = rec
					count += 1
					if rec.source then src[#src + 1] = rec else flow[#flow + 1] = rec end
					if bt == "Lava" then lavas[#lavas + 1] = rec end
				end
			end
		end
		UI.fluidCount = count
		if count == 0 then UI.pendW, UI.pendL = false, false return end

		-- 1) where should every kind of fluid be?  (flood from the sources: sideways with +1 every block, straight down = a new start)
		local want, stoneAt = {}, {}
		local FALL_LIMIT = Workspace.FallenPartsDestroyHeight + 60
		local function run(kind)
			local stack = {}
			local function relax(p, decay, falling)
				local k = key(p)
				local o = occ[k]
				if o and (o.source or o.kind ~= kind) then return end
				local w = want[k]
				if w and (w.kind ~= kind or w.decay < decay or (w.decay == decay and (w.falling or not falling))) then return end
				want[k] = {kind = kind, decay = decay, falling = falling, pos = p}
				stack[#stack + 1] = want[k]
			end
			for _, r in ipairs(src) do
				if r.kind == kind then stack[#stack + 1] = {pos = r.pos, decay = 0, falling = false, isSource = true} end
			end
			local steps = 0
			while #stack > 0 and steps < 6000 do
				steps += 1
				local c = table.remove(stack)
				local p, d = c.pos, c.decay
				local below = p - UP * S
				local belowSolid = solidAt(below)
				if not belowSolid then
					local bo = occ[key(below)]
					if not bo then
						if below.Y > FALL_LIMIT then relax(below, 0, true) end
					elseif kind == "Lava" and bo.kind == "Water" and occ[key(p)] then
						stoneAt[key(below)] = bo                                 -- lava running down onto water = Stone
					end
				end
				if (c.isSource or belowSolid) and d < rangeOf(kind, p) then      -- sources always spread, flowing water only when it stands on something
					for _, dv in ipairs(H4) do
						local n = p + dv * S
						if not solidAt(n) then relax(n, d + 1, false) end
					end
				end
			end
		end
		run("Water")
		run("Lava")

		-- 2) reactions
		local changed = false
		local conv = {}                                              -- cells that just turned into Obsidian / Cobblestone / Stone
		local function waterAt(p)
			local o = occ[key(p)]
			return o ~= nil and o.kind == "Water" and o.part.Parent ~= nil
		end
		for _, r in ipairs(lavas) do
			if r.part.Parent then
				local touch = false
				for _, dv in ipairs(NEIGHBORS) do
					if dv.Y >= 0 and waterAt(r.pos + dv * S) then touch = true break end
				end
				if touch then
					convert(r.part, r.pos, r.source and "Obsidian" or "Cobblestone")   -- lava SOURCE = Obsidian, flowing lava = Cobblestone
					occ[key(r.pos)] = nil
					conv[key(r.pos)] = true
					changed = true
				end
			end
		end
		for k, o in pairs(stoneAt) do
			if o.part.Parent then
				convert(o.part, o.pos, "Stone")
				occ[k] = nil
				conv[k] = true
				changed = true
			end
		end

		-- 3) make it real: one step per tick (a new cell only appears next to a cell that already exists)
		local function hasParent(w)
			for _, dv in ipairs(H4) do
				local o = occ[key(w.pos + dv * S)]
				if o and o.kind == w.kind and o.decay < w.decay and o.part.Parent then return true end
			end
			local up = occ[key(w.pos + UP * S)]
			return up ~= nil and up.kind == w.kind and w.falling and up.part.Parent ~= nil
		end
		local function materialize(kind, maxRemove)
			local ch = false
			for k, w in pairs(want) do
				if w.kind == kind and not conv[k] then
					local o = occ[k]
					if o then
						if o.kind == kind and not o.source and o.part.Parent and (o.decay ~= w.decay or o.falling ~= w.falling) then
							setLook(o.part, w.decay, w.falling, rangeOf(kind, w.pos))
							ch = true
						end
					elseif hasParent(w) then
						local touch = false
						if kind == "Lava" then
							for _, dv in ipairs(NEIGHBORS) do
								if dv.Y >= 0 and waterAt(w.pos + dv * S) then touch = true break end
							end
						end
						if touch then
							put(w.pos, "Cobblestone")                                    -- flowing lava runs into water: Cobblestone
						else
							UI.fluidBusy = true
							local root = makeBlock(w.pos, BY_NAME[kind], UP, getRoot() or {Position = w.pos}, false, nil)
							UI.fluidBusy = false
							if root then setLook(root, w.decay, w.falling, rangeOf(kind, w.pos)) end
						end
						ch = true
					end
				end
			end
			local rem = {}                                                      -- flow that nothing feeds any more drains away, outer cells first
			for _, r in ipairs(flow) do
				if r.kind == kind and r.part.Parent then
					local w = want[key(r.pos)]
					if not w or w.kind ~= kind then rem[#rem + 1] = r end
				end
			end
			table.sort(rem, function(a, b)
				if a.decay ~= b.decay then return a.decay > b.decay end
				return a.pos.Y < b.pos.Y
			end)
			for i = 1, math.min(#rem, maxRemove) do rem[i].part:Destroy() end
			if #rem > 0 then ch = true end
			return ch
		end
		local chW = doW and materialize("Water", 8)
		local chL = doL and materialize("Lava", 2)
		if doW then UI.pendW = chW or changed end
		if doL then UI.pendL = chL or changed end
		if changed then UI.pendW, UI.pendL = true, true end
	end

	function UI.fluidPoke(pos, def)                          -- something changed near fluid (a block placed / broken, a bucket used)
		if UI.fluidBusy then return end
		if def and (def.Liquid == "Water" or def.Liquid == "Lava") then UI.fluidCount = (UI.fluidCount or 0) + 1 end
		if (UI.fluidCount or 0) > 0 then UI.pendW, UI.pendL = true, true end
	end

	local waterT, lavaT = 0, 0
	on(RS.Heartbeat, function(dt)
		if not (UI.pendW or UI.pendL) then return end
		waterT += dt
		lavaT += dt
		local doW = UI.pendW and waterT >= 0.25                     -- water: a step every 0.25 s
		local doL = UI.pendL and lavaT >= (UI.inNether and 0.5 or 1.5)   -- lava: slow (1.5 s per step)
		if not doW and not doL then return end
		if doW then waterT = 0 end
		if doL then lavaT = 0 end
		local ok, err = pcall(pass, doW, doL)
		if not ok then
			warn("fluid: " .. tostring(err))
			UI.fluidBusy = false
			UI.pendW, UI.pendL = false, false
		end
	end)
end

--====================================================================
-- JUMP: only 1.5 blocks high (change UI.JUMP_BLOCKS)
--====================================================================
do
	UI.JUMP_BLOCKS = 1.5
	on(RS.Heartbeat, function()
		local hum = MV.hum
		if hum then
			local h = UI.JUMP_BLOCKS * BLOCK
			if hum.UseJumpPower or math.abs(hum.JumpHeight - h) > 0.01 then
				hum.UseJumpPower = false
				hum.JumpHeight = h
			end
		end
	end)
end

--====================================================================
-- ARMOR ON YOUR BODY (like Minecraft): what you wear in the H / C / L / B slots is drawn on your character:
--   Leather (brown), Chainmail (grey net), Iron (light grey), Gold (yellow), Diamond (cyan), Netherite (dark)
--   helmet = cap + trim, chestplate = body + shoulders, leggings = belt + upper legs, boots = lower legs + dark soles
-- It is drawn on the STEVE parts, so it turns with your head, swings with your arm and leans when you sneak.
-- (If Steve is switched off in the options, it is drawn on the normal body instead.)
--====================================================================
do
	local MATS = {
		Leather = {C(150, 92, 52), C(98, 58, 32), Enum.Material.Fabric},
		Chainmail = {C(150, 152, 158), C(92, 94, 100), Enum.Material.DiamondPlate},
		Iron = {C(214, 216, 220), C(140, 142, 150), Enum.Material.Metal},
		Gold = {C(246, 206, 62), C(186, 136, 24), Enum.Material.Metal},
		Golden = {C(246, 206, 62), C(186, 136, 24), Enum.Material.Metal},
		Diamond = {C(75, 230, 225), C(30, 150, 165), Enum.Material.Metal},
		Netherite = {C(68, 60, 64), C(38, 32, 36), Enum.Material.Metal},
	}
	local STEVE_NAME = {Head = "SteveHead", Torso = "SteveTorso", ["Left Arm"] = "SteveLeftArm", ["Right Arm"] = "SteveRightArm",
		["Left Leg"] = "SteveLeftLeg", ["Right Leg"] = "SteveRightLeg"}

	-- a box around a limb between two heights (0 = bottom, 1 = top). If the pose code moves this limb (arm swing, sneak lean),
	-- the armor gets the SAME weld treatment, so it always stays exactly on the limb.
	local function ring(model, limb, y0, y1, pad, color, mat)
		if not limb then return end
		local sz = limb.Size
		local off = CFrame.new(0, sz.Y * ((y0 + y1) / 2 - 0.5), 0)
		local p = new("Part", {Name = "Armor", Size = Vector3.new(sz.X + pad, sz.Y * (y1 - y0), sz.Z + pad), Color = color, Material = mat,
			CanCollide = false, CanQuery = false, CanTouch = false, Massless = true, CastShadow = false,
			TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, model)
		p.CFrame = limb.CFrame * off
		local e
		for _, q in ipairs(UI.poseParts or {}) do
			if q.weld.Part1 == limb then e = q break end
		end
		if e and e.host.Parent then
			local w = new("Weld", {Part0 = e.host, Part1 = p, C0 = e.rel * off}, p)
			UI.poseParts[#UI.poseParts + 1] = {weld = w, host = e.host, rel = e.rel * off, key = e.key}
		else
			new("WeldConstraint", {Part0 = limb, Part1 = p}, p)        -- (the head hangs on its own neck joint: a plain weld follows it)
		end
	end

	local function build(ch, set, steve)                                 -- set[1..4] = material of helmet / chestplate / leggings / boots
		local model = new("Model", {Name = "MCArmor"}, steve and UI.steveF or ch)
		local r6 = steve or ch:FindFirstChild("Torso") ~= nil
		local function L(n)
			if steve then return UI.steveF:FindFirstChild(STEVE_NAME[n] or n) end
			return ch:FindFirstChild(n)
		end
		for piece = 1, 4 do
			local m = set[piece] and MATS[set[piece]]
			if m then
				local main, trim, mat = m[1], m[2], m[3]
				if piece == 1 then                                                  -- helmet
					ring(model, L("Head"), 0.5, 1, 0.3, main, mat)
					ring(model, L("Head"), 0.42, 0.56, 0.36, trim, mat)
				elseif piece == 2 then                                              -- chestplate
					if r6 then
						ring(model, L("Torso"), 0, 1, 0.25, main, mat)
						ring(model, L("Torso"), 0, 0.12, 0.3, trim, mat)
						ring(model, L("Left Arm"), 0.55, 1, 0.26, main, mat)
						ring(model, L("Right Arm"), 0.55, 1, 0.26, main, mat)
						ring(model, L("Left Arm"), 0.5, 0.6, 0.3, trim, mat)
						ring(model, L("Right Arm"), 0.5, 0.6, 0.3, trim, mat)
					else
						ring(model, L("UpperTorso"), 0, 1, 0.25, main, mat)
						ring(model, L("UpperTorso"), 0, 0.12, 0.3, trim, mat)
						for _, n in ipairs({"LeftUpperArm", "RightUpperArm"}) do
							ring(model, L(n), 0, 1, 0.24, main, mat)
							ring(model, L(n), 0, 0.14, 0.3, trim, mat)
						end
					end
				elseif piece == 3 then                                              -- leggings
					if r6 then
						ring(model, L("Torso"), 0, 0.2, 0.32, trim, mat)             -- belt
						ring(model, L("Left Leg"), 0.4, 1, 0.22, main, mat)
						ring(model, L("Right Leg"), 0.4, 1, 0.22, main, mat)
					else
						ring(model, L("LowerTorso"), 0, 1, 0.3, trim, mat)
						ring(model, L("LeftUpperLeg"), 0, 1, 0.22, main, mat)
						ring(model, L("RightUpperLeg"), 0, 1, 0.22, main, mat)
					end
				else                                                                -- boots
					if r6 then
						for _, n in ipairs({"Left Leg", "Right Leg"}) do
							ring(model, L(n), 0, 0.38, 0.26, main, mat)
							ring(model, L(n), 0, 0.1, 0.32, trim, mat)
						end
					else
						for _, n in ipairs({"LeftLowerLeg", "RightLowerLeg"}) do ring(model, L(n), 0, 0.5, 0.22, main, mat) end
						for _, n in ipairs({"LeftFoot", "RightFoot"}) do
							ring(model, L(n), 0, 1, 0.26, main, mat)
							ring(model, L(n), 0, 0.3, 0.32, trim, mat)
						end
					end
				end
			end
		end
	end

	function UI.clearArmorLook()
		local ch = player.Character
		for _, host in ipairs({UI.steveF, ch}) do
			local m = host and host:FindFirstChild("MCArmor")
			if m then m:Destroy() end
		end
		local list = UI.poseParts                                           -- forget the pose entries of the destroyed armor
		if list then
			for i = #list, 1, -1 do
				if not list[i].weld:IsDescendantOf(Workspace) then table.remove(list, i) end
			end
		end
	end

	local lastKey, lastChar, lastFP, t = nil, nil, nil, 0
	on(RS.Heartbeat, function(dt)
		t += dt
		if t < 0.25 then return end
		t = 0
		local ch = player.Character
		if not ch or not ch:FindFirstChild("Head") or not (ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")) then return end
		local steve = UI.opt and UI.opt.steve
		if steve then                                                       -- wait until the Steve body is really there
			local f = UI.steveF
			if not (f and f.Parent and UI.steveTorso and UI.steveTorso.Parent and f:FindFirstChild("SteveTorso") and f:FindFirstChild("SteveHead")) then return end
		end
		local set = {}
		for slot = 5, 8 do
			local st = inv[slot]
			local info = st and UI.armorInfo(st.name)
			if info and info.slot == slot and st.name ~= "Elytra" then set[slot - 4] = st.name:match("^(%a+)") end
		end
		local key = (set[1] or "-") .. "," .. (set[2] or "-") .. "," .. (set[3] or "-") .. "," .. (set[4] or "-") .. "|" .. tostring(steve) .. "|" .. tostring(UI.steveTok)
		if ch ~= lastChar or key ~= lastKey then
			lastChar, lastKey, lastFP = ch, key, nil
			UI.clearArmorLook()
			if set[1] or set[2] or set[3] or set[4] then build(ch, set, steve and true or false) end
		end
		-- first person: you do not see your own armor (like Minecraft)
		local model = (UI.steveF and UI.steveF:FindFirstChild("MCArmor")) or ch:FindFirstChild("MCArmor")
		local cam, head = Workspace.CurrentCamera, ch:FindFirstChild("Head")
		if model and cam and head then
			local fp = (cam.CFrame.Position - head.Position).Magnitude < 1.6
			if fp ~= lastFP then
				lastFP = fp
				for _, o in ipairs(model:GetChildren()) do
					if o:IsA("BasePart") then o.LocalTransparencyModifier = fp and 1 or 0 end
				end
			end
		end
	end)
end


do
	UI.hurtUntil, UI.lastHit = 0, 0
	local flash = new("Frame", {Name = "HurtFlash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(200, 0, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, Active = false, ZIndex = 7}, gui)
	local tok = 0
	function UI.hurtFlash()
		tok += 1
		local mine = tok
		flash.BackgroundTransparency = 0.55
		task.spawn(function()
			local t = 0
			while t < 0.45 and mine == tok do
				t += RS.Heartbeat:Wait()
				flash.BackgroundTransparency = 0.55 + 0.45 * math.min(1, t / 0.45)
			end
			if mine == tok then flash.BackgroundTransparency = 1 end
		end)
	end

	function UI.hurt(points, kind, from)
		local hum = MV.hum
		if mode ~= "survival" or not hum or hum.Health <= 0 or points <= 0 then return end
		local now = os.clock()
		if now < UI.hurtUntil then                                   -- still invulnerable: only a stronger hit counts, for the extra damage
			if points <= UI.lastHit then return end
			local extra = points - UI.lastHit
			UI.lastHit = points
			points = extra
		else
			UI.lastHit = points
			UI.hurtUntil = now + 0.5
		end
		if kind ~= "fall" and kind ~= "drown" and kind ~= "starve" then
			points = points * (1 - math.min(0.8, UI.armorPoints() * 0.04))
		end
		hum:TakeDamage(points * hum.MaxHealth / 20)
		UI.hurtFlash()
		if UI.exhaust then UI.exhaust(0.1) end
		local root = getRoot()
		if from and root then                                        -- pushed away from what hit you
			local away = (root.Position - from) * Vector3.new(1, 0, 1)
			if away.Magnitude > 0.1 then root.AssemblyLinearVelocity += away.Unit * 22 + Vector3.new(0, 14, 0) end
		end
	end

	local peak, lastHum                                              -- fall damage: the highest point of the fall -> where you land
	on(RS.Heartbeat, function()
		local hum, root = MV.hum, getRoot()
		if hum ~= lastHum then peak, lastHum = nil, hum end
		if mode ~= "survival" or not hum or not root or hum.Health <= 0 or UI.flying then peak = nil return end
		if UI.inLiquid and UI.inLiquid ~= "Fire" then peak = nil return end
		local st = hum:GetState()
		local inAir = hum.FloorMaterial == Enum.Material.Air and st ~= Enum.HumanoidStateType.Swimming and st ~= Enum.HumanoidStateType.Climbing
		if inAir then
			peak = math.max(peak or root.Position.Y, root.Position.Y)
		elseif peak then
			local blocks = (peak - root.Position.Y) / BLOCK
			peak = nil
			local pts = math.floor(blocks - 3 + 0.1)                -- 4 blocks = half a heart, 5 blocks = 1 heart ...  (3 blocks or less = nothing)
			if pts > 0 then UI.hurt(pts, "fall") end
		end
	end)
end

local function startBreak(getPt, input)
	if panelOpen or chatOpen then return end
	hold.active, hold.getPt, hold.input = true, getPt, input
	hold.part, hold.prog, hold.lastSwing, hold.lastBreak = nil, 0, os.clock(), 0
	swing()                                            -- the arm swings the moment you press BREAK (even on air)
end

function stopBreak()
	hold.active, hold.input, hold.part, hold.prog = false, nil, nil, 0
	bbar.Visible = false
	if UI.clearCrack then UI.clearCrack() end
end

on(RS.Heartbeat, function(dt)
	if not hold.active then return end
	if panelOpen or chatOpen then stopBreak() return end
	local now = os.clock()
	if now - hold.lastSwing > 0.35 then hold.lastSwing = now swing() end
	local hit = getTarget(hold.getPt())
	local r = getRoot()
	local part = hit and r and (r.Position - hit.Position).Magnitude <= REACH and blockRoot(hit.Instance) or nil
	if part ~= hold.part then hold.part, hold.prog = part, 0 UI.clearCrack() end
	if not part then bbar.Visible = false UI.clearCrack() return end
	if mode == "creative" then
		bbar.Visible = false
		if now - hold.lastBreak > 0.25 then
			hold.lastBreak = now
			hold.part = nil
			breakPart(part)
		end
		return
	end
	local def = BY_NAME[part:GetAttribute("BlockType") or ""]
	local need = (def and def.BreakTime) or UI.breakTime(part:GetAttribute("BlockType"))
	hold.prog += dt
	bbar.Visible = false                                  -- (no bar like in Minecraft: the cracks show how far you are)
	if need > 0.1 then UI.updateCrack(part, hold.prog / need) end
	if hold.prog >= need then
		hold.part, hold.prog = nil, 0
		UI.clearCrack()
		breakPart(part)
	end
end)

-- SNEAK EDGE GUARD: while sneaking you cannot fall off a block's edge (like Minecraft), and you can LEAN OUT over it:
-- you stay up while ANY part of your body is over ground, so your head / camera hangs past the edge and looks down the side.
local edgeParams = RaycastParams.new()
edgeParams.FilterType = Enum.RaycastFilterType.Exclude
edgeParams.IgnoreWater = true
pcall(function() edgeParams.RespectCanCollide = true end)
-- A thin invisible ledge (UI.sneakPad) follows your feet while you sneak, so the part of your body that hangs over the edge
-- still has floor under it and you do not slip off. It is only there while you sneak.
pcall(function() RS:UnbindFromRenderStep("MCSneakEdge") end)
RS:BindToRenderStep("MCSneakEdge", Enum.RenderPriority.Input.Value + 1, function(dt)
	local sneaking = (MV.sneakHeld or MV.sneakTog) and not UI.flying
	local pad = UI.sneakPad
	if not sneaking then                                          -- not sneaking: the ledge is gone (you fall like normal)
		if pad and pad.CanCollide then pad.CanCollide = false end
		UI.sneakY = nil
		return
	end
	local hum, root = MV.hum, getRoot()
	if not hum or not root or hum.Health <= 0 then return end
	if not pad or not pad.Parent then
		pad = new("Part", {Name = "MCSneakPad", Size = Vector3.new(2, 0.4, 2), Anchored = true, CanCollide = false, CanQuery = false,
			CanTouch = false, Transparency = 1}, Workspace)
		UI.sneakPad = pad
	end
	edgeParams.FilterDescendantsInstances = {player.Character, dropFolder, pad, UI.ghost}
	local pos = root.Position
	local near = Workspace:Raycast(pos, Vector3.new(0, -4.5, 0), edgeParams)   -- the ground you stand on
	if near then
		UI.sneakY, UI.sneakAir = near.Position.Y, 0
	elseif hum.FloorMaterial == Enum.Material.Air then            -- really in the air (jump / fall): forget the ledge
		UI.sneakAir = (UI.sneakAir or 0) + dt
		if UI.sneakAir > 0.4 then UI.sneakY = nil end
	end
	if UI.sneakY then                                             -- keep the little ledge under your feet at ground height
		pad.CFrame = CFrame.new(pos.X, UI.sneakY - 0.2, pos.Z)
		pad.CanCollide = true
	else
		pad.CanCollide = false
	end

	local md = hum.MoveDirection
	local flat = Vector3.new(md.X, 0, md.Z)
	if not UI.sneakY or flat.Magnitude < 0.05 then return end
	local floorY = UI.sneakY
	local function ground(p)                                      -- ground under this spot, at most ~1.5 studs lower than where you stand
		return Workspace:Raycast(Vector3.new(p.X, floorY + 1.8, p.Z), Vector3.new(0, -3.4, 0), edgeParams) ~= nil
	end
	local HALF = 1.4                                              -- like Minecraft: you stay up while ANY part of your body is over ground
	local function supported(p)
		return ground(p) or ground(p + Vector3.new(HALF, 0, HALF)) or ground(p + Vector3.new(-HALF, 0, HALF))
			or ground(p + Vector3.new(HALF, 0, -HALF)) or ground(p + Vector3.new(-HALF, 0, -HALF))
	end
	local step = flat.Unit * (0.45 + hum.WalkSpeed * dt * 2)       -- a little ahead of where you are about to be
	if supported(pos + step) then return end                      -- still over ground: walk normally (you can lean out past the edge)
	local out = Vector3.zero                                      -- nothing under you ahead: keep only the part that is safe (slide along the edge)
	if math.abs(step.X) > 0.05 and supported(pos + Vector3.new(step.X, 0, 0)) then out += Vector3.new(md.X, 0, 0) end
	if math.abs(step.Z) > 0.05 and supported(pos + Vector3.new(0, 0, step.Z)) then out += Vector3.new(0, 0, md.Z) end
	hum:Move(out, false)
end)

-- SPRINT: hold Shift (phone: SPRINT button).   SNEAK: hold Ctrl or C (phone: SNEAK button) = slow + lower camera.
on(RS.Heartbeat, function(dt)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if hum ~= MV.hum then MV.hum, MV.base, MV.camY = hum, nil, 0 end
	local sneak = MV.sneakHeld or MV.sneakTog
	local sprint = (MV.sprintHeld or MV.sprintTog) and not sneak
	if MV.sprintTog and hum.MoveDirection.Magnitude < 0.1 then      -- the SPRINT button switches off when you stop
		MV.idle += dt
		if MV.idle > 0.3 then MV.sprintTog = false if MV.refresh then MV.refresh() end end
	else
		MV.idle = 0
	end
	if sneak or sprint then
		if not MV.base then MV.base = hum.WalkSpeed end
		hum.WalkSpeed = sneak and 6 or MV.base * 1.6
	elseif MV.base then
		hum.WalkSpeed, MV.base = MV.base, nil
	end
	local k = math.min(1, dt * 12)
	if sneak or math.abs(MV.camY) > 0.01 then
		local nxt = MV.camY + ((sneak and -1 or 0) - MV.camY) * k
		hum.CameraOffset += Vector3.new(0, nxt - MV.camY, 0)
		MV.camY = nxt
	end
	if sprint or math.abs(MV.fov) > 0.05 then
		local nxt = MV.fov + ((sprint and 8 or 0) - MV.fov) * k
		Workspace.CurrentCamera.FieldOfView += nxt - MV.fov
		MV.fov = nxt
	end
end)

-- SNEAK POSE: your body hunches over like in Minecraft (R6 and R15). Built by bending the body joints, so it needs no animation id.
do
	local joints, jhum, blend, restored = nil, nil, 0, true
	local function rot(base, ang, pivot)               -- turn a joint around the X axis (side to side), around its own point
		local p = pivot or base.Position
		return CFrame.new(p) * CFrame.Angles(ang, 0, 0) * CFrame.new(-p) * base
	end
	local function scan(ch, hum)
		local j = {}
		local function add(name, kind)
			local m = ch:FindFirstChild(name, true)
			if m and m:IsA("Motor6D") then j[#j + 1] = {m = m, base = m.C0, kind = kind} end
		end
		if hum.RigType == Enum.HumanoidRigType.R15 then
			add("Waist", "waist") add("RightHip", "hip") add("LeftHip", "hip") add("RightKnee", "knee") add("LeftKnee", "knee") add("Root", "root")
		else
			add("RootJoint", "r6root") add("Right Hip", "r6hip") add("Left Hip", "r6hip")
		end
		return j
	end
	on(RS.RenderStepped, function(dt)
		local hum, ch = MV.hum, player.Character
		if not hum or not ch or hum.Health <= 0 then return end
		local want = ((MV.sneakHeld or MV.sneakTog) and not UI.flying and #(UI.poseParts or {}) == 0) and 1 or 0
		if hum ~= jhum or (joints and joints[1] and not joints[1].m.Parent) then joints, jhum, blend, restored = nil, hum, 0, true end
		if want == 0 and restored then return end
		if not joints then joints = scan(ch, hum) end
		blend += (want - blend) * math.min(1, dt * 10)
		if want == 0 and blend < 0.01 then                          -- back to normal: give every joint its original place
			for _, j in ipairs(joints) do if j.m.Parent then j.m.C0 = j.base end end
			blend, restored = 0, true
			return
		end
		restored = false
		for _, j in ipairs(joints) do
			if j.m.Parent then
				local k = j.kind
				if k == "waist" then j.m.C0 = rot(j.base, -0.38 * blend)                              -- lean forward
				elseif k == "hip" then j.m.C0 = rot(j.base, 0.32 * blend)                             -- thighs forward
				elseif k == "knee" then j.m.C0 = rot(j.base, -0.65 * blend)                           -- knees bent
				elseif k == "root" then j.m.C0 = CFrame.new(0, -0.22 * blend, 0) * j.base            -- body a bit lower
				elseif k == "r6root" then j.m.C0 = rot(j.base, -0.38 * blend, Vector3.new(0, -1, 0))   -- torso leans forward from the hips
				elseif k == "r6hip" then j.m.C0 = rot(j.base, 0.38 * blend) end                       -- legs stay straight under you
			end
		end
	end)
end

-- the arm bobs while you walk (faster when sprinting, slower when sneaking) and breathes when you stand still
on(RS.RenderStepped, function(dt)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local moving = hum and hum.MoveDirection.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air
	local sneak = MV.sneakHeld or MV.sneakTog
	local sprint = (MV.sprintHeld or MV.sprintTog) and not sneak
	UI.bobA += ((moving and 1 or 0) - UI.bobA) * math.min(1, dt * 8)
	UI.bobT += dt * (moving and (sprint and 13 or (sneak and 6 or 9)) or 0)
	local idle = math.sin(os.clock() * 1.5) * 2.5 * (1 - UI.bobA)
	handBob.Position = UI.opt.bob and UDim2.fromOffset(math.cos(UI.bobT) * 8 * UI.bobA, math.abs(math.sin(UI.bobT)) * 10 * UI.bobA + idle) or UDim2.fromOffset(0, 0)
	if UI.armModel and handRoot.Visible then            -- swing the 3D arm forward around the shoulder, then back
		local k = UI.swingAt and math.clamp((os.clock() - UI.swingAt) / 0.3, 0, 1) or 1
		local sw = math.sin(k * math.pi)
		local p = UI.armShoulder
		UI.armModel:PivotTo(CFrame.new(p) * CFrame.Angles(-0.9 * sw, 0.35 * sw, 0.25 * sw) * CFrame.new(-p) * UI.armBase)
	end
end)

local function center() return Workspace.CurrentCamera.ViewportSize / 2 end

if UIS.TouchEnabled then
	-- Minecraft Pocket Edition style: square see-through buttons with a dark outline and a drawn icon
	local DARK, BASE, LIT = C(35, 45, 35), C(170, 185, 165), C(240, 200, 80)
	local function mcBtn(x, y, size)
		local b = new("TextButton", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, y), Size = UDim2.fromOffset(size or 66, size or 66),
			BackgroundColor3 = BASE, BackgroundTransparency = 0.45, Text = "", AutoButtonColor = false, ZIndex = 5}, gui)
		new("UICorner", {CornerRadius = UDim.new(0, 8)}, b)
		new("UIStroke", {Color = DARK, Thickness = 2.5, Transparency = 0.15}, b)
		return b
	end
	local function bar(parent, w, h, x, y, rot)          -- one rectangle of an icon, centered at x, y from the middle of the button
		new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, x, 0.5, y), Size = UDim2.fromOffset(w, h), Rotation = rot or 0,
			BackgroundColor3 = DARK, BorderSizePixel = 0, ZIndex = 6}, parent)
	end
	local function arrow(b, down)                         -- arrow up / down with a line under it
		local m = down and -1 or 1
		bar(b, 6, 22, 0, 2 * m, 0)
		bar(b, 6, 16, -5, -7 * m, 45 * m)
		bar(b, 6, 16, 5, -7 * m, -45 * m)
		bar(b, 24, 4, 0, 18, 0)
	end
	local function sprintIcon(b)                          -- >>
		for _, ox in ipairs({-7, 5}) do
			bar(b, 5, 14, ox, -5, -45)
			bar(b, 5, 14, ox, 5, 45)
		end
	end
	local function swordIcon(b)
		bar(b, 5, 28, 4, -4, 45)                          -- blade
		bar(b, 16, 4, -5, 5, -45)                         -- guard
		bar(b, 5, 9, -10, 10, 45)                         -- grip
	end
	local function handIcon(b)
		bar(b, 17, 13, 0, 7, 0)                           -- palm
		for _, fx in ipairs({-6, -2, 2, 6}) do bar(b, 3, 11, fx, -3, 0) end   -- fingers
		bar(b, 4, 10, -11, 5, -35)                        -- thumb
	end

	local upBtn = mcBtn(-20, -112)                        -- jump / fly up
	local downBtn = mcBtn(-20, -34)                       -- sneak / fly down
	local handBtn = mcBtn(-20, 44)                        -- place / use
	local swordBtn = mcBtn(-96, 6)                        -- break
	local sprintBtn = mcBtn(-96, -66, 54)                 -- sprint
	arrow(upBtn, false) arrow(downBtn, true) handIcon(handBtn) swordIcon(swordBtn) sprintIcon(sprintBtn)

	on(swordBtn.InputBegan, function(input) if isPress(input) then startBreak(center, input) end end)   -- hold it
	on(handBtn.Activated, function() doAction("Place", center()) end)

	local function lit(b, on_) b.BackgroundColor3 = on_ and LIT or BASE b.BackgroundTransparency = on_ and 0.25 or 0.45 end
	local function refreshBtns()
		lit(sprintBtn, MV.sprintTog)
		lit(downBtn, MV.sneakTog)
	end
	MV.refresh = refreshBtns
	on(sprintBtn.Activated, function() MV.sprintTog = not MV.sprintTog MV.sneakTog = false refreshBtns() end)
	on(downBtn.Activated, function()
		if UI.opt.sneakHold then return end                                   -- hold mode: handled below
		MV.sneakTog = not MV.sneakTog MV.sprintTog = false refreshBtns()
	end)
	local function tapType(i) return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 end
	on(downBtn.InputBegan, function(i)
		if UI.opt.sneakHold and tapType(i) then MV.sneakTog, MV.sprintTog = true, false refreshBtns() end   -- sneak while you hold it
	end)
	on(downBtn.InputEnded, function(i)
		if UI.opt.sneakHold and tapType(i) then MV.sneakTog = false refreshBtns() end
	end)

	-- the up arrow = jump (hold = keep jumping / fly up; jump twice = fly). The round Roblox jump button is hidden.
	UI.jumpHeld = false
	on(upBtn.InputBegan, function(i)
		if tapType(i) then UI.jumpHeld = true if UI.jumpInput then UI.jumpInput(true) end end
	end)
	on(upBtn.InputEnded, function(i)
		if tapType(i) then UI.jumpHeld = false if UI.jumpInput then UI.jumpInput(false) end end
	end)
	-- Roblox's own touch controls set Humanoid.Jump to false EVERY frame (RenderStepped, Input priority), which switched the jump of the
	-- up arrow off again. So the jump is applied AFTER them (priority + 1), and the jump state is also started directly.
	pcall(function() RS:UnbindFromRenderStep("MCJumpArrow") end)
	RS:BindToRenderStep("MCJumpArrow", Enum.RenderPriority.Input.Value + 1, function()
		local hum = MV.hum
		if UI.jumpHeld and hum and hum.Health > 0 and not UI.flying then
			hum.Jump = true
			if hum.FloorMaterial ~= Enum.Material.Air and hum:GetState() ~= Enum.HumanoidStateType.Jumping then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end)
	task.spawn(function()
		local pg, t0 = player:WaitForChild("PlayerGui"), os.clock()
		repeat
			local tg = pg:FindFirstChild("TouchGui")
			local fr = tg and tg:FindFirstChild("TouchControlFrame")
			UI.rjump = fr and fr:FindFirstChild("JumpButton")
			if not UI.rjump then task.wait(0.5) end
		until UI.rjump or os.clock() - t0 > 20
		if UI.rjump then
			UI.rjump.Visible = false
			on(UI.rjump:GetPropertyChangedSignal("Visible"), function() if UI.rjump.Visible then UI.rjump.Visible = false end end)
		end
	end)
	function UI.showJump()
		if UI.rjump then pcall(function() UI.rjump.Visible = true end) end
	end
end

--====================================================================
-- STEVE: your character looks like Steve (only on your screen).
-- The body = the Steve MeshParts (base layer + second layer = jacket / sleeves / hat) painted with the skin image.
-- If the meshes can't load, it falls back to simple colored boxes.
--====================================================================
do
	local AssetService = game:GetService("AssetService")
	UI.skinDefault = "rbxassetid://8028692999"       -- the Steve skin image (Options > Skin Customization > Custom Skin Texture changes it)
	UI.skinId = UI.savedSkin or UI.skinDefault        -- the skin you used last time
	local SKIN, SHIRT, PANTS = C(198, 140, 100), C(0, 170, 170), C(60, 60, 150)   -- colors for the box fallback
	local MESH = {   -- key = {mesh id, size, fallback color, R6 part, R15 part, 2nd-layer mesh id, 2nd-layer size}
		Head     = {6814397315, Vector3.new(1.371, 1.371, 1.371), SKIN,  "Head", "Head", 6814398336, Vector3.new(1.509, 1.509, 1.509)},
		Torso    = {6814398087, Vector3.new(1.371, 2.057, 0.686), SHIRT, "Torso", "UpperTorso", 6814398865, Vector3.new(1.439, 2.125, 0.753)},
		RightArm = {6814397494, Vector3.new(0.686, 2.057, 0.686), SKIN,  "Right Arm", "RightUpperArm", 6814398479, Vector3.new(0.753, 2.125, 0.753)},
		LeftArm  = {6814397786, Vector3.new(0.686, 2.057, 0.686), SKIN,  "Left Arm", "LeftUpperArm", 6814398213, Vector3.new(0.753, 2.125, 0.753)},
		RightLeg = {6814397649, Vector3.new(0.686, 2.1, 0.686),   PANTS, "Right Leg", "RightUpperLeg", 6814398610, Vector3.new(0.753, 2.125, 0.753)},
		LeftLeg  = {6814397937, Vector3.new(0.686, 2.1, 0.686),   PANTS, "Left Leg", "LeftUpperLeg", 6814398746, Vector3.new(0.753, 2.125, 0.753)},
	}
	local ORDER = {"Torso", "Head", "RightArm", "LeftArm", "RightLeg", "LeftLeg"}

	UI.poseParts = {}
	function UI.unsteve()
		UI.steveNeck = nil
		UI.poseParts, UI.steveTorso = {}, nil
		if UI.steveF then pcall(function() UI.steveF:Destroy() end) UI.steveF = nil end
	end

	-- a Steve MeshPart painted with the skin (nil if the mesh can't be loaded)
	local function newMesh(id, size)
		local ok, mp = pcall(function() return AssetService:CreateMeshPartAsync("rbxassetid://" .. id) end)
		if not ok or not mp then return nil end
		mp.Size = size
		mp.TextureID = UI.skinId
		mp.Color = WHITE
		mp.Material = Enum.Material.SmoothPlastic
		mp.CanCollide, mp.CanQuery, mp.CanTouch, mp.Massless, mp.Anchored = false, false, false, true, false
		return mp
	end

	-- puts a Steve part in place and welds it to the body part it follows
	local function attach(host, part, cf, folder, key)
		part:SetAttribute("Steve", true)
		part.CFrame = cf
		part.Parent = folder
		local rel = host.CFrame:ToObjectSpace(cf)
		local w = new("Weld", {Part0 = host, Part1 = part, C0 = rel}, part)       -- a Weld (not WeldConstraint): the pose below moves it
		UI.poseParts[#UI.poseParts + 1] = {weld = w, host = host, rel = rel, key = key or "Torso"}
	end

	function UI.buildSteve()
		UI.steveTok = (UI.steveTok or 0) + 1
		local tok = UI.steveTok
		UI.unsteve()
		local ch = player.Character
		if not UI.opt.steve or not ch then UI.buildInvSteve() return end
		local f = new("Folder", {Name = "SteveModel"}, ch)
		UI.steveF = f
		local function live() return tok == UI.steveTok and f.Parent ~= nil end

		task.spawn(function()
			-- step 1 (takes a moment): load EVERY mesh first, so nothing is placed on a body that is still moving
			local meshes = {}
			if UI.opt.skin then
				for _, key in ipairs(ORDER) do
					local m = MESH[key]
					meshes[key] = {base = newMesh(m[1], m[2]), layer = UI.opt.layer2 and newMesh(m[6], m[7]) or nil}
					if not live() then
						for _, mm in pairs(meshes) do
							for _, x in pairs(mm) do x:Destroy() end
						end
						return
					end
				end
			end
			local torso = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
			if not live() or not torso then return end
			UI.steveTorso = torso

			-- step 2 (instant, no waiting): place every part where the body is RIGHT NOW and weld it
			for _, key in ipairs(ORDER) do
				local m = MESH[key]
				local host = ch:FindFirstChild(m[4]) or ch:FindFirstChild(m[5])
				if host then
					local size, base = m[2], nil
					if key == "Head" then          -- the head sits on top of the torso
						base = torso.CFrame * CFrame.new(0, torso.Size.Y / 2 + size.Y / 2, 0)
					elseif key == "Torso" then
						base = host.CFrame * CFrame.new(0, host.Size.Y / 2 - size.Y / 2, 0)
					else                           -- arms / legs hang from the top of their part, a bit closer to the body
						local inward = (key:find("Arm") and 0.4715 or 0.157) * (key:find("Right") and -1 or 1)
						base = host.CFrame * CFrame.new(inward, host.Size.Y / 2 - size.Y / 2, 0)
					end

					local mm = meshes[key]
					if mm and mm.base and key == "Head" then
						-- the visible head hangs on its OWN neck joint, so it turns with the camera on any rig (R6 / R15)
						mm.base.Name = "SteveHead"
						mm.base:SetAttribute("Steve", true)
						mm.base.CFrame = base
						mm.base.Parent = f
						UI.steveNeck = new("Motor6D", {Name = "SteveNeck", Part0 = torso, Part1 = mm.base,
							C0 = CFrame.new(0, torso.Size.Y / 2, 0), C1 = CFrame.new(0, -size.Y / 2, 0)}, mm.base)
						if mm.layer then               -- hat / hair layer follows the head
							mm.layer.Name = "Layer2Head"
							mm.layer:SetAttribute("Steve", true)
							mm.layer.CFrame = base
							mm.layer.Parent = f
							new("WeldConstraint", {Part0 = mm.base, Part1 = mm.layer}, mm.layer)
						end
					elseif mm and mm.base then
						mm.base.Name = "Steve" .. key
						attach(host, mm.base, base, f, key)
						if mm.layer then               -- second layer (jacket / sleeves / pants / hat)
							mm.layer.Name = "Layer2" .. key
							attach(host, mm.layer, base, f, key)
						end
					else
						-- fallback: simple colored boxes
						local function mk(name, sz, col, cf)
							local part = new("Part", {Name = name, Size = sz, Color = col, Material = Enum.Material.SmoothPlastic, CanCollide = false,
								CanQuery = false, CanTouch = false, Massless = true, Anchored = false, TopSurface = Enum.SurfaceType.Smooth,
								BottomSurface = Enum.SurfaceType.Smooth}, nil)
							attach(host, part, cf, f, key)
						end
						local function at(x, y, z) return base * CFrame.new(x, y, z) end
						mk("Steve" .. key, size, m[3], base)
						if key == "Head" then                              -- hair, eyes, mouth (the front is -Z)
							local HAIR = C(70, 45, 25)
							mk("Hair", Vector3.new(size.X + 0.06, 0.4, size.Z + 0.06), HAIR, at(0, size.Y / 2 - 0.17, 0))
							mk("HairBack", Vector3.new(size.X + 0.06, size.Y * 0.6, 0.22), HAIR, at(0, size.Y * 0.1, size.Z / 2 - 0.1))
							for _, sx in ipairs({-1, 1}) do
								mk("Eye", Vector3.new(0.3, 0.16, 0.05), C(255, 255, 255), at(sx * 0.3, 0.05, -size.Z / 2 - 0.01))
								mk("Pupil", Vector3.new(0.15, 0.16, 0.06), C(70, 50, 130), at(sx * 0.22, 0.05, -size.Z / 2 - 0.02))
							end
							mk("Mouth", Vector3.new(0.45, 0.09, 0.05), C(130, 80, 60), at(0, -0.3, -size.Z / 2 - 0.01))
						elseif key:find("Arm") then                         -- short sleeve on top of the arm
							mk("Sleeve", Vector3.new(size.X + 0.04, 0.8, size.Z + 0.04), SHIRT, at(0, size.Y / 2 - 0.4, 0))
						elseif key:find("Leg") then                         -- shoes
							mk("Shoe", Vector3.new(size.X + 0.04, 0.3, size.Z + 0.04), C(110, 110, 115), at(0, -size.Y / 2 + 0.15, 0))
						end
					end
				end
			end
			UI.applySkin()
			UI.buildInvSteve()
			UI.heldKey = nil
			if UI.hold3D then UI.hold3D() end
		end)
	end

	-- Steve standing in the inventory screen (his own pose, wearing the skin)
	function UI.buildInvSteve()
		local vpf = UI.invVP
		if not vpf then return end
		if not UI.opt.steve then UI.buildInvAvatar() return end
		vpf:ClearAllChildren()
		vpf.Ambient, vpf.LightColor = C(170, 170, 170), WHITE
		vpf.CurrentCamera = new("Camera", {FieldOfView = 38, CFrame = CFrame.lookAt(Vector3.new(0, 0.5, -9.5), Vector3.new(0, -0.4, 0))}, vpf)
		local model = new("Model", {Name = "InvSteve"}, vpf)
		model.WorldPivot = CFrame.new()
		task.spawn(function()
			local T, H = MESH.Torso[2], MESH.Head[2]
			local armX, legY = T.X / 2 + MESH.RightArm[2].X / 2, T.Y / 2 + MESH.RightLeg[2].Y / 2
			local POS = {Torso = Vector3.zero, Head = Vector3.new(0, T.Y / 2 + H.Y / 2, 0),
				RightArm = Vector3.new(armX, 0, 0), LeftArm = Vector3.new(-armX, 0, 0),
				RightLeg = Vector3.new(0.343, -legY, 0), LeftLeg = Vector3.new(-0.343, -legY, 0)}
			local function put(name, id, size, col, pos)
				local mp = UI.opt.skin and id and newMesh(id, size) or nil
				if not mp then mp = new("Part", {Size = size, Color = col, Material = Enum.Material.SmoothPlastic}, nil) end
				mp.Name, mp.Anchored, mp.CFrame = name, true, CFrame.new(pos)
				mp.Parent = model
			end
			for _, key in ipairs(ORDER) do
				local m = MESH[key]
				put("Inv" .. key, m[1], m[2], m[3], POS[key])
				if UI.opt.skin and UI.opt.layer2 then put("InvLayer" .. key, m[6], m[7], m[3], POS[key]) end
			end
			model:PivotTo(CFrame.Angles(0, math.rad(-25), 0))        -- turned a little, like the Minecraft inventory
		end)
	end

	function UI.buildArmMesh()                       -- the 3D arm on your screen wears the skin too
		if not UI.opt.skin then UI.buildArm() return end
		task.spawn(function()
			local p = newMesh(6814397494, Vector3.new(0.7, 2, 0.55))
			if p then UI.buildArm(p) else UI.buildArm() end
		end)
	end

	function UI.setSkin(text)                        -- a skin image id / link typed in the settings
		local num = tostring(text or ""):match("%d+")
		if not num then return false end
		UI.addSkinHistory(num)
		local url = "rbxassetid://" .. num
		task.spawn(function()
			pcall(function()                         -- a Decal id is not an Image id: ask Roblox for the real image
				local o = game:GetObjects(url)[1]
				if o then
					if (o:IsA("Decal") or o:IsA("Texture")) and o.Texture ~= "" then url = o.Texture end
					o:Destroy()
				end
			end)
			UI.skinId = url
			UI.saveSettings()
			UI.buildSteve()
			UI.buildArmMesh()
		end)
		return true
	end

	on(player.CharacterAdded, function() task.wait(1.2) UI.buildSteve() end)
	UI.buildSteve()
	UI.buildArmMesh()
end

--====================================================================
-- HEAD LOOK: your head turns and tilts to where the camera looks (only on your screen)
--====================================================================
do
	local motor, torsoPart, c0
	local pitch, yaw = 0, 0
	local function find()
		local ch = player.Character
		if not ch then motor = nil return end
		if motor and motor.Parent and motor:IsDescendantOf(ch) then return end
		motor, torsoPart, c0 = nil, nil, nil
		local m = ch:FindFirstChild("Neck", true)
		if not (m and m:IsA("Motor6D")) then              -- another name: the joint that holds the head
			m = nil
			for _, o in ipairs(ch:GetDescendants()) do
				if o:IsA("Motor6D") and o.Part1 and o.Part1.Name == "Head" then m = o break end
			end
		end
		if m and m.Part0 then
			motor, torsoPart, c0 = m, m.Part0, m.C0
			print("Head look: neck found (" .. m.Name .. ", " .. m.Part0.Name .. " -> Head)")
		else
			if UI.neckWarned ~= ch then UI.neckWarned = ch print("Head look: NO neck joint found") end
		end
	end
	function UI.headApply()
		if motor and motor.Parent and c0 then
			motor.C0 = CFrame.new(c0.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * (c0 - c0.Position)
		end
		local sn = UI.steveNeck                                      -- the Steve head's own neck
		if sn and sn.Parent and sn.Part0 then
			sn.C0 = (UI.leanL or CFrame.identity) * CFrame.new(0, sn.Part0.Size.Y / 2, 0) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		end
	end
	on(RS.Heartbeat, function() UI.headApply() end)         -- (set again after the animations ran, so nothing can undo it)
	function UI.resetHead()
		if motor and motor.Parent and c0 then motor.C0 = c0 end
	end
	on(RS.RenderStepped, function(dt)
		find()
		local sn = UI.steveNeck
		local tpart = torsoPart or (sn and sn.Part0)
		if (not motor and not (sn and sn.Parent)) or not tpart then return end
		local look = UI.look()
		local root = getRoot()
		local hum = MV.hum
		if root and hum and hum.MoveDirection.Magnitude < 0.1 and not hum.Sit then   -- standing still: the body turns after the camera, like Minecraft
			local rl = root.CFrame:VectorToObjectSpace(look)
			local rel = math.atan2(-rl.X, -rl.Z)
			local LIMIT = math.rad(45)
			if math.abs(rel) > LIMIT then
				local dy = (math.abs(rel) - LIMIT) * (rel > 0 and 1 or -1) * math.min(1, dt * 10)
				root.CFrame = root.CFrame * CFrame.Angles(0, dy, 0)
			end
		end
		local lv = tpart.CFrame:VectorToObjectSpace(look)              -- the camera direction as seen from your body
		local ty = math.clamp(math.atan2(-lv.X, -lv.Z), -math.rad(80), math.rad(80))
		local tp = math.clamp(math.asin(math.clamp(lv.Y, -1, 1)), -math.rad(70), math.rad(70))
		local a = math.min(1, dt * 18)
		yaw += (ty - yaw) * a
		pitch += (tp - pitch) * a
		UI.headApply()
	end)
end

--====================================================================
-- STEVE POSE: sneaking leans your body forward and the right arm swings (R6 + R15).
-- It moves the welds that hold the Steve model, so it does not depend on the rig's own joints.
--====================================================================
do
	local lean = 0
	UI.swingA, UI.leanL, UI.holdA = 0, CFrame.identity, 0     -- holdA = how far the right arm is raised while you hold something
	local function apply()
		local list, torso = UI.poseParts, UI.steveTorso
		if not list or #list == 0 or not torso or not torso.Parent then return end
		local hipP = CFrame.new(0, -torso.Size.Y / 2, 0)
		local L = hipP * CFrame.Angles(-lean, 0, 0) * hipP:Inverse()            -- lean forward around the hips, in the torso's space
		UI.leanL = L
		local tcf = torso.CFrame
		local lw = tcf * L * tcf:Inverse()                                       -- the same lean in world space
		for _, p in ipairs(list) do
			if p.weld.Parent and p.host.Parent then
				local hcf = p.host.CFrame
				if p.key == "RightLeg" or p.key == "LeftLeg" then
					p.weld.C0 = p.rel                                            -- legs stay under you
				else
					local S = CFrame.identity
					if p.key == "RightArm" and (UI.swingA ~= 0 or UI.holdA > 0.01) then   -- raise the arm (holding) + swing it forward around the shoulder
						local hy = p.host.Size.Y / 2
						S = CFrame.new(0, hy, 0) * CFrame.Angles(UI.swingA + UI.holdA, 0, 0) * CFrame.new(0, -hy, 0)
					end
					p.weld.C0 = hcf:ToObjectSpace(lw * hcf * S * p.rel)
				end
			end
		end
	end
	on(RS.RenderStepped, function(dt)
		local sneaking = (MV.sneakHeld or MV.sneakTog) and not UI.flying
		lean += ((sneaking and 0.42 or 0) - lean) * math.min(1, dt * 10)
		local st = inv[35 + selected]
		local hd = st and BY_NAME[st.name]
		UI.holdA += (((hd and UI.persp ~= 0) and (hd.IsBlock and 0.35 or 0.55) or 0) - UI.holdA) * math.min(1, dt * 12)
		apply()
	end)
	on(RS.Heartbeat, apply)
end

