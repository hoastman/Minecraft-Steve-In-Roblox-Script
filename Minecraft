-- Slabs + stairs: copies of a block above, with Shape = "Slab" / "Stairs".  Add more names to the list!
local function addShapes(base)                       -- same texture / color / tab as the block it comes from
	for _, shape in ipairs({"Slab", "Stairs"}) do
		local name = base .. " " .. shape
		if not BY_NAME[name] then
			local d = {}
			for k, v in pairs(BY_NAME[base]) do d[k] = v end
			d.Name, d.Shape, d.Shapes, d.Base, d.Dup = name, shape, nil, base, nil
			register(d)
		end
	end
end
for _, base in ipairs({"Stone", "Cobblestone", "Oak Planks", "Bricks"}) do addShapes(base) end

