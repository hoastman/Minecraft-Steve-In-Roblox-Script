---------- Crafting recipes (shared by the 2x2 inventory grid and the 3x3 crafting table) ----------
do
	local R = {}
	local function shaped(out, n, rows, key)
		if BY_NAME[out] then R[#R + 1] = {out = out, n = n, rows = rows, key = key} end
	end
	shaped("Oak Planks", 4, {"L"}, {L = "Oak Log"})
	shaped("Stick", 4, {"P", "P"}, {P = "Oak Planks"})
	shaped("Crafting Table", 1, {"PP", "PP"}, {P = "Oak Planks"})
	shaped("Chest", 1, {"PPP", "P P", "PPP"}, {P = "Oak Planks"})
	shaped("Furnace", 1, {"CCC", "C C", "CCC"}, {C = "Cobblestone"})
	shaped("Oak Door", 3, {"PP", "PP", "PP"}, {P = "Oak Planks"})      -- only Oak Planks make a door
	shaped("Wooden Pickaxe", 1, {"PPP", " S ", " S "}, {P = "Oak Planks", S = "Stick"})
	shaped("Diamond Pickaxe", 1, {"DDD", " S ", " S "}, {D = "Diamond", S = "Stick"})
	shaped("Iron Sword", 1, {"I", "I", "S"}, {I = "Iron Ingot", S = "Stick"})
	for _, d in ipairs(ITEMS) do
		if d.Base and BY_NAME[d.Base] then
			if d.Shape == "Slab" then shaped(d.Name, 6, {"BBB"}, {B = d.Base})
			elseif d.Shape == "Stairs" then shaped(d.Name, 4, {"B  ", "BB ", "BBB"}, {B = d.Base})
			elseif d.Shape == "Fence" then shaped(d.Name, 3, {"BSB", "BSB"}, {B = d.Base, S = "Stick"})
			elseif d.Shape == "FenceGate" then shaped(d.Name, 1, {"SBS", "SBS"}, {B = d.Base, S = "Stick"}) end
		end
	end

	local function match(cells, size)
		local r1, r2, c1, c2 = size + 1, 0, size + 1, 0
		for i = 1, size * size do
			if cells[i] then
				local r, c = (i - 1) // size + 1, (i - 1) % size + 1
				r1, r2, c1, c2 = math.min(r1, r), math.max(r2, r), math.min(c1, c), math.max(c2, c)
			end
		end
		if r2 == 0 then return nil end
		local h, w = r2 - r1 + 1, c2 - c1 + 1
		for _, rc in ipairs(R) do
			if #rc.rows == h and #rc.rows[1] == w then
				for mirror = 0, 1 do
					local ok = true
					for r = 1, h do
						for c = 1, w do
							local col = mirror == 1 and (w - c + 1) or c
							local want = rc.key[rc.rows[r]:sub(col, col)]
							local got = cells[(r1 + r - 2) * size + (c1 + c - 1)] or nil
							if want ~= got then ok = false end
						end
					end
					if ok then return rc end
				end
			end
		end
	end

	local CTX = {{first = 1, size = 2, out = 0}, {first = 46, size = 3, out = 55}}
	function UI.refreshCraft()
		for _, c in ipairs(CTX) do
			local cells = {}
			for k = 1, c.size * c.size do
				local s = inv[c.first + k - 1]
				cells[k] = s and s.name or false
			end
			local rc = match(cells, c.size)
			inv[c.out] = rc and {name = rc.out, count = rc.n} or nil
			render(c.out)
		end
	end

	function UI.takeCraft(n)                         -- press the result slot: you get the item, the ingredients shrink by 1
		local c = CTX[n]
		local o = inv[c.out]
		if not o then return end
		if cursor then
			if cursor.name ~= o.name or cursor.count + o.count > cap(o.name) then return end
			cursor.count += o.count
		else
			cursor = {name = o.name, count = o.count}
		end
		for k = c.first, c.first + c.size * c.size - 1 do
			local s = inv[k]
			if s then
				s.count -= 1
				if s.count <= 0 then inv[k] = nil end
				render(k)
			end
		end
		UI.refreshCraft()
		renderCursor()
	end

	function UI.returnGrid(first, n)                 -- closing a crafting screen gives your items back
		for k = first, first + n - 1 do
			local s = inv[k]
			if s then give(s.name, s.count) inv[k] = nil render(k) end
		end
		UI.refreshCraft()
	end
end

