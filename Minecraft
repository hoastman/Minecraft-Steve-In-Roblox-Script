on(RS.Heartbeat, function(dt)
	if #drops == 0 then return end
	local root = getRoot()
	dropParams.FilterDescendantsInstances = {player.Character, dropFolder}
	local now = os.clock()
	for i = #drops, 1, -1 do
		local d = drops[i]
		local remove = d.part.Parent == nil or now - d.born > 300 or d.y < -500
		if not remove then
			if not d.landed then                                   -- pop up, then fall until we hit something
				d.vy -= 70 * dt
				d.x += d.vx * dt                                       -- thrown items fly forward while they fall...
				d.z += d.vz * dt
				local drag = math.max(0, 1 - 2.5 * dt)                 -- ...and slow down in the air
				d.vx *= drag
				d.vz *= drag
				local ny = d.y + d.vy * dt
				if d.vy < 0 then
					local hit = Workspace:Raycast(Vector3.new(d.x, d.y, d.z), Vector3.new(0, ny - d.y - DROP_SIZE / 2, 0), dropParams)
					if hit then
						d.landed, d.y, d.baseY = true, hit.Position.Y + DROP_SIZE / 2, hit.Position.Y + DROP_SIZE / 2
					else
						d.y = ny
					end
				else
					d.y = ny
				end
			end
			local py = d.landed and (d.baseY + 0.35 + math.sin(now * 3 + d.spin) * 0.2) or d.y
			if root then
				local dist = (root.Position - Vector3.new(d.x, py, d.z)).Magnitude
				if now - d.born > (d.delay or 0.6) then
					if dist < PICKUP then
						local left = give(d.name, d.count or 1)
						if left == 0 then remove = true else d.count = left end   -- (stays on the ground if your inventory is full)
					elseif dist < MAGNET and d.landed then          -- slide toward the player
						local dir = (root.Position - Vector3.new(d.x, d.baseY, d.z))
						dir = Vector3.new(dir.X, 0, dir.Z).Unit * 14 * dt
						d.x += dir.X
						d.z += dir.Z
					end
				end
			end
			if not remove then
				d.part.CFrame = CFrame.new(d.x, py, d.z) * CFrame.Angles(0, now * 1.5 + d.spin, 0)
			end
		end
		if remove then
			pcall(function() d.part:Destroy() end)
			table.remove(drops, i)
		end
	end
end)

