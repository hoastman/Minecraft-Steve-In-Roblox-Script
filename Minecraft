---------- Tabs: 7 on top, 7 on the bottom (like the Minecraft creative menu) ----------
local tabs = new("Frame", {Name = "TabsFront", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 6, Active = false, Visible = false}, win)   -- only the OPEN tab lives here
local tabBtns = {}

-- tabs are narrower now (UI.TW). A CLOSED tab only shows what is above the window: its lower end is the black line of the window edge,
-- so it really looks like it stands behind the window. The OPEN tab is taller, light grey like the window, and overlaps the window edge.
UI.TW = 48                                                 -- tab width
UI.TH_CLOSED, UI.TH_OPEN = 42, 50                          -- height of a closed / open tab
UI.TAB_ICON = 34                                           -- the icon area in a tab (34 x 34)

-- WHICH block / item is the icon of each tab (change the names here; a block shows as a 3D cube, an item as its flat picture)
UI.TAB_ICONS = {
	["Building Blocks"] = "Bricks", ["Colored Blocks"] = "Cyan Wool", ["Natural Blocks"] = "Grass Block", ["Functional Blocks"] = "Crafting Table",
	["Redstone"] = "Redstone Dust", ["Saved Hotbars"] = "Bookshelf", ["Search"] = "Compass",
	["Tools & Utilities"] = "Diamond Pickaxe", ["Combat"] = "Netherite Sword", ["Food & Drinks"] = "Golden Apple", ["Ingredients"] = "Iron Ingot",
	["Spawn Eggs"] = "Creeper Spawn Egg", ["Operator Utilities"] = "Command Block", ["Survival Inventory"] = "Chest",
}

-- the pieces of a tab (top-tab version): {colour, x, y, width, height}
local function tabPieces(selected)
	local BLACK, GREY = C(0, 0, 0), C(85, 85, 85)
	local h = selected and UI.TH_OPEN or UI.TH_CLOSED
	local ol = h - (selected and 6 or 2)
	local p = {
		{WHITE, 2, 2, 5, 4}, {WHITE, 2, 0, UI.TW - 6, 4}, {WHITE, 0, 3, 4, h - (selected and 3 or 5)},   -- white light on the top and the left
		{GREY, UI.TW - 4, 4, 4, h - (selected and 6 or 4)},                                              -- grey shadow on the right
		{BLACK, UI.TW, 2, 2, ol}, {BLACK, UI.TW - 2, 0, 2, 2}, {BLACK, 0, 0, 3, 2}, {BLACK, 3, -2, UI.TW - 4, 2}, {BLACK, -2, 2, 2, ol},   -- the black outline
	}
	if selected then
		p[#p + 1] = {GREY, UI.TW - 3, 4, 2, h - 3}
	else
		p[#p + 1] = {BLACK, -2, h - 2, UI.TW + 4, 2}              -- closed tab: the black window edge cuts it off = it stands behind the window
	end
	return p
end

function UI.restyleTab(b)
	local sel = b:GetAttribute("Sel") and true or false
	local top, x = b:GetAttribute("Top"), b:GetAttribute("X")
	local h = sel and UI.TH_OPEN or UI.TH_CLOSED
	b.Size = UDim2.fromOffset(UI.TW, h)
	b.BackgroundColor3 = sel and C(198, 198, 198) or C(139, 139, 139)
	b.Position = top and UDim2.new(0, x, 0, sel and -46 or -UI.TH_CLOSED) or UDim2.new(0, x, 1, sel and -4 or 0)
	b.Parent = sel and tabs or UI.tabsBack                    -- open tab: in FRONT of the window, closed tabs: BEHIND it
	local old = b:FindFirstChild("Deco")
	if old then old:Destroy() end
	local deco = new("Frame", {Name = "Deco", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 6, Active = false}, b)
	for _, pc in ipairs(tabPieces(sel)) do
		local y = top and pc[3] or (h - pc[3] - pc[5])        -- the bottom tabs are the same upside down
		new("Frame", {BackgroundColor3 = pc[1], BorderSizePixel = 0, Position = UDim2.fromOffset(pc[2], y), Size = UDim2.fromOffset(pc[4], pc[5]), ZIndex = 6}, deco)
	end
	local ib = b:FindFirstChild("IconBox")
	if ib then
		local iy = sel and 8 or 4                             -- the icon area, in the middle of the tab (same place on screen open or closed)
		ib.Position = UDim2.fromOffset((UI.TW - UI.TAB_ICON) // 2, top and iy or (h - UI.TAB_ICON - iy))
	end
end

local function makeTab(name, x, top)
	local b = new("TextButton", {Size = UDim2.fromOffset(UI.TW, UI.TH_CLOSED), BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		BackgroundColor3 = C(139, 139, 139), ZIndex = 5}, tabs)
