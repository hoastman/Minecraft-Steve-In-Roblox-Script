local chatBox = new("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 4, 1, -60), Size = UDim2.new(0.6, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1}, gui)
new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, chatBox)
local chatLines, chatSeq = {}, 0

local function refreshChat()
	local shown, limit = 0, chatOpen and 20 or 10
	for i = #chatLines, 1, -1 do
		local l = chatLines[i]
		local vis = (chatOpen or os.clock() - l.t < 10) and shown < limit
		l.lbl.Visible = vis
		if vis then shown += 1 end
	end
end

local function addChat(raw)
	local last = chatLines[#chatLines]
	if last and last.raw == raw then          -- duplicate -> "(n)" counter like Compact Chat
		last.n += 1
		last.t = os.clock()
		last.lbl.Text = raw .. ' <font color="#aaaaaa">(' .. last.n .. ')</font>'
	else
		chatSeq += 1
		local lbl = new("TextLabel", {Size = UDim2.new(1, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = UI.opt.chatBg, BorderSizePixel = 0, RichText = true, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, Font = Enum.Font.Arcade, TextSize = UI.opt.chatSize, TextColor3 = WHITE,
			TextStrokeTransparency = 0.6, LayoutOrder = chatSeq, Text = raw}, chatBox)
		new("UIPadding", {PaddingLeft = UDim.new(0, 4)}, lbl)
		chatLines[#chatLines + 1] = {lbl = lbl, raw = raw, n = 1, t = os.clock()}
		if #chatLines > 40 then chatLines[1].lbl:Destroy() table.remove(chatLines, 1) end
	end
	refreshChat()
	task.delay(10.1, refreshChat)
end

function sys(text) addChat('<font color="#ffff55">' .. esc(text) .. '</font>') end

function UI.applyChat()                          -- called by Options > Chat Settings
