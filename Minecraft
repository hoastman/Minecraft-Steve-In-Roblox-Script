		if v.label then v.label.Visible = d == nil end
		if d then
			v.item.BackgroundColor3 = d.Color
			v.item.BackgroundTransparency = bgT(d)
			v.count.Text = tostring(s.count)
		end
		setIcon(v.ic, d)
	end
	if i >= 36 and i <= 44 then -- mirror into the real hotbar
		local h = hv[i - 35]
		h.btn.BackgroundTransparency = d and bgT(d) or 1
		h.btn.Text = (d and not d.IsBlock and not ic) and d.Name or ""
		setIcon(h.ic, d)
