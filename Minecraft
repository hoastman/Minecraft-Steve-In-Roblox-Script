--====================================================================
-- Break / Place  (works on any part of the game)
--====================================================================
local function getTarget(pt)
	local ray = Workspace.CurrentCamera:ViewportPointToRay(pt.X, pt.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {player.Character}
	return Workspace:Raycast(ray.Origin, ray.Direction * 90, params)
end

-- every block sits on a whole-number grid: 0, 4, 8, 12 ...  (never 1.173)
local function snap(v)
	return Vector3.new(math.round(v.X / BLOCK) * BLOCK + 0, math.round(v.Y / BLOCK) * BLOCK + 0, math.round(v.Z / BLOCK) * BLOCK + 0)
end

local function placePos(hit)
	-- the face you hit: the strongest axis of the normal (a slope can no longer push the block up AND sideways)
	local nx, ny, nz = hit.Normal.X, hit.Normal.Y, hit.Normal.Z
	local ax, ay, az = math.abs(nx), math.abs(ny), math.abs(nz)
	local n
	if ay >= ax and ay >= az then n = Vector3.new(0, ny >= 0 and 1 or -1, 0)
	elseif ax >= az then n = Vector3.new(nx >= 0 and 1 or -1, 0, 0)
	else n = Vector3.new(0, 0, nz >= 0 and 1 or -1) end
	local root = blockRoot(hit.Instance)
	if root then                                     -- next to another block
		return (root:GetAttribute("Cell") or snap(root:GetPivot().Position)) + n * BLOCK, n
	end
	local p = snap(hit.Position + n * (BLOCK / 2))   -- on a game part / terrain
	if n.Y ~= 0 then                                 -- floor / ceiling: the block touches the surface exactly (it never floats up or sinks in)
		p = Vector3.new(p.X, hit.Position.Y + n.Y * (BLOCK / 2), p.Z)
	end
	return p, n
end

--====================================================================
-- Dropped items (survival): break a block -> it pops out, falls, spins,
-- and you pick it up by walking close to it
--====================================================================
local dropFolder = new("Folder", {Name = "LocalMCDrops"}, Workspace)
local drops = {}
local DROP_SIZE, PICKUP, MAGNET = 0.95, 4, 8
local dropParams = RaycastParams.new()
dropParams.FilterType = Enum.RaycastFilterType.Exclude

local function spawnDrop(pos, def, vel, count)
	local ic = (not def.IsBlock) and iconOf(def)
	local p
	if ic then                                                      -- tools / items: a spinning flat picture of the item
		p = new("Part", {Size = Vector3.new(DROP_SIZE * 1.7, DROP_SIZE * 1.7, 0.05), CFrame = CFrame.new(pos), Anchored = true, CanCollide = false,
			CanQuery = false, CanTouch = false, Transparency = 1}, dropFolder)
		for _, face in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
			local sg = new("SurfaceGui", {Face = face, SizingMode = Enum.SurfaceGuiSizingMode.FixedSize, CanvasSize = Vector2.new(128, 128), LightInfluence = 0}, p)
			new("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = ic, ResampleMode = Enum.ResamplerMode.Pixelated}, sg)
		end
	end
	if not p then
	p = new("Part", {Size = Vector3.one * DROP_SIZE, CFrame = CFrame.new(pos), Anchored = true, CanCollide = false, CanQuery = false,
		CanTouch = false, Color = def.Color, Material = def.Material or Enum.Material.SmoothPlastic, Transparency = def.Clear and 1 or def.Transparency or 0,
		TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth}, dropFolder)
	for face, id in pairs(def.Texture or {}) do
		new("Decal", {Texture = id, Face = FACE[face], Color3 = def.Tint or WHITE, Transparency = def.Clear and 0.2 or 0}, p)
	end
	end
	drops[#drops + 1] = {part = p, name = def.Name, x = pos.X, y = pos.Y, z = pos.Z, vy = vel and vel.Y or 14, vx = vel and vel.X or 0, vz = vel and vel.Z or 0,
		count = count or 1, delay = vel and 1.3 or 0.6, born = os.clock(), spin = math.random() * 6}
end

